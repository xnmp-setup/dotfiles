{{- $desktopTheme := includeTemplate "current-theme.json.tmpl" . | fromJson -}}
# Quick terminal: top + centered, 60% tall, 75% wide
quick-terminal-position = top
quick-terminal-size = 65%,1000px

background-opacity = 0.95
macos-hidden = never
macos-titlebar-style = tabs

macos-window-buttons = hidden
# Keep Linux window chrome in sync with the active terminal theme. Under
# Hyprland, omit the GTK titlebar controls and keep only a compact tab strip.
window-theme = ghostty
gtk-titlebar = false
gtk-titlebar-style = native
gtk-toolbar-style = raised
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/tabs.css
# The zsh title hook owns OSC 2. Disable only Ghostty's competing path-title
# hook so new tabs do not flash the working directory before our first prompt.
shell-integration-features = no-title
# Don't auto-copy on text selection (use ctrl+c to copy explicitly)
copy-on-select = false
split-divider-color = #FFBF00
font-thicken = true
font-thicken-strength = 80
# WezTerm uses FreeType's normal hinting; Ghostty defaults to light hinting on
# Linux, which makes the same JetBrains Mono Regular face look thinner.
freetype-load-flags = hinting,no-force-autohint,no-monochrome,autohint,no-light
# Match WezTerm's bold ANSI promotion and native sRGB glyph blending.
bold-color = bright
alpha-blending = native
theme = {{ $desktopTheme.title }}
mouse-scroll-multiplier = 5

window-padding-x = 10
# window-padding-y = 10

# keybind = global:F10=toggle_quick_terminal
keybind = ctrl+shift+,=reload_config
keybind = ctrl+shift+c=write_screen_file:paste
keybind = super+slash=text:\x1f

keybind = ctrl+w=close_surface
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = performable:ctrl+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = alt+backspace=text:\x1b\x7f
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# ctrl+delete
keybind = alt+delete=text:\x1bd
keybind = ctrl+delete=text:\x1bd
keybind = ctrl+,=open_config
# shift+enter and ctrl+enter use CSI u sequences (see above)
keybind = ctrl+shift+k=text:\x0b

# pane navigation
keybind = alt+super+'=new_split:right
keybind = alt+super+l=new_split:left
keybind = alt+super+p=new_split:up
keybind = alt+super+;=new_split:down
keybind = alt+o=toggle_split_zoom
# Letter navigation avoids super+arrow, which Hyprland consumes first.
keybind = super+l=goto_split:left
keybind = super+p=goto_split:up
keybind = super+;=goto_split:down
keybind = super+'=goto_split:right
keybind = ctrl+shift+t=undo
keybind = ctrl+backspace=text:\x17
keybind = shift+home=text:\x1b[1;2H
keybind = shift+end=text:\x1b[1;2F
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
# Private transport used by Hyprland for plain PageUp/PageDown at a zsh prompt
# and in Codex. The title marker scopes this so child programs keep the keys.
keybind = ctrl+alt+page_up=scroll_page_fractional:-0.5
keybind = ctrl+alt+page_down=scroll_page_fractional:0.5
keybind = ctrl+n=new_window
# keybind = ctrl+c=copy_to_clipboard

font-size = 14

# Normal/full zsh tab
keybind = ctrl+t=new_tab

# Subtle theme-colored flash on the new line when you press Enter.
# (Additive glow on one row only — does not distort/sample fresh output,
# so it won't make output appear late like the earlier radial version did.)
custom-shader = /home/chong/.config/ghostty/shaders/command-line-flash.glsl
custom-shader = /home/chong/.config/ghostty/shaders/agent-aurora.glsl
custom-shader-animation = true
