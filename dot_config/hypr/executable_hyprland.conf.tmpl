# --- Monitor & General ---
monitor=,preferred,auto,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto
env = XDG_CURRENT_DESKTOP,GNOME
{{ if ne .chezmoi.hostname "t14s" -}}
workspace = 1, monitor:DP-2, default:true
workspace = 2, monitor:DP-2
workspace = 3, monitor:DP-2
workspace = 4, monitor:DP-2
workspace = 5, monitor:DP-2
{{ else -}}
# NixOS laptop: polkit agent is not autostarted by anything else
exec-once = systemctl --user start hyprpolkitagent
{{ end }}
input {
    kb_layout = us
    follow_mouse = 0
    float_switch_override_focus = 0
    sensitivity = 0 # Raw input, like turning off mouse accel in StarCraft
}

cursor {
    no_warps = true
}

dwindle {
    preserve_split = true
}

{{ if ne .chezmoi.hostname "t14s" -}}
# 1. Top Monitor (HDMI-A-1)
monitor = HDMI-A-1, 2560x1440@60, 300x0, 1

# 2. Main Ultrawide (DP-2) - Starts at Y=1440
monitor = DP-2, 3440x1440@144, 0x1440, 1

# 3. Right 4K (DP-1) - Vertically Centered
monitor = DP-1, 3840x2160@60, 3440x1296, 1.25


{{ else -}}
# t14s: the catchall `monitor=,preferred,auto,1` above handles eDP-1 and any
# external at its native mode — the desktop monitor fleet would force
# impossible modes and phantom-offset geometry here.
{{ end -}}


# --- The "Hacker" Aesthetic ---
general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2

    # Cyan/Green active border for that "terminal" feel
    col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg
    col.inactive_border = rgba(595959aa)
    layout = dwindle
}

# Native tabbed groups (replaces hy3 tabs)
group {
    col.border_active = rgba(33ccffee) rgba(00ff99ee) 45deg
    col.border_inactive = rgba(595959aa)
    groupbar {
        enabled = true
        font_size = 10
        height = 15
        render_titles = true
        gradients = true
    }
}


decoration {
    rounding = 3   # Sharp corners = faster visual scan
    dim_inactive = false
    dim_strength = 0.4
    blur {
        enabled = true
        size = 3
        passes = 1
    }
}

# --- Startup Apps ---
# Parramatta, Australia Coordinates (Lat: -33.8, Lon: 151.0)
# Temperature: 6500K (Day) -> 3500K (Night)
# exec-once = gammastep -l -33.8:151.0 -t 6500:3500
exec-once = hyprpaper
# exec-once = hyprpm reload -n   # no plugins after hy3 removal
exec-once = vicinae server
# exec-once = ~/.config/hypr/nightlight.sh
exec-once = wlsunset -l -33.87 -L 151.21 -t 3500 -T 6500
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = gnome-keyring-daemon --start --components=secrets
exec-once = ~/.local/bin/scratchpad-autohide.sh lite-xl ghostty-drop ytmusic chrome-drop
exec-once = ~/.config/hypr/imv-splash.sh
exec-once = [workspace 1] wezterm
exec-once = [workspace 1] google-chrome-stable
exec-once = systemctl --user start hypr-session-save.service

# --- Window Rules ---
windowrule = float on, match:class (com.lite_xl.LiteXL)
windowrule = size 25% 65%, match:class (com.lite_xl.LiteXL)
windowrule = center on, match:class (com.lite_xl.LiteXL)
windowrule = opacity 0.93 0.93, match:class (obsidian)
windowrule = opacity 0.93 0.93, match:class (^code$)
windowrule = opacity 0.93 0.93, match:class (^google-chrome$)
windowrule = opacity 0.93 0.93, match:class (dev.zed.Zed-Dev)
windowrule = opacity 0.93 0.93, match:class (dev.zed.Zed$)
windowrule = opacity 0.9 0.9, match:class (tauri-explorer)
windowrule = opacity 0.9 0.9, match:class (com.mitchellh.ghostty)
windowrule = float on, match:class (^imv$)
windowrule = center on, match:class (^imv$)
windowrule = size 75% 75%, match:class (^imv$)

windowrule = float on, match:class ([Tt]hunar), match:title negative:(.*[Tt]hunar.*)
windowrule = center on, match:class ([Tt]hunar), match:title negative:(.*[Tt]hunar.*)

# --- Animations (Speed > Flash) ---
animations {
    enabled = yes
    bezier = fastBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, 2, fastBezier
    animation = workspaces, 1, 2, default
    animation = specialWorkspace, 1, 3, fastBezier, slidefadevert -50%
}


# --- Keybindings ---
$mainMod = SUPER

# Tools
bind = $mainMod, RETURN, exec, wezterm
bind = $mainMod, SPACE, exec, vicinae toggle
bind = $mainMod CTRL, L, exec, hyprlock
bind = $mainMod CTRL, R, exec, ~/.local/bin/hypr-session-restore.sh
bind = , F6, exec, ~/.local/bin/toggle-scratchpad.sh chrome-drop 1800 1100 --class google-chrome --singleton google-chrome-stable --new-window
bind = , F7, exec, ~/.local/bin/toggle-scratchpad.sh ytmusic 1400 900 --class "YouTube Music Desktop App" youtube-music-desktop-app
bind = , F9, exec, ~/.local/bin/toggle-scratchpad.sh ghostty-drop 1600 1000 --class com.mitchellh.ghostty 920 1440 ghostty
bind = $mainMod, E, exec, ~/.config/hypr/open-explorer-cwd.sh
bind = $mainMod SHIFT, S, exec, hyprshot -m region --clipboard-only
bind = CTRL SHIFT, V, exec, ~/.config/hypr/clip2path
bind = CTRL SHIFT, C, exec, ~/Repos/obsidian-capture/hotkey/capture-linux.sh

# Move Focus
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Move Window (native, cross-monitor swap at edges)
bind = $mainMod CTRL, left, exec, ~/.config/hypr/swap-or-move.sh l
bind = $mainMod CTRL, right, exec, ~/.config/hypr/swap-or-move.sh r
bind = $mainMod CTRL, up, exec, ~/.config/hypr/swap-or-move.sh u
bind = $mainMod CTRL, down, exec, ~/.config/hypr/swap-or-move.sh d

# Move Window (swap in direction)
bind = $mainMod ALT, left, movewindow, l
bind = $mainMod ALT, right, movewindow, r
bind = $mainMod ALT, up, movewindow, u
bind = $mainMod ALT, down, movewindow, d

# Move window to prev/next monitor
bind = $mainMod CTRL, Prior, movewindow, mon:l
bind = $mainMod CTRL, Next, movewindow, mon:r

# Float center toggle with dim
bind = $mainMod CTRL, end, exec, ~/.local/bin/toggle-float-center.sh

# Mouse move/resize
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow

# Toggle split direction (dwindle)
bind = $mainMod, comma, layoutmsg, togglesplit
bind = $mainMod, slash, layoutmsg, togglesplit
bind = $mainMod CTRL, comma, layoutmsg, togglesplit
bind = $mainMod CTRL, slash, layoutmsg, togglesplit

# Tab Groups (native groups are tabbed)
bind = $mainMod, T, togglegroup
bind = $mainMod SHIFT, T, togglegroup
bind = $mainMod, bracketleft, changegroupactive, b
bind = $mainMod, bracketright, changegroupactive, f

# Split control (dwindle: togglesplit flips axis; preserve_split keeps it)
# NOTE: degraded from hy3 makegroup h/v — dwindle can't preselect a direction, only flip.
bind = $mainMod, H, layoutmsg, togglesplit
bind = $mainMod, Y, layoutmsg, togglesplit
# bind = $mainMod SHIFT, H, ...   # no dwindle equivalent (hy3 changegroup h)
# bind = $mainMod SHIFT, Y, ...   # no dwindle equivalent (hy3 changegroup v)

# Focus Hierarchy — NO dwindle equivalent (hy3 changefocus raise/lower)
# bind = $mainMod, A, ...
# bind = $mainMod SHIFT, A, ...

# Equalize window sizes — NO native equivalent (hy3 equalize)
# bind = $mainMod CTRL, 0, ...

# Resize
binde = $mainMod CTRL SHIFT, right, resizeactive, 50 0
binde = $mainMod CTRL SHIFT, left, resizeactive, -50 0
binde = $mainMod CTRL SHIFT, down, resizeactive, 0 50
binde = $mainMod CTRL SHIFT, up, resizeactive, 0 -50
binde = $mainMod CTRL, equal, exec, ~/.config/hypr/accel-resize.sh grow
binde = $mainMod CTRL, minus, exec, ~/.config/hypr/accel-resize.sh shrink

# Window State
bind = $mainMod, Q, killactive
bind = ALT, F4, killactive
bind = CTRL, Escape, killactive
bind = $mainMod, Escape, killactive
bind = $mainMod, F, fullscreen

bind = , F10, exec, ~/.local/bin/toggle-scratchpad.sh lite-xl 900 600 --class com.lite_xl.LiteXL lite-xl
bind = $mainMod, grave, workspace, previous

# Media Keys
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Workspace Switching (1-5)
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5

# Move Window to Workspace
bind = $mainMod CTRL, 1, movetoworkspace, 1
bind = $mainMod CTRL, 2, movetoworkspace, 2
bind = $mainMod CTRL, 3, movetoworkspace, 3
bind = $mainMod CTRL, 4, movetoworkspace, 4
bind = $mainMod CTRL, 5, movetoworkspace, 5
