    -- machine wants because it runs on a battery and closes shut, so they
    -- follow that property rather than a host name: no battery, no hypridle at
    -- all. A new laptop picks the whole ladder up with no edit here, and a
    -- desktop never starts locking itself after ten idle minutes.
    hl.exec_cmd("sh -c 'ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1 && exec hypridle'")
