-- CROSSING MONITORS
--
-- nary's tree covers one workspace, so the workspace edge is exactly where the
-- next monitor begins: a move with nowhere left to go inside the tree is a move
-- off the side of the screen, and hands the window over.
--
-- "Nowhere left to go" is read off the layout rather than guessed at from
-- geometry. A tile flush against the edge often still has somewhere to go —
-- pressing up out of a row takes a band across the whole workspace — and only
-- the tree knows which case this is. So the move is dispatched and the layout
-- asked whether anything changed.
local function layout_shape()
    local ws = hl.get_active_workspace()
    return ws and ws.id and nary.shape(nary.space(ws.id)) or nil
end

-- The monitor next along the axis of travel. Nearest centre wins, with sideways
-- offset counting double, so the display stacked above the ultrawide is not
-- also "to the right" of it.
local function monitor_in(dir)
    local from = hl.get_active_monitor()
    if not from then return nil end

    local horizontal = (dir == "left" or dir == "right")
    local ahead      = (dir == "right" or dir == "down") and 1 or -1

    -- width/height are the mode's pixels; the layout coordinates monitors are
    -- positioned in are those divided by the scale.
    local function centre(m)
        local scale = m.scale or 1
        return (m.x or 0) + (m.width or 0) / scale / 2,
               (m.y or 0) + (m.height or 0) / scale / 2
    end

    local fx, fy = centre(from)
    local best, best_cost

    for _, m in ipairs(hl.get_monitors() or {}) do
        if m.id ~= from.id then
            local x, y   = centre(m)
            local along  = horizontal and (x - fx) or (y - fy)
            local across = horizontal and (y - fy) or (x - fx)

            if along * ahead > 0 then
                local cost = math.abs(along) + math.abs(across) * 2
                if not best_cost or cost < best_cost then best, best_cost = m, cost end
            end
        end
    end
    return best
end

-- Hand the focused window to the monitor that way, entering by the edge it
-- crossed: `enter` tells that workspace's tree to take it as a division of the
-- whole workspace on the near side, rather than as a neighbour of whatever
-- happens to be focused over there. False when there is no monitor that way —
-- the single-display case, where these keys stay within-workspace moves.
local function cross_monitor(dir)
    local mon = monitor_in(dir)
    local ws  = mon and mon.active_workspace
    if not (ws and ws.id) then return false end

    hl.dispatch(hl.dsp.layout(("enter %s %s"):format(DIR_SHORT[dir], nary.space(ws.id))))
    hl.dispatch(hl.dsp.window.move({ workspace = tostring(ws.id) }))
    return true
end

local function step_or_cross(dir)
    local before = layout_shape()
    hl.dispatch(hl.dsp.layout("move " .. DIR_SHORT[dir]))
    if before and layout_shape() == before then cross_monitor(dir) end
end

-- Move Window — steps one insertion slot through the nary tree. Repeatedly
-- pressing right walks: swap with sibling -> pop out of the group -> cross the
-- row -> join the next neighbour -> swap inside it -> pop out again -> off the
-- edge onto the next monitor.
--
-- A tab has no slot of its own to step through — its whole group occupies one
-- leaf — so for a tabbed window the same key means the other escape: leave the
-- tab strip and take a pane of its own on that side. Inverse of SUPER + ALT.
-- A tab leaves its strip for a pane on that side (see untab); anything else
-- steps through the tree as before.
local function untab_or_step(dir)
    return function()
        if not untab(dir) then step_or_cross(dir) end
    end
end

hl.bind(mainMod .. " + CTRL + left",  untab_or_step("left"))
hl.bind(mainMod .. " + CTRL + right", untab_or_step("right"))
hl.bind(mainMod .. " + CTRL + up",    untab_or_step("up"))
hl.bind(mainMod .. " + CTRL + down",  untab_or_step("down"))

-- Same step through the tree, with the un-tab suppressed: a tab strip travels
-- as one tile instead of the focused tab leaving it. nary already moves whole
-- tiles — CTRL alone only looks different because it spends the keypress on
-- escaping the strip first — so adding ALT is just declining that escape.
for _, dir in ipairs({ "left", "right", "up", "down" }) do
    hl.bind(mainMod .. " + CTRL + ALT + " .. dir, function() step_or_cross(dir) end)
end

-- UNDO — a key of its own, because an arrow cannot carry two meanings
--
-- A move that restructured the tree is not reversed by pressing the opposite
-- arrow: the reverse press computes against a slot list the old layout is not
-- in. nary keeps a trail so the old layout can be restored exactly, and this is
-- the key that walks it.
--
-- Retracing used to live on the opposite arrow instead. That made an arrow mean
-- two things — "move it that way" and "put it back" — which disagree after
-- exactly the moves that need a trail, with nothing on screen to say which one
-- you were about to get. There is also no honest rule for guessing which was
-- meant, because the arrows are not spatial to begin with: measured across the
-- ladder, about one press in five does not move the tile the way the key points
-- and one in ten moves it the opposite way, since grouping trades a tile's
-- share for its position and at a workspace edge only the share can give.
--
-- BackSpace rather than Z: this undoes a layout, not an edit, and every app
-- underneath has its own CTRL-Z that must keep working.
hl.bind(mainMod .. " + CTRL + BackSpace", hl.dsp.layout("undo"))

-- Scoping undo to the keypress gesture that made it — the trail living only
-- while the modifiers from the move are still held — is DELIBERATELY OFF.
--
-- It was built for undo-on-the-opposite-arrow, where it drew the line between
-- "still mid-move, put that back" and "a fresh press, move it that way". A key
-- of its own is not held down and so has no gesture to belong to, and expiring
-- the trail on a modifier release would only mean undo stops working the moment
-- you let go of the move you wanted to undo.
--
-- Kept, wired to nothing, because the binds are the fiddly part and all three
-- flags are load-bearing:
--   ignore_mods   — the other modifier is usually still down when this one is
--                   released, and which mods were held when a mod key itself
--                   was pressed depends on the order they went down in.
--   transparent   — a bind that fires shadows every other bind whose key is
--                   still held, and SUPER/CTRL are exactly that. Without this
--                   the move just made would suppress its own end.
--   non_consuming — a modifier release the focused window never sees would
--                   leave it thinking the modifier is stuck down.
local GESTURE_SCOPED_UNDO = false

if GESTURE_SCOPED_UNDO then
    for _, mod_key in ipairs({ "Super_L", "Super_R", "Control_L", "Control_R" }) do
        hl.bind(mod_key, function() nary.end_move() end,
                { release = true, ignore_mods = true, transparent = true, non_consuming = true })
    end
end

