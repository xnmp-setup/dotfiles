---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("vicinae server")
    -- A shader runs before native output cloning, so both laptop mirror outputs
    -- receive the same 3500K night tint. Desktops retain solar-time wlsunset.
    nightlight.start(hl, is_laptop)
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
    -- Idle dimming, blanking and locking (see hypridle.conf) are things a
    -- machine wants because it runs on a battery and closes shut, so they
    -- follow that property rather than a host name: no battery, no hypridle at
    -- all. A new laptop picks the whole ladder up with no edit here, and a
    -- desktop never starts locking itself after ten idle minutes.
    hl.exec_cmd("sh -c 'ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1 && exec hypridle'")
    -- scratchpad-autohide.sh and imv-splash.sh are gone: both tailed the event
    -- socket through socat to react to focus, which is an `hl.on` handler now.
    hl.exec_cmd("wezterm", { workspace = "1" })
    hl.exec_cmd("google-chrome-stable", { workspace = "1" })
    -- Obsidian is launched by the startup pairing module, once Chrome's
    -- window is up, so the two land next to each other and can be tabbed.
    startup_pairing.start()
    hl.exec_cmd("systemctl --user start hypr-session-save.service")
{{ if eq .chezmoi.hostname "t14s" }}
    -- NixOS laptop: polkit agent is not autostarted by anything else
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
{{- end }}
end)


