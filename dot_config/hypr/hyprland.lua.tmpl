-- Hyprland Lua config (0.55+).
--
-- IMPORTANT: Hyprland prefers hyprland.lua over hyprland.conf — when both
-- exist, the .conf is never read (see Jeremy::getMainConfigPath). This file is
-- the only config; the legacy .conf was removed to avoid edits landing in a
-- file Hyprland ignores.
--
-- Layout is "lua:nary" (see nary.lua): an N-ary tiling tree, so three windows
-- can be equal peers rather than dwindle's forced binary nesting.

local nary = require("nary")
local host_capabilities = require("host_capabilities")
local is_laptop = host_capabilities.has_battery()

local theme           = require("theme")
local window_actions  = require("window_actions").new(hl)
local app_switchers   = require("app_switcher")
local exposes         = require("expose")
local group_actions   = require("group_actions").new(hl)
local display_mirror  = require("display_mirror").new(hl, { enabled = is_laptop })
local nightlight      = require("nightlight")
local spotlights      = require("spotlight")
local startup_pairing = require("startup_pairing").new(hl, {
    browser_class = "google-chrome",
    notes_class = "obsidian",
    workspace = 1,
})
local terminal_groups = require("terminal_grouping")
local navigation      = require("window_navigation").new(hl, nary, group_actions)
local resize          = require("window_resize").new(hl)
local scratchpad      = require("scratchpad").new(hl, window_actions)

-- Group tab geometry. The strip is TAB_HEIGHT tall; each tab rect is drawn
-- TAB_DROP taller so it hangs that far over the window, and the fill carves
-- the overhang back off (see theme.tab_fill and the groupbar block below).
-- The drop has to clear TAB_ROUNDING for the carve to square the bottom.
local TAB_HEIGHT   = 28
local TAB_ROUNDING = 8
local TAB_DROP     = TAB_ROUNDING
local TAB_FLOAT    = 4 -- how far an unfocused pill sits off the window

local function tab_fill(hex, alpha, detached)
    local carve = TAB_DROP + (detached and TAB_FLOAT or 0)
    return theme.tab_fill(hex, alpha, TAB_HEIGHT + TAB_DROP, carve)
end

