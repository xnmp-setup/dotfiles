hl.config({
    general = {
        gaps_in     = 5,
        gaps_out    = 10,
        border_size = 2,

        -- Accent gradient from the active theme (see theme.lua).
        col = {
            active_border   = theme.active_gradient(),
            inactive_border = theme.rgba(theme.colors.border, "aa"),
        },

        layout = "lua:nary",
    },

    decoration = {
        rounding     = 3, -- Sharp corners = faster visual scan
        dim_inactive = false,
        dim_strength = 0.4,
        dim_special  = 0.4,
        blur = {
            enabled = true,
            size    = 3,
            passes  = 1,
            special = true,
        },
    },

    cursor = {
        no_warps = true,
    },

    misc = {
        -- What shows through while a window is catching up with a resize.
        -- Hyprland's default is #111111, which reads as a grey glitch against
        -- any palette; the theme's own background makes it read as depth.
        -- (render:expand_undersized_textures, which stretches the stale buffer
        -- rather than exposing this at all, is already on by default.)
        background_color = "rgb(" .. theme.colors.background .. ")",

        -- XDG_CURRENT_DESKTOP is deliberately GNOME (set below, for portals);
        -- silence the "managed externally" banner Hyprland shows about it.
        disable_xdg_env_checks = true,
    },

    input = {
        kb_layout                   = "us",
        follow_mouse                = 0,
        float_switch_override_focus = 0,
        -- Let a background click focus the regular workspace so the existing
        -- focus handlers can dismiss scratchpads and restore spotlit windows.
        special_fallthrough         = true,
        sensitivity                 = 0, -- Raw input, like turning off mouse accel in StarCraft
        scroll_factor               = 1.0, -- Preserve Hyprland's default external mouse-wheel speed

        -- Touchpad two-finger scrolling remains slower and is configured
        -- independently from the external mouse-wheel factor above.
        touchpad = {
            -- On clickpads, enabling chord emulation removes the bottom-centre
            -- middle-button area; MMB then requires pressing LMB + RMB together.
            middle_button_emulation = true,
            scroll_factor = 0.15, -- 1.0 is libinput's default; below ~0.15 discrete-wheel apps stall
        },
    },

    -- Native tabbed groups (replaces hy3 tabs)
    group = {
        col = {
            border_active   = theme.active_gradient(),
            border_inactive = theme.rgba(theme.colors.border, "aa"),
        },
        -- Tab strip, painted like WezTerm's tab bar rather than the default
        -- yellow gradient: flat, bar in the theme's background, active tab a
        -- shade lifted off it. Locked groups get the theme's accent.
        --
        -- height has to lead font_size: the strip does not grow to fit its text,
        -- so a font raised on its own is clipped top and bottom.
        --
        -- `gradients` is the tab FILL, not the colour wash it sounds like: off,
        -- Hyprland paints no tab background at all, and the titles float on the
        -- window's own blurred, translucent surface — unreadable over a bright
        -- wallpaper. On, it paints the colours below, and since each is a
        -- single stop the fill comes out flat.
        --
        -- Shape: floating translucent pills — gaps let the wallpaper breathe
        -- between tabs, every corner rounded (round_only_edges would square
        -- the corners where pills meet). The focused pill is opaque, bold,
        -- and its square bottom sits flush on the window; unfocused pills
        -- float above it.
        --
        -- Every one of those is per-tab, and the only per-tab knob the
        -- groupbar has is the fill, so all of it is done in theme.tab_fill:
        -- the tab rect is drawn TAB_DROP px taller than the strip and hangs
        -- that far over the window, and each fill carves back the part it
        -- doesn't want. Carving past the corner radius squares the bottom
        -- (see theme.tab_fill), so the focused pill carves exactly the
        -- overhang and lands square on the window, and an unfocused pill
        -- carves a further TAB_FLOAT to lift off it. Both keep their real,
        -- rounded top.
        --
        -- Everything is one texture draw, which is the point. The groupbar's
        -- other way to paint a tab, the indicator, is a plain rect drawn over
        -- the fill on a separate render path, and the two never line up: the
        -- indicator rounds its rect to whole pixels where the fill does not,
        -- so it overhangs the pill by a pixel on whichever side the bar width
        -- happens to divide badly, and the same configured colour measured a
        -- few points off between the two paths. It is off (indicator_height
        -- 0) rather than used to patch the pill's bottom.
        groupbar = {
            enabled       = true,
            font_size     = 12,
            font_weight_active = "bold",
            height        = TAB_HEIGHT + TAB_DROP,
            render_titles = true,
            gradients     = true,
            rounding          = 0,
            gradient_rounding = TAB_ROUNDING,
            gradient_round_only_edges = false,
            round_only_edges = false,
            gaps_in        = 6,
            gaps_out       = 0,
            -- The strip reserves height + indicator_gap; the negative gap is
            -- what hangs the tab rect over the window. No indicator is drawn.
            indicator_height = 0,
            indicator_gap    = -TAB_DROP,
            -- Titles centre themselves in the whole rect, overhang included;
            -- lift them back into the middle of the visible pill.
            text_offset      = TAB_DROP // 2,
            col = {
                active          = tab_fill(theme.colors.surface, "ff", false),
                inactive        = tab_fill(theme.colors.background, "88", true),
                locked_active   = tab_fill(theme.colors.accent, "ff", false),
                locked_inactive = tab_fill(theme.colors.background, "88", true),
            },
            text_color                 = theme.rgba(theme.colors.text),
            text_color_inactive        = theme.rgba(theme.colors.text_dim),
            text_color_locked_active   = theme.rgba(theme.colors.accent),
            text_color_locked_inactive = theme.rgba(theme.colors.text_dim),
        },
    },

    animations = {
        enabled = true,
    },
})


