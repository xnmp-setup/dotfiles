hl.bind("SUPER + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Flip the focused window's container between rows and columns.
hl.bind(mainMod .. " + comma",        hl.dsp.layout("toggleorient"))
hl.bind(mainMod .. " + slash",        hl.dsp.layout("toggleorient"))
hl.bind(mainMod .. " + CTRL + comma", hl.dsp.layout("toggleorient"))
hl.bind(mainMod .. " + CTRL + slash", hl.dsp.layout("toggleorient"))
hl.bind(mainMod .. " + H",            hl.dsp.layout("toggleorient"))
hl.bind(mainMod .. " + Y",            hl.dsp.layout("toggleorient"))

-- Native tab-group actions
hl.bind(mainMod .. " + T",            group_actions.ungroup)
hl.bind(mainMod .. " + SHIFT + T",    group_actions.ungroup)
hl.bind(mainMod .. " + bracketleft",  hl.dsp.group.prev())
hl.bind(mainMod .. " + bracketright", hl.dsp.group.next())
hl.bind(mainMod .. " + CTRL + Prior", hl.dsp.group.prev())
hl.bind(mainMod .. " + CTRL + Next",  hl.dsp.group.next())
hl.bind(mainMod .. " + ALT + Prior",  hl.dsp.group.prev())
hl.bind(mainMod .. " + ALT + Next",   hl.dsp.group.next())
hl.bind("CTRL + SHIFT + Prior",       hl.dsp.group.prev())
hl.bind("CTRL + SHIFT + Next",        hl.dsp.group.next())

-- Unfold every tab strip on the workspace into panes; selecting a pane folds
