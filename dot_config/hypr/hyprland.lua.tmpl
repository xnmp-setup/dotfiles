local expose = exposes.new(hl, {
    dissolve_lone_groups = group_actions.dissolve_lone_groups,
})

local app_switcher = app_switchers.new(hl, window_actions, {
    select_target = expose.select_target,
})

-- GUI windows launched by a terminal become another tab in that terminal's
-- tile. The feature owns process ancestry and focus-fallback tracking.
terminal_groups.new(hl, {
    consume_managed_launch = app_switcher.consume_managed_launch,
    exclude_source = scratchpad.is_scratchpad,
    -- At startup wezterm is the focused terminal when Chrome opens, so the
    -- focus fallback would pull Chrome (and then Obsidian) into wezterm's
    -- tile. The pairing sequence owns those windows; leave wezterm alone.
    suppress = startup_pairing.is_waiting,
})

