---------------------------
---- SPOTLIT WINDOWS ------
---------------------------
-- One window pulled to the front of the workspace with everything behind it
-- dimmed, until focus moves on. Two ways in: SUPER + CTRL + End floats and
-- centres whatever is focused, and an imv window does it to itself when it
-- opens, so a previewed image lands centred rather than tiled into the grid.
--
-- Both were shell scripts (toggle-float-center.sh, imv-splash.sh) that tailed
-- the event socket through socat and toggled dim with `hyprctl keyword` — a
-- command the Lua config refuses outright ("can't work with non-legacy
-- parsers"). Dim is a config write and focus is an event, so both belong here.

-- { address, floated, was } while something is held forward. `floated` records
-- that the spotlight is what floated it, and so that letting go should tile it
-- back; a window that was already floating (imv, by window rule) is left
-- floating.
--
-- LETTING GO PUTS IT BACK. Pulling a window forward moves it, so releasing it
-- has to move it home again, and where home is depends on which kind of window
-- it was:
--   * a tiled window has no geometry of its own to remember — its slot in the
--     nary tree is its position, and that slot stops existing the moment it
--     floats out. nary photographs the workspace for us instead (`hold`), and
--     `restore` puts the photograph back once the window has tiled again.
--   * an already-floating window is the opposite: nothing in the tree to keep,
--     but a position and size that are its own and that centring destroys. So
--     `was` records them, and they are dispatched straight back.
local spotlit = nil

local function unspotlight()
    local held = spotlit
    spotlit = nil
    hl.config({ decoration = { dim_inactive = false, dim_strength = 0.4 } })
    if not held then return end

    for _, w in ipairs(hl.get_windows() or {}) do
        if w.address == held.address then
            if held.floated then
                if w.floating then
                    hl.dispatch(hl.dsp.window.float({ action = "off", window = w }))
                    -- After the un-float, not before: until the window is back
                    -- among the layout's targets the photograph describes a
                    -- window nary cannot see, and restoring it would drop the
                    -- very leaf it was taken for.
                    hl.dispatch(hl.dsp.layout("restore"))
                end
            elseif held.was then
                -- Size first: moving to a corner and then growing from it would
                -- land the window somewhere else again.
                hl.dispatch(hl.dsp.window.resize({ x = held.was.size.x, y = held.was.size.y, window = w }))
                hl.dispatch(hl.dsp.window.move({ x = held.was.at.x, y = held.was.at.y, window = w }))
            end
            return
        end
    end
end

local function spotlight(w, opts)
    if not w then return end
    opts = opts or {}

    local floated = not w.floating
    local was     = nil

    if floated then
        -- While it is still tiled, so the photograph has its slot in it.
        hl.dispatch(hl.dsp.layout("hold"))
        hl.dispatch(hl.dsp.window.float({ action = "on", window = w }))
    else
        was = { at = w.at, size = w.size }
    end

    if opts.size then
        hl.dispatch(hl.dsp.window.resize({ x = opts.size[1], y = opts.size[2], window = w }))
    end
    hl.dispatch(hl.dsp.focus({ window = w }))
    hl.dispatch(hl.dsp.window.center())

    spotlit = { address = w.address, floated = floated, was = was }
    hl.config({ decoration = { dim_inactive = true, dim_strength = opts.dim or 0.4 } })
end

-- Half the monitor's width and 80% of its height, in layout coordinates — the
-- proportions toggle-float-center.sh used, which is why it had to divide by the
-- monitor scale itself.
local function centred_size()
    local mon = hl.get_active_monitor()
    if not (mon and mon.width and mon.height) then return nil end
    local scale = mon.scale or 1
    return { math.floor(mon.width / scale * 0.5), math.floor(mon.height / scale * 0.8) }
end

hl.bind(mainMod .. " + CTRL + end", function()
    local w = hl.get_active_window()
    if not w then return end

    if spotlit and spotlit.address == w.address then
        unspotlight()
    else
        spotlight(w, { size = centred_size(), dim = 0.2 })
    end
end)

-- imv is floated and sized by window rule already, so the spotlight only has to
-- centre it and dim what is behind.
hl.on("window.open", function(w)
    if w and w.class == "imv" then spotlight(w) end
end)

-- Anything else taking focus ends it.
hl.on("window.active", function()
    if not spotlit then return end
    local active = hl.get_active_window()
    if not active or active.address ~= spotlit.address then unspotlight() end
end)

hl.on("window.close", function(w)
    if spotlit and w and w.address == spotlit.address then unspotlight() end
end)

-- Invade the neighbour in that direction: the focused window leaves its tile and
-- becomes a tab of the window it lands on, creating that group if the neighbour
-- is a plain window. SUPER + T dissolves the group again.
--
-- The neighbour may be on the next monitor. Hyprland only ever looks for one on
-- the current workspace, so crossing is done by hand: the window is handed over
-- as a division of that whole workspace, which leaves everything already there
-- squarely in the same direction, and the same invade is dispatched again. What
-- it lands on is therefore the division against the boundary — the window that
-- WAS across it.
--
-- Whether the first invade found anything is read off the tile the window is
-- on: a merge changes the set of windows sharing it, and nothing else here can.
local function tile_of(w)
    local members = w and w.group and w.group.members
    if not members then return "" end
    if members.stable_id then members = { members } end -- a lone member is not wrapped

    local ids = {}
    for _, m in ipairs(members) do ids[#ids + 1] = tostring(m.stable_id) end
    table.sort(ids)
    return table.concat(ids, ",")
end

local function invade(dir)
    return function()
        local w = hl.get_active_window()
        if not w then return end

        local before = tile_of(w)
        hl.dispatch(hl.dsp.window.move({ into_or_create_group = dir }))
        if tile_of(hl.get_active_window()) ~= before then return end

        if cross_monitor(dir) then
            hl.dispatch(hl.dsp.window.move({ into_or_create_group = dir }))
        end
    end
end

hl.bind(mainMod .. " + ALT + left",  invade("left"))
hl.bind(mainMod .. " + ALT + right", invade("right"))
hl.bind(mainMod .. " + ALT + up",    invade("up"))
hl.bind(mainMod .. " + ALT + down",  invade("down"))

-- Resize. Tiled windows go through nary's own `resize`, not window.resize: the
-- Lua layout API has no resize hook at all (a provider is only recalculate +
-- layout_msg), so window.resize is silently a no-op on anything tiled. What it
-- moves is the TILE, which for a tab strip is the whole group.
--
-- Floating windows have no tile, so they keep the real dispatcher.
local function resize_tile(dx, dy)
    return function()
        local w = hl.get_active_window()
        if w and w.floating then
            hl.dispatch(hl.dsp.window.resize({ x = dx, y = dy, relative = true }))
        else
            hl.dispatch(hl.dsp.layout(("resize %d %d"):format(dx, dy)))
        end
    end
end

hl.bind(mainMod .. " + CTRL + SHIFT + right", resize_tile(50, 0),  { repeating = true })
hl.bind(mainMod .. " + CTRL + SHIFT + left",  resize_tile(-50, 0), { repeating = true })
hl.bind(mainMod .. " + CTRL + SHIFT + down",  resize_tile(0, 50),  { repeating = true })
hl.bind(mainMod .. " + CTRL + SHIFT + up",    resize_tile(0, -50), { repeating = true })

-- Grow/shrink the tile on both axes at once, with a step that accelerates while
-- the key is held so a large change does not take twenty presses. This lived in
-- accel-resize.sh, which timestamped itself through /tmp and drove
-- `hyprctl --batch dispatch` — a syntax the Lua config no longer accepts.
--
-- Rather than timing the gap between presses, each press arms a one-shot timer
-- that drops the step back to base. Held down, a later press always supersedes
-- the pending reset before it can fire.
local ACCEL = { base = 40, max = 200, increment = 30, idle_ms = 400 }
local accel = { step = ACCEL.base, generation = 0 }

local function accel_resize(sign)
    return function()
        local step = sign * accel.step
        hl.dispatch(hl.dsp.layout(("resize %d %d"):format(step, step)))

        accel.step = math.min(ACCEL.max, accel.step + ACCEL.increment)

        -- Superseding rather than cancelling: timers already in flight still
        -- fire, but only the one armed by the most recent press still matches.
        accel.generation = accel.generation + 1
        local mine = accel.generation
        hl.timer(function()
            if accel.generation == mine then accel.step = ACCEL.base end
        end, { timeout = ACCEL.idle_ms, type = "oneshot" })
    end
end

hl.bind(mainMod .. " + CTRL + equal", accel_resize(1),  { repeating = true })
hl.bind(mainMod .. " + CTRL + minus", accel_resize(-1), { repeating = true })

