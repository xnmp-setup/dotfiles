-- Move Window — steps one insertion slot through the nary tree. Repeatedly
-- pressing right walks: swap with sibling -> pop out of the group -> cross the
-- row -> join the next neighbour -> swap inside it -> pop out again.
--
-- A tab has no slot of its own to step through — its whole group occupies one
-- leaf — so for a tabbed window the same key means the other escape: leave the
-- tab strip and take a pane of its own on that side. Inverse of SUPER + ALT.
-- A tab leaves its strip for a pane on that side (see untab); anything else
-- steps through the tree as before.
local function untab_or_step(dir)
    local step = hl.dsp.layout("move " .. DIR_SHORT[dir])
    return function()
        if not untab(dir) then hl.dispatch(step) end
    end
end

hl.bind(mainMod .. " + CTRL + left",  untab_or_step("left"))
hl.bind(mainMod .. " + CTRL + right", untab_or_step("right"))
hl.bind(mainMod .. " + CTRL + up",    untab_or_step("up"))
hl.bind(mainMod .. " + CTRL + down",  untab_or_step("down"))

-- Same step through the tree, with the un-tab suppressed: a tab strip travels
-- as one tile instead of the focused tab leaving it. nary already moves whole
-- tiles — CTRL alone only looks different because it spends the keypress on
-- escaping the strip first — so adding ALT is just declining that escape.
for _, dir in ipairs({ "left", "right", "up", "down" }) do
    hl.bind(mainMod .. " + CTRL + ALT + " .. dir, hl.dsp.layout("move " .. DIR_SHORT[dir]))
end

