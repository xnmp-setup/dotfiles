--------------------------
---- TABS  (= GROUPS) ----
--------------------------
-- Hyprland "tabs" are groups: several windows share one tile and the groupbar
-- above it is the tab strip. A group is a single leaf of the nary tree, so
-- tabbing and tiling compose rather than compete.
--
-- A group is only dissolved when it is ALREADY down to one member at removal
-- time (CGroup::remove computes its REMOVING_GROUP flag before the erase), so
-- taking a window out of a pair leaves a one-tab group behind — a tab title
-- over what is plainly just a window. No config key turns that off, so sweep
-- them up ourselves.

local function dissolve_lone_groups()
    local lone = {}
    for _, w in ipairs(hl.get_windows() or {}) do
        local g = w.group
        if g and g.size == 1 then lone[#lone + 1] = w end
    end
    for _, w in ipairs(lone) do
        hl.dispatch(hl.dsp.group.toggle({ window = w }))
    end
end

-- Every way a group can shrink has to be covered and there is no "a group
-- changed" event: a tab can leave by being closed, dragged off the groupbar,
-- sent to another workspace or monitor, or tabbed into a different window
-- entirely. So the sweep hangs off the events that accompany any of those,
-- coalesced through a single one-shot timer.
--
-- Deferring is what makes it safe to hook so broadly. These events fire in the
-- middle of the operation — window.close before the window has left its group,
-- and moveIntoOrCreateGroup passing through a group of one on its way to two —
-- so a sweep running inline would variously miss the change or undo it, while
-- a moment later only the settled result is visible. It also reacts sooner than
-- window.destroy alone, which waits for the close animation to finish and would
-- leave the lone tab bar up for the length of the fade.
local sweeping = false

local function sweep_lone_groups()
    if sweeping then return end
    sweeping = true
    hl.timer(function()
        sweeping = false
        dissolve_lone_groups()
    end, { timeout = 60, type = "oneshot" })
end

for _, event in ipairs({ "window.close", "window.destroy", "window.active", "window.move_to_workspace" }) do
    hl.on(event, sweep_lone_groups)
end

-- group.toggle() on an ungrouped window creates a group of one — the very thing
-- swept up above. Keep only the useful half: dissolve a group, never open one.
-- Tabs are made by invading a neighbour (SUPER + ALT + arrows), which groups two
-- windows at once.
local function ungroup()
    local w = hl.get_active_window()
    if w and w.group then hl.dispatch(hl.dsp.group.toggle()) end
end

-- Take the focused window out of its tab strip and give it a pane on the named
-- side. nary has to be told which side first: Hyprland's own hint for this (the
-- focal point handed to movedTarget) is discarded by the Lua layout API, so
-- without the message the pane is merely adopted wherever the tree puts it.
local DIR_SHORT = { left = "l", right = "r", up = "u", down = "d" }

local function untab(dir)
    local w = hl.get_active_window()
    if not (w and w.group and w.group.size > 1) then return false end

    hl.dispatch(hl.dsp.layout("untab " .. DIR_SHORT[dir]))
    hl.dispatch(hl.dsp.window.move({ out_of_group = dir }))
    dissolve_lone_groups() -- the tile it left may now be a group of one
    return true
end


-----------------------------------
---- EXPOSE  (mission control) ----
-----------------------------------
-- F1 unfolds every tabbed group on the workspace into panes, so all of
-- them can be seen at once. The next window SELECTED — clicked, or focused any
-- other way — folds them all back exactly as they were, with the selected one
-- raised as the visible tab of its own strip. Pressing the key again folds with
-- whatever is focused, for selecting without a click.
--
-- A CLICK is picked up as a click, not as the focus change it usually causes.
-- Clicking the pane that already had the focus is not a focus change at all,
-- and that is the most ordinary thing to do here — hit the key, look, decide to
-- stay where you were. Hyprland's Lua API cannot park the focus somewhere
-- harmless first (there is no way to focus nothing), so while unfolded the left
-- button is bound and resolves the pane under the cursor itself, rather than
-- being passed through to it. Every pane is then equally selectable, the one
-- already focused included.
--
-- Focus changes still select, for choosing with the keyboard. The unfolding's
-- own focus churn (dissolving a group refocuses) has to be kept out of that:
-- dispatches made here are flagged, and the listener only arms once the unfold
-- has settled. A click needs no such guard — it is always the user.
--
-- Hyprland cannot build a group from a list of windows: the only way in is
-- moveintogroup, which merges whatever lies in a DIRECTION. So folding back
-- sends each pane at whatever the merges before it left behind, which works
-- only because unfolding asked the layout for a known shape: a grid filling the
-- tile's own slot, row-major in tab order, starting from the tab that was
-- visible (nary's `explode`).
--
-- That makes the directions fall out of the grid. The first row merges
-- leftwards into the tile. Every later row merges upwards, because by the time
-- it is reached the rows above have collapsed into the tile, which spans the
-- full width above it.
--
-- Every pane folds back, the selection included and in its row position — it
-- cannot be held aside and merged last, because a pane left sitting among panes
-- still merging leftwards would swallow them. Raising it is a separate step,
-- which is also how the other strips get the tab they had showing back.

local exposed = nil   -- while unfolded: the groups to put back
local armed   = false -- is a focus change a selection yet?
local busy    = false -- ... or is it one of ours?

-- Bound only while unfolded, so ordinary clicking is untouched the rest of the
-- time. Plain left button: a modified click (dragging a window with the mod
-- held, say) carries a different modmask and does not match.
local SELECT_BUTTON = "mouse:272"
local expose_click -- bound on unfold, defined once folding exists to call

-- The pane under the cursor. Windows are in no particular depth order here, so
-- overlaps are broken the way the compositor would: a floating window sits over
-- a tiled one, and the more recently focused of two floats sits over the other.
--
-- Only what is on screen. A window parked on a workspace nobody is looking at —
-- a scratchpad above all — is still mapped and still has the geometry it will
-- have when it comes back, so it sits under the cursor as far as arithmetic is
-- concerned, and would be picked over the pane actually being clicked on.
local function visible_workspaces()
    local ids = {}
    for _, m in ipairs(hl.get_monitors() or {}) do
        local ws, special = m.active_workspace, m.special_workspace
        if ws and ws.id then ids[ws.id] = true end
        if special and special.id then ids[special.id] = true end
    end
    return ids
end

local function window_at_cursor()
    local pos = hl.get_cursor_pos()
    if not pos then return nil end

    local visible = visible_workspaces()

    local best
    for _, w in ipairs(hl.get_windows() or {}) do
        local at, size = w.at, w.size
        if w.mapped and not w.hidden and at and size
            and w.workspace and visible[w.workspace.id]
            and pos.x >= at.x and pos.x < at.x + size.x
            and pos.y >= at.y and pos.y < at.y + size.y
        then
            local over = not best
                or (w.floating and not best.floating)
                or (w.floating == best.floating
                    and (w.focus_history_id or 0) < (best.focus_history_id or 0))
            if over then best = w end
        end
    end
    return best
end

local function tabbed_groups()
    local ws = hl.get_active_workspace()
    local seen, groups = {}, {}

    for _, w in ipairs(hl.get_windows() or {}) do
        local group = w.group
        if group and group.size > 1 and group.current and ws and w.workspace and w.workspace.id == ws.id then
            local anchor = group.current
            local key    = tostring(anchor.stable_id)

            if not seen[key] then
                seen[key] = true

                local members = group.members
                if members and members.stable_id then members = { members } end

                -- In group order, minus the visible tab: exactly the windows
                -- `explode` lays out beside it, in the same order.
                local rest = {}
                for _, m in ipairs(members or {}) do
                    if m.stable_id and m.stable_id ~= anchor.stable_id then rest[#rest + 1] = m end
                end

                groups[#groups + 1] = { anchor = anchor, rest = rest }
            end
        end
    end
    return groups
end

-- How many columns to unfold `n` tabs into, given the shape of the tile they
-- are on. Every column count is tried and the one whose cells come out closest
-- to square wins, penalised for cells it would leave empty — a short last row
-- stretches to fill the width, so a ragged grid is an uneven one.
--
-- The answer follows the tile rather than the count: on a 1440-tall tile, four
-- tabs land on 2x2 at half an ultrawide's width, stack into a single column at
-- 700px, and lay out as one row of four across the full 3440.
local function grid_columns(w, h, n)
    if n < 2 or not w or not h or w <= 0 or h <= 0 then return 1 end

    local best, best_cost = 1, nil
    for cols = n, 1, -1 do -- descending, so a tie takes the wider grid
        local rows   = math.ceil(n / cols)
        local aspect = (w / cols) / (h / rows)
        local cost   = math.abs(math.log(aspect)) + (rows * cols - n) / n

        if not best_cost or cost < best_cost then best, best_cost = cols, cost end
    end
    return best
end

local function expose_unfold()
    local groups = tabbed_groups()
    if #groups == 0 then return end

    busy = true
    for _, group in ipairs(groups) do
        local size = group.anchor.size
        group.cols = grid_columns(size and size.x, size and size.y, #group.rest + 1)
        hl.dispatch(hl.dsp.layout(("explode %s %d"):format(group.anchor.stable_id, group.cols)))
    end
    for _, group in ipairs(groups) do
        hl.dispatch(hl.dsp.group.toggle({ window = group.anchor }))
    end
    busy = false

    exposed, armed = groups, false
    hl.timer(function() armed = (exposed ~= nil) end, { timeout = 120, type = "oneshot" })
    hl.bind(SELECT_BUTTON, expose_click)
end

-- `selected` is the pane a click resolved; without one — the keyboard path —
-- the selection is whatever holds the focus.
local function expose_fold(selected)
    selected       = selected or hl.get_active_window()
    local sel_id   = selected and selected.stable_id
    local groups   = exposed
    exposed, armed = nil, false
    hl.unbind(SELECT_BUTTON)

    busy = true
    for _, group in ipairs(groups) do
        local merged, raise = 0, 1 -- 1 is the anchor: the tab that was showing

        for i, w in ipairs(group.rest) do
            -- An expired window (closed while unfolded) reads as nil throughout.
            if w.mapped then
                -- Cell i of the grid: the first row folds sideways into the
                -- tile, later rows fold up into what it has become.
                local dir = (i < (group.cols or 1)) and "left" or "up"
                hl.dispatch(hl.dsp.window.move({ window = w, into_or_create_group = dir }))
                merged = merged + 1
                if w.stable_id == sel_id then raise = merged + 1 end
            end
        end

        -- Each merge inserts after the current tab and becomes it, so the strip
        -- comes back as anchor, rest[1], rest[2]... and the tab to raise can be
        -- named by position. Counting only the merges that happened keeps that
        -- true when a window went away while unfolded.
        if merged > 0 and group.anchor.mapped then
            hl.dispatch(hl.dsp.group.active({ index = raise, window = group.anchor }))
        end
    end

    if selected and selected.mapped then
        hl.dispatch(hl.dsp.focus({ window = selected }))
    end
    busy = false

    dissolve_lone_groups()
end

-- Any focus change once unfolded IS the selection.
hl.on("window.active", function()
    if exposed and armed and not busy then expose_fold() end
end)

-- A click on nothing — the gap between panes — is not a selection, and is left
-- to do nothing rather than folding on whatever happened to be focused.
expose_click = function()
    if not exposed then return end
    local w = window_at_cursor()
    if w then expose_fold(w) end
end

local function expose_toggle()
    if exposed then expose_fold() else expose_unfold() end
end

