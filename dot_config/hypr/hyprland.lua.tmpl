--------------------------
---- TABS  (= GROUPS) ----
--------------------------
-- Hyprland "tabs" are groups: several windows share one tile and the groupbar
-- above it is the tab strip. A group is a single leaf of the nary tree, so
-- tabbing and tiling compose rather than compete.
--
-- A group is only dissolved when it is ALREADY down to one member at removal
-- time (CGroup::remove computes its REMOVING_GROUP flag before the erase), so
-- taking a window out of a pair leaves a one-tab group behind — a tab title
-- over what is plainly just a window. No config key turns that off, so sweep
-- them up ourselves.

local function dissolve_lone_groups()
    local lone = {}
    for _, w in ipairs(hl.get_windows() or {}) do
        local g = w.group
        if g and g.size == 1 then lone[#lone + 1] = w end
    end
    for _, w in ipairs(lone) do
        hl.dispatch(hl.dsp.group.toggle({ window = w }))
    end
end

-- Every way a group can shrink has to be covered and there is no "a group
-- changed" event: a tab can leave by being closed, dragged off the groupbar,
-- sent to another workspace or monitor, or tabbed into a different window
-- entirely. So the sweep hangs off the events that accompany any of those,
-- coalesced through a single one-shot timer.
--
-- Deferring is what makes it safe to hook so broadly. These events fire in the
-- middle of the operation — window.close before the window has left its group,
-- and moveIntoOrCreateGroup passing through a group of one on its way to two —
-- so a sweep running inline would variously miss the change or undo it, while
-- a moment later only the settled result is visible. It also reacts sooner than
-- window.destroy alone, which waits for the close animation to finish and would
-- leave the lone tab bar up for the length of the fade.
local sweeping = false

local function sweep_lone_groups()
    if sweeping then return end
    sweeping = true
    hl.timer(function()
        sweeping = false
        dissolve_lone_groups()
    end, { timeout = 60, type = "oneshot" })
end

for _, event in ipairs({ "window.close", "window.destroy", "window.active", "window.move_to_workspace" }) do
    hl.on(event, sweep_lone_groups)
end

-- group.toggle() on an ungrouped window creates a group of one — the very thing
-- swept up above. Keep only the useful half: dissolve a group, never open one.
-- Tabs are made by invading a neighbour (SUPER + ALT + arrows), which groups two
-- windows at once.
local function ungroup()
    local w = hl.get_active_window()
    if w and w.group then hl.dispatch(hl.dsp.group.toggle()) end
end

-- Take the focused window out of its tab strip and give it a pane on the named
-- side. nary has to be told which side first: Hyprland's own hint for this (the
-- focal point handed to movedTarget) is discarded by the Lua layout API, so
-- without the message the pane is merely adopted wherever the tree puts it.
local DIR_SHORT = { left = "l", right = "r", up = "u", down = "d" }

local function untab(dir)
    local w = hl.get_active_window()
    if not (w and w.group and w.group.size > 1) then return false end

    hl.dispatch(hl.dsp.layout("untab " .. DIR_SHORT[dir]))
    hl.dispatch(hl.dsp.window.move({ out_of_group = dir }))
    dissolve_lone_groups() -- the tile it left may now be a group of one
    return true
end

local expose = exposes.new(hl, {
    dissolve_lone_groups = dissolve_lone_groups,
})

local app_switcher = app_switchers.new(hl, window_actions, {
    select_target = expose.select_target,
})

-- GUI windows launched by a terminal become another tab in that terminal's
-- tile. The feature owns process ancestry and focus-fallback tracking; the main
-- config supplies only the layout-specific direction.
terminal_groups.new(hl, {
    direction_towards = direction_towards,
    consume_managed_launch = app_switcher.consume_managed_launch,
})

