--------------------------
---- TABS  (= GROUPS) ----
--------------------------
-- Hyprland "tabs" are groups: several windows share one tile and the groupbar
-- above it is the tab strip. A group is a single leaf of the nary tree, so
-- tabbing and tiling compose rather than compete.
--
-- A group is only dissolved when it is ALREADY down to one member at removal
-- time (CGroup::remove computes its REMOVING_GROUP flag before the erase), so
-- taking a window out of a pair leaves a one-tab group behind — a tab title
-- over what is plainly just a window. No config key turns that off, so sweep
-- them up ourselves.

local function dissolve_lone_groups()
    local lone = {}
    for _, w in ipairs(hl.get_windows() or {}) do
        local g = w.group
        if g and g.size == 1 then lone[#lone + 1] = w end
    end
    for _, w in ipairs(lone) do
        hl.dispatch(hl.dsp.group.toggle({ window = w }))
    end
end

-- Every way a group can shrink has to be covered and there is no "a group
-- changed" event: a tab can leave by being closed, dragged off the groupbar,
-- sent to another workspace or monitor, or tabbed into a different window
-- entirely. So the sweep hangs off the events that accompany any of those,
-- coalesced through a single one-shot timer.
--
-- Deferring is what makes it safe to hook so broadly. These events fire in the
-- middle of the operation — window.close before the window has left its group,
-- and moveIntoOrCreateGroup passing through a group of one on its way to two —
-- so a sweep running inline would variously miss the change or undo it, while
-- a moment later only the settled result is visible. It also reacts sooner than
-- window.destroy alone, which waits for the close animation to finish and would
-- leave the lone tab bar up for the length of the fade.
local sweeping = false

local function sweep_lone_groups()
    if sweeping then return end
    sweeping = true
    hl.timer(function()
        sweeping = false
        dissolve_lone_groups()
    end, { timeout = 60, type = "oneshot" })
end

for _, event in ipairs({ "window.close", "window.destroy", "window.active", "window.move_to_workspace" }) do
    hl.on(event, sweep_lone_groups)
end

-- group.toggle() on an ungrouped window creates a group of one — the very thing
-- swept up above. Keep only the useful half: dissolve a group, never open one.
-- Tabs are made by invading a neighbour (SUPER + ALT + arrows), which groups two
-- windows at once.
local function ungroup()
    local w = hl.get_active_window()
    if w and w.group then hl.dispatch(hl.dsp.group.toggle()) end
end

-- Take the focused window out of its tab strip and give it a pane on the named
-- side. nary has to be told which side first: Hyprland's own hint for this (the
-- focal point handed to movedTarget) is discarded by the Lua layout API, so
-- without the message the pane is merely adopted wherever the tree puts it.
local DIR_SHORT = { left = "l", right = "r", up = "u", down = "d" }

local function untab(dir)
    local w = hl.get_active_window()
    if not (w and w.group and w.group.size > 1) then return false end

    hl.dispatch(hl.dsp.layout("untab " .. DIR_SHORT[dir]))
    hl.dispatch(hl.dsp.window.move({ out_of_group = dir }))
    dissolve_lone_groups() -- the tile it left may now be a group of one
    return true
end


-----------------------------------
---- EXPOSE  (mission control) ----
-----------------------------------
-- F1 unfolds every tabbed group on the workspace into panes, so all of
-- them can be seen at once. The next window SELECTED — clicked, or
-- focused any other way — folds them all back exactly as they were, except that
-- one, which is left out as a pane of its own if it used to be a tab. Pressing
-- the key again folds with whatever is focused, for selecting without a click.
--
-- Selection is a focus change, so the unfolding's own focus churn (dissolving a
-- group refocuses) has to be kept out of it: dispatches made here are flagged,
-- and the listener only arms once the unfold has settled.
--
-- Hyprland cannot build a group from a list of windows: the only way in is
-- moveintogroup, which merges whatever lies in a DIRECTION. So folding back
-- sends each pane leftwards at the tab that stayed behind, which works only
-- because unfolding asked the layout to lay each set of tabs out as a row in
-- tab order, starting from that tab (nary's `explode`).
--
-- The selected pane is folded back in with the others and then taken out again
-- by the ordinary un-tab path, rather than being left out of the fold: sitting
-- between panes that are still merging leftwards, it would swallow them.

local exposed = nil   -- while unfolded: the groups to put back
local armed   = false -- is a focus change a selection yet?
local busy    = false -- ... or is it one of ours?

local function tabbed_groups()
    local ws = hl.get_active_workspace()
    local seen, groups = {}, {}

    for _, w in ipairs(hl.get_windows() or {}) do
        local group = w.group
        if group and group.size > 1 and group.current and ws and w.workspace and w.workspace.id == ws.id then
            local anchor = group.current
            local key    = tostring(anchor.stable_id)

            if not seen[key] then
                seen[key] = true

                local members = group.members
                if members and members.stable_id then members = { members } end

                -- In group order, minus the visible tab: exactly the windows
                -- `explode` lays out beside it, in the same order.
                local rest = {}
                for _, m in ipairs(members or {}) do
                    if m.stable_id and m.stable_id ~= anchor.stable_id then rest[#rest + 1] = m end
                end

                groups[#groups + 1] = { anchor = anchor, rest = rest }
            end
        end
    end
    return groups
end

local function expose_unfold()
    local groups = tabbed_groups()
    if #groups == 0 then return end

    busy = true
    hl.dispatch(hl.dsp.layout("explode"))
    for _, group in ipairs(groups) do
        hl.dispatch(hl.dsp.group.toggle({ window = group.anchor }))
    end
    busy = false

    exposed, armed = groups, false
    hl.timer(function() armed = (exposed ~= nil) end, { timeout = 120, type = "oneshot" })
end

local function expose_fold()
    local selected     = hl.get_active_window()
    local groups       = exposed
    exposed, armed     = nil, false

    busy = true
    for _, group in ipairs(groups) do
        for _, w in ipairs(group.rest) do
            -- An expired window (closed while unfolded) reads as nil throughout.
            if w.mapped then
                hl.dispatch(hl.dsp.window.move({ window = w, into_or_create_group = "left" }))
            end
        end
        if group.anchor.mapped then
            hl.dispatch(hl.dsp.focus({ window = group.anchor })) -- restore the visible tab
        end
    end

    -- The selection: back out of the strip it was just folded into. It is
    -- folded in with the rest and taken out again rather than being held aside,
    -- because a pane left sitting among panes still merging leftwards would
    -- swallow them.
    if selected and selected.mapped then
        hl.dispatch(hl.dsp.focus({ window = selected }))
        untab("right")
    end
    busy = false

    dissolve_lone_groups()
end

-- Any focus change once unfolded IS the selection.
hl.on("window.active", function()
    if exposed and armed and not busy then expose_fold() end
end)

local function expose_toggle()
    if exposed then expose_fold() else expose_unfold() end
end

