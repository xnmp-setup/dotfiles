    class = "google-chrome",
    cmd   = "google-chrome-stable --new-window",
    w     = 1800, h = 1100,
})
scratchpad.define("ytmusic", {
    class = "YouTube Music Desktop App",
    cmd   = "youtube-music-desktop-app",
    w     = 1400, h = 900,
})
-- Drops from the top of the built-in panel, sized as a share of it, so the same
-- definition holds on the laptop alone and with an external display attached.
scratchpad.define("ghostty-drop", {
    class = "com.mitchellh.ghostty",
    cmd   = "ghostty",
    w     = 0.8, h = 0.7, max_w = 1600,
