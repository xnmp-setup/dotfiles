#!/bin/bash
# clip2path - smart paste: clipboard images become file paths in supported
# terminals (Ghostty, WezTerm), passthrough elsewhere

ACTIVE=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')

case "$ACTIVE" in
    com.mitchellh.ghostty|org.wezfurlong.wezterm) ;;  # smart-paste terminals
    *)
        # Elsewhere — replay plain ctrl+v via ydotool. NOT ctrl+shift+v: that
        # would re-trigger this very Hyprland bind and loop.
        ydotool key 29:1 47:1 47:0 29:0  # ctrl+v
        exit 0
        ;;
esac

MIME=$(wl-paste --list-types 2>/dev/null | grep -m1 '^image/')

if [[ -n "$MIME" ]]; then
    EXT="${MIME#image/}"
    FILE="/tmp/clipboard-$(date +%Y%m%d_%H%M%S).${EXT}"
    wl-paste --type "$MIME" > "$FILE" 2>/dev/null
    if [[ -s "$FILE" ]]; then
        wtype -- "$FILE"
    fi
else
    # Text clipboard — paste via wtype
    TEXT=$(wl-paste 2>/dev/null)
    if [[ -n "$TEXT" ]]; then
        wtype -- "$TEXT"
    fi
fi
