# Assemble lig's config from the managed base and the generated colours.
# Sourced from the top of .zshrc, before `lig init zsh pre` re-execs the shell.
#
# lig reads only ~/.config/lig/config.toml and has no include directive, so
# config.toml (generated, unmanaged by chezmoi) = base.toml (chezmoi) +
# colors.toml (set-theme, from the terminal theme; scripts/lib/lig-theme.sh).
# Rebuilt only when a source is newer than config.toml, so a shell start costs
# a few stat calls. Without colors.toml, config.toml is a copy of base.toml and
# lig uses its ANSI `terminal` theme. Without base.toml nothing is touched.
# A config built before colors.toml vanished (set-theme failed) is rebuilt as
# plain base.
#
# lig rejects a config with an option it doesn't know, wholesale. Options in
# base.toml newer than some lig releases (see `newer_options`) are dropped when
# `lig config` (its defaults, every option) doesn't list them. The lig binary
# ($_lig_bin from .zshrc, else the one on PATH) is a source too, so upgrading
# lig rebuilds the config.

() {
  local dir=${XDG_CONFIG_HOME:-$HOME/.config}/lig
  local base=$dir/base.toml colors=$dir/colors.toml config=$dir/config.toml
  local marker='# Generated by lig-theme.zsh'
  local -a newer_options=(enter_runs_commands)
  local lig=${_lig_bin:-${commands[lig]:-}}
  # Nothing to build from, or nowhere to write it (lig then reads what's there).
  [[ -r $base && -w $dir ]] || return 0

  # The header names what the config was built from: whether colours were in
  # it, and which lig binary (symlinks resolved: a Nix or Homebrew upgrade
  # changes the path, not the mtime). Any difference, or a newer source,
  # rebuilds it.
  local header=$marker
  [[ -r $colors ]] && header+=' (with colors)'
  header+=" for ${lig:A}; edit base.toml, not this file."
  local first
  [[ -r $config ]] && IFS= read -r first < $config
  if [[ $first == "$header" && $config -nt $base ]] \
      && [[ ! -r $colors || $config -nt $colors ]] \
      && [[ -z $lig || ! $lig -nt $config ]]; then
    return 0
  fi

  local -a lines=("${(@f)$(<$base)}")
  if [[ -n $lig ]]; then
    local known=$("$lig" config 2>/dev/null) opt
    for opt in $newer_options; do
      [[ $known == *$'\n'"$opt ="* ]] || lines=("${(@)lines:#${opt}[ =]*}")
    done
  fi

  local tmp=$config.$$
  {
    print -r -- "$header"
    print -rl -- "${lines[@]}"
    if [[ -r $colors ]]; then print; print -r -- "$(<$colors)"; fi
  } >| $tmp 2>/dev/null && mv -f -- $tmp $config 2>/dev/null || rm -f -- $tmp
  return 0
}
