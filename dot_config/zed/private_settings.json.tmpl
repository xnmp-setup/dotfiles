{{- $desktopTheme := includeTemplate "current-theme.json.tmpl" . | fromJson -}}
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "file_scan_inclusions": ["*"],
   "file_scan_exclusions": [
       ".git",
       "node_modules",
       "__pycache__",
       ".venv",
       ".mypy_cache",
       ".pytest_cache",
       ".ruff_cache",
       "dist",
       "build",
       ".next",
       ".nuxt",
       "target",
       "*.pyc"
   ],

    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },
    "edit_predictions": {
              "open_ai_compatible_api": {
                   "model": "@bedrock-eus1/us.anthropic.claude-haiku-4-5-20251001-v1:0",
                   "api_url": "https://portkey.aipe.cba"
              },
              "provider": "open_ai_compatible_api"
            },
    
    "agent_buffer_font_size": 17,
    "agent_ui_font_size": 18,
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "format_on_save": "off",
    "git_panel": {
        "tree_view": true,
        "dock": "left",
    },
    "project_panel": {
        "dock": "left",
        "hide_gitignore": true,
        "hide_root": true,
    },
    "status_bar": {
        "experimental.show": false,
    },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false,
        "agent_review": false,
        "code_actions": false,
    },
    "show_edit_predictions": true,
    "remove_trailing_whitespace_on_save": false,
    "soft_wrap": "none",
    "tab_size": 4,
    "tabs": {
        "show_close_button": "hidden",
        "file_icons": true,
        "git_status": true,
    },
    "autosave": "off",
    "auto_update": false,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "gutter": {
        "line_numbers": true,
        "folds": false,
        "min_line_number_digits": 1,
        "runnables": false,
        "breakpoints": false,
        "bookmarks": false,
    },
    "cursor_blink": true,
    "terminal": {
        "font_size": 15,
        "font_family": "Hack Nerd Font",
        "shell": "system",
    },
    "sticky_scroll": { "enabled": true },
    "agent": {
        "dock": "right",
        "model_parameters": [],
        "default_model": {
            "provider": "openai",
            "model": "anthropic/claude-3.7-sonnet",
        },
    },
    "title_bar": {
        "show_sign_in": false,
        "show_user_menu": false,
    },
    "vim_mode": false,
    "base_keymap": "VSCode",
    "ui_font_family": "Inter",
    "ui_font_size": 15,
    "buffer_font_family": "Cascadia Code",
    "buffer_font_weight": 450,
    "buffer_font_size": 16,
    "theme": {
        "mode": {{ $desktopTheme.mode | toJson }},
        "light": {{ $desktopTheme.title | toJson }},
        "dark": {{ $desktopTheme.title | toJson }},
    },
    "git": {
        "inline_blame": {
            "enabled": false
        }
    },
    "languages": {
        "Python": {
            "language_servers": ["pyrefly", "!pyright", "!pylsp", "!ruff"]
        }
    },
    "language_models": {
        "openai": {
            "api_url": "https://openrouter.ai/api/v1",
            "available_models": [
                {
                    "display_name": "Claude 3.7 Sonnet",
                    "name": "anthropic/claude-3.7-sonnet",
                    "max_tokens": 131072,
                },
            ],
        },
    },
}
