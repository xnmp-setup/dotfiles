        "terminal.foreground": "#223d50ff",
        "terminal.ansi.black": "#223d50ff",
        "terminal.ansi.red": "#b45343ff",
        "terminal.ansi.green": "#187c70ff",
        "terminal.ansi.yellow": "#8b691eff",
        "terminal.ansi.blue": "#3768acff",
        "terminal.ansi.magenta": "#af3e79ff",
        "terminal.ansi.cyan": "#14758fff",
        "terminal.ansi.white": "#526f80ff",
        "terminal.ansi.bright_black": "#526f80ff",
        "terminal.ansi.bright_red": "#a8433fff",
        "terminal.ansi.bright_green": "#14776bff",
        "terminal.ansi.bright_yellow": "#84651dff",
        "terminal.ansi.bright_blue": "#3568a5ff",
        "terminal.ansi.bright_magenta": "#9d396cff",
