            "color": "#3768acff"
          },
          "keyword": {
            "color": "#187c70ff"
          },
          "number": {
            "color": "#8b691eff"
          },
          "operator": {
            "color": "#526f80ff"
          },
          "property": {
            "color": "#9d396cff"
          },
          "string": {
            "color": "#14758fff"
          },
          "type": {
            "color": "#af3e79ff"
          },
          "variable": {
            "color": "#223d50ff"
          }
