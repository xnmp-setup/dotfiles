[Unit]
Description=Local wake-phrase detector for the dedicated Codex Global voice session
After=pipewire.service codex-global-voice.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60
ExecStart=%h/.local/share/codex-global-wake/venv/bin/python %h/.local/bin/codex-global-wake
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077
Nice=10
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false

[Install]
WantedBy=default.target
