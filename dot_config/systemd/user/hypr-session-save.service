[Unit]
Description=Save Hyprland session on shutdown/logout
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# The snapshot is also refreshed every 30s by session_restore.lua's timer, so
# this is the final save rather than the only one: a crash or a power cut costs
# the last half-minute of window arrangement, not the whole session.
#
# `hyprctl dispatch` evaluates its argument as Lua in the config's environment
# and wraps it as `return hl.dispatch(<arg>)`, which is why session.save()
# hands back a dispatcher of its own.
ExecStop=hyprctl dispatch "session.save()"
# If Hyprland has already exited, hyprctl cannot reach it. Fail fast rather
# than hold up the rest of the logout — the 30s timer means the snapshot is at
# most half a minute old anyway.
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
