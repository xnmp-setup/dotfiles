{{- $desktopTheme := includeTemplate "current-theme.json.tmpl" . | fromJson -}}
// Managed by chezmoi. Vicinae may rewrite this file after GUI changes; merge useful
// non-theme changes back into this source template instead of replacing it wholesale.
//
// Templated because .desktop files live in different places per distro: Arch uses
// /usr/share/applications, NixOS exposes them via /run/current-system/sw and the user
// profile. A literal copy leaves the launcher showing no system apps on NixOS.
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "theme": {
      "light": {
         "name": {{ $desktopTheme.vicinae_light | toJson }}
      },
      "dark": {
         "name": {{ $desktopTheme.vicinae_dark | toJson }}
      }
   },
   "providers": {
      "applications": {
         "preferences": {
            "paths": [
               "{{ .chezmoi.homeDir }}/.local/share/applications",
{{- if eq .chezmoi.osRelease.id "nixos" }}
               "/run/current-system/sw/share/applications",
               "{{ .chezmoi.homeDir }}/.nix-profile/share/applications"
{{- else }}
               "/usr/share/applications"
{{- end }}
            ]
         }
      }
   }
}
