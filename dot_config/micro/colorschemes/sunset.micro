# Sunset palette.
color-link default "#ffffff,#070605"
color-link comment "#969596,#070605"
color-link identifier "#ffffff,#070605"
color-link constant "#efd5b4,#070605"
color-link constant.string "#f7ce6e,#070605"
color-link constant.string.char "#f7ce6e,#070605"
color-link constant.number "#efd5b4,#070605"
color-link constant.bool "#efd5b4,#070605"
color-link statement "#ebd2a4,#070605"
color-link symbol.operator "#f1e8e0,#070605"
color-link symbol.brackets "#ffffff,#070605"
color-link symbol.tag "#d0b59b,#070605"
color-link preproc "#b2a295,#070605"
color-link type "#fce7b0,#070605"
color-link type.keyword "#fce7b0,#070605"
color-link special "#ffffff,#070605"
color-link underlined "#efd5b4,#070605"
color-link error "bold #efd5b4,#070605"
color-link todo "bold #ddd6d0,#070605"
color-link statusline "#ffffff,#211a14"
color-link statusline.inactive "#969596,#070605"
color-link statusline.suggestions "#070605,#ffffff"
color-link tabbar "#969596,#070605"
color-link tabbar.active "#ffffff,#211a14"
color-link indent-char "#302519,#070605"
color-link line-number "#969596,#070605"
color-link current-line-number "#ffffff,#070605"
color-link cursor-line "#211a14"
color-link color-column "#211a14"
color-link divider "#969596"
color-link scrollbar "#969596"
color-link selection "#ffffff,#302519"
color-link hlsearch "#070605,#ddd6d0"
color-link match-brace "#070605,#ffffff"
color-link diff-added "#f7ce6e"
color-link diff-modified "#d0b59b"
color-link diff-deleted "#efd5b4"
color-link gutter-error "#efd5b4,#070605"
color-link gutter-warning "#b2a295,#070605"
color-link gutter-info "#ffffff,#070605"
color-link tab-error "#efd5b4"
color-link trailingws "#efd5b4"
color-link message "#ffffff"
color-link error-message "bold #efd5b4"
