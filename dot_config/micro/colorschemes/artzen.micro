# Artzen palette.
color-link default "#fdf9f8,#181c1f"
color-link comment "#b18d85,#181c1f"
color-link identifier "#fdf9f8,#181c1f"
color-link constant "#ca887f,#181c1f"
color-link constant.string "#9f6769,#181c1f"
color-link constant.string.char "#9f6769,#181c1f"
color-link constant.number "#ca887f,#181c1f"
color-link constant.bool "#ca887f,#181c1f"
color-link statement "#9a8c8a,#181c1f"
color-link symbol.operator "#d7b2ae,#181c1f"
color-link symbol.brackets "#fdf9f8,#181c1f"
color-link symbol.tag "#b97670,#181c1f"
color-link preproc "#bb6d6c,#181c1f"
color-link type "#da7a6f,#181c1f"
color-link type.keyword "#da7a6f,#181c1f"
color-link special "#ecbeb9,#181c1f"
color-link underlined "#ca887f,#181c1f"
color-link error "bold #ca887f,#181c1f"
color-link todo "bold #d7adad,#181c1f"
color-link statusline "#fdf9f8,#2b2728"
color-link statusline.inactive "#b18d85,#181c1f"
color-link statusline.suggestions "#181c1f,#ecbeb9"
color-link tabbar "#b18d85,#181c1f"
color-link tabbar.active "#fdf9f8,#2b2728"
color-link indent-char "#3b2b2c,#181c1f"
color-link line-number "#b18d85,#181c1f"
color-link current-line-number "#fdf9f8,#181c1f"
color-link cursor-line "#2b2728"
color-link color-column "#2b2728"
color-link divider "#b18d85"
color-link scrollbar "#b18d85"
color-link selection "#fdf9f8,#3b2b2c"
color-link hlsearch "#181c1f,#d7adad"
color-link match-brace "#181c1f,#ecbeb9"
color-link diff-added "#9f6769"
color-link diff-modified "#b97670"
color-link diff-deleted "#ca887f"
color-link gutter-error "#ca887f,#181c1f"
color-link gutter-warning "#bb6d6c,#181c1f"
color-link gutter-info "#ecbeb9,#181c1f"
color-link tab-error "#ca887f"
color-link trailingws "#ca887f"
color-link message "#ecbeb9"
color-link error-message "bold #ca887f"
