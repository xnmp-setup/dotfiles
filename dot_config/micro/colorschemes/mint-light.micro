# Mint Light palette.
color-link default "#3b413c,#f6fff8"
color-link comment "#62766d,#f6fff8"
color-link identifier "#3b413c,#f6fff8"
color-link constant "#b05a22,#f6fff8"
color-link constant.string "#3a8236,#f6fff8"
color-link constant.string.char "#3a8236,#f6fff8"
color-link constant.number "#b05a22,#f6fff8"
color-link constant.bool "#b05a22,#f6fff8"
color-link statement "#93599f,#f6fff8"
color-link symbol.operator "#5f6e67,#f6fff8"
color-link symbol.brackets "#3b413c,#f6fff8"
color-link symbol.tag "#c24e36,#f6fff8"
color-link preproc "#93599f,#f6fff8"
color-link type "#8f6d05,#f6fff8"
color-link type.keyword "#93599f,#f6fff8"
color-link special "#137985,#f6fff8"
color-link underlined "#c24e36,#f6fff8"
color-link error "bold #c24e36,#f6fff8"
color-link todo "bold #b05a22,#f6fff8"
color-link statusline "#3b413c,#eaf7ef"
color-link statusline.inactive "#62766d,#f6fff8"
color-link statusline.suggestions "#f6fff8,#1c8564"
color-link tabbar "#62766d,#f6fff8"
color-link tabbar.active "#3b413c,#eaf7ef"
color-link indent-char "#cdefdd,#f6fff8"
color-link line-number "#62766d,#f6fff8"
color-link current-line-number "#3b413c,#f6fff8"
color-link cursor-line "#eaf7ef"
color-link color-column "#eaf7ef"
color-link divider "#c3ded0"
color-link scrollbar "#c3ded0"
color-link selection "#3b413c,#cdefdd"
color-link hlsearch "#3b413c,#f2dfa8"
color-link match-brace "#f6fff8,#1c8564"
color-link diff-added "#3a8236"
color-link diff-modified "#b05a22"
color-link diff-deleted "#c24e36"
color-link gutter-error "#c24e36,#f6fff8"
color-link gutter-warning "#b05a22,#f6fff8"
color-link gutter-info "#2d75a0,#f6fff8"
color-link tab-error "#c24e36"
color-link trailingws "#c24e36"
color-link message "#3b413c"
color-link error-message "bold #c24e36"
