# Mint Light palette.
color-link default "#3b413c,#f6fff8"
color-link comment "#8a9a92,#f6fff8"
color-link identifier "#3b413c,#f6fff8"
color-link constant "#c07a3e,#f6fff8"
color-link constant.string "#2fa893,#f6fff8"
color-link constant.string.char "#2fa893,#f6fff8"
color-link constant.number "#c07a3e,#f6fff8"
color-link constant.bool "#c07a3e,#f6fff8"
color-link statement "#9b6fa8,#f6fff8"
color-link symbol.operator "#5f6e67,#f6fff8"
color-link symbol.brackets "#3b413c,#f6fff8"
color-link symbol.tag "#2e9c79,#f6fff8"
color-link preproc "#c07a3e,#f6fff8"
color-link type "#9b6fa8,#f6fff8"
color-link type.keyword "#9b6fa8,#f6fff8"
color-link special "#2fa893,#f6fff8"
color-link underlined "#d0644a,#f6fff8"
color-link error "bold #d0644a,#f6fff8"
color-link todo "bold #c07a3e,#f6fff8"
color-link statusline "#3b413c,#eaf7ef"
color-link statusline.inactive "#8a9a92,#f6fff8"
color-link statusline.suggestions "#f6fff8,#2e9c79"
color-link tabbar "#8a9a92,#f6fff8"
color-link tabbar.active "#3b413c,#eaf7ef"
color-link indent-char "#cdefdd,#f6fff8"
color-link line-number "#8a9a92,#f6fff8"
color-link current-line-number "#3b413c,#f6fff8"
color-link cursor-line "#eaf7ef"
color-link color-column "#eaf7ef"
color-link divider "#c3ded0"
color-link scrollbar "#c3ded0"
color-link selection "#3b413c,#cdefdd"
color-link hlsearch "#f6fff8,#c07a3e"
color-link match-brace "#f6fff8,#2e9c79"
color-link diff-added "#3e9b78"
color-link diff-modified "#2fa893"
color-link diff-deleted "#d0644a"
color-link gutter-error "#d0644a,#f6fff8"
color-link gutter-warning "#c07a3e,#f6fff8"
color-link gutter-info "#2fa893,#f6fff8"
color-link tab-error "#d0644a"
color-link trailingws "#d0644a"
color-link message "#2fa893"
color-link error-message "bold #d0644a"
