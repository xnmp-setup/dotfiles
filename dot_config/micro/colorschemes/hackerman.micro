# Omarchy Hackerman palette.
color-link default "#ddf7ff,#0b0c16"
color-link comment "#6a6e95,#0b0c16"
color-link identifier "#ddf7ff,#0b0c16"
color-link constant "#50f7a3,#0b0c16"
color-link constant.string "#4fe88f,#0b0c16"
color-link constant.string.char "#4fe88f,#0b0c16"
color-link constant.number "#50f7a3,#0b0c16"
color-link constant.bool "#50f7a3,#0b0c16"
color-link statement "#86a7df,#0b0c16"
color-link symbol.operator "#a4ffec,#0b0c16"
color-link symbol.brackets "#ddf7ff,#0b0c16"
color-link symbol.tag "#829dd4,#0b0c16"
color-link preproc "#50f7d4,#0b0c16"
color-link type "#7cf8f7,#0b0c16"
color-link type.keyword "#7cf8f7,#0b0c16"
color-link special "#d1fffe,#0b0c16"
color-link underlined "#85ff9d,#0b0c16"
color-link error "bold #85ff9d,#0b0c16"
color-link todo "bold #a4ffec,#0b0c16"
color-link statusline "#ddf7ff,#151828"
color-link statusline.inactive "#6a6e95,#0b0c16"
color-link statusline.suggestions "#0b0c16,#82fb9c"
color-link tabbar "#6a6e95,#0b0c16"
color-link tabbar.active "#ddf7ff,#151828"
color-link indent-char "#1f253a,#0b0c16"
color-link line-number "#6a6e95,#0b0c16"
color-link current-line-number "#ddf7ff,#0b0c16"
color-link cursor-line "#151828"
color-link color-column "#151828"
color-link divider "#2d3450"
color-link scrollbar "#2d3450"
color-link selection "#ddf7ff,#1f253a"
color-link hlsearch "#0b0c16,#82fb9c"
color-link match-brace "#0b0c16,#7cf8f7"
color-link diff-added "#4fe88f"
color-link diff-modified "#7cf8f7"
color-link diff-deleted "#85ff9d"
color-link gutter-error "#85ff9d,#0b0c16"
color-link gutter-warning "#50f7d4,#0b0c16"
color-link gutter-info "#7cf8f7,#0b0c16"
color-link tab-error "#85ff9d"
color-link trailingws "#85ff9d"
color-link message "#7cf8f7"
color-link error-message "bold #85ff9d"
