# Sakura palette.
color-link default "#f0eaed,#0d0509"
color-link comment "#c6afba,#0d0509"
color-link identifier "#f0eaed,#0d0509"
color-link constant "#ff8e7c,#0d0509"
color-link constant.string "#f29b9a,#0d0509"
color-link constant.string.char "#f29b9a,#0d0509"
color-link constant.number "#ff8e7c,#0d0509"
color-link constant.bool "#ff8e7c,#0d0509"
color-link statement "#d1b399,#0d0509"
color-link symbol.operator "#ebb97e,#0d0509"
color-link symbol.brackets "#f0eaed,#0d0509"
color-link symbol.tag "#d9a56c,#0d0509"
color-link preproc "#d4a882,#0d0509"
color-link type "#e8c099,#0d0509"
color-link type.keyword "#e8c099,#0d0509"
color-link special "#fbd2ab,#0d0509"
color-link underlined "#ff7a8a,#0d0509"
color-link error "bold #ff7a8a,#0d0509"
color-link todo "bold #e6ba94,#0d0509"
color-link statusline "#f0eaed,#230e18"
color-link statusline.inactive "#c6afba,#0d0509"
color-link statusline.suggestions "#0d0509,#fbd2ab"
color-link tabbar "#c6afba,#0d0509"
color-link tabbar.active "#f0eaed,#230e18"
color-link indent-char "#230e18,#0d0509"
color-link line-number "#c6afba,#0d0509"
color-link current-line-number "#f0eaed,#0d0509"
color-link cursor-line "#230e18"
color-link color-column "#230e18"
color-link divider "#7a5c66"
color-link scrollbar "#7a5c66"
color-link selection "#f0eaed,#230e18"
color-link hlsearch "#0d0509,#e6ba94"
color-link match-brace "#0d0509,#fbd2ab"
color-link diff-added "#f29b9a"
color-link diff-modified "#d9a56c"
color-link diff-deleted "#ff7a8a"
color-link gutter-error "#ff7a8a,#0d0509"
color-link gutter-warning "#d4a882,#0d0509"
color-link gutter-info "#fbd2ab,#0d0509"
color-link tab-error "#ff7a8a"
color-link trailingws "#ff7a8a"
color-link message "#fbd2ab"
color-link error-message "bold #ff7a8a"
