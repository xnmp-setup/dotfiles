# Cosmic Dusk - ported from Ghostty's Cosmic Dusk terminal theme
# Deep space blues with rose, cyan, green, and yellow accents

# Syntax highlighting
color-link default "#d8dce8,#0e1330"
color-link comment "#3a4070,#0e1330"
color-link identifier "#8ac0e0,#0e1330"
color-link constant "#d4607a,#0e1330"
color-link constant.string "#69db7c,#0e1330"
color-link constant.string.char "#69db7c,#0e1330"
color-link constant.number "#fbbf24,#0e1330"
color-link constant.bool "#d4607a,#0e1330"
color-link statement "#6a7acc,#0e1330"
color-link symbol.operator "#8890a8,#0e1330"
color-link symbol.brackets "#d8dce8,#0e1330"
color-link symbol.tag "#7a8ae0,#0e1330"
color-link preproc "#ffd43b,#0e1330"
color-link type "#b09ac0,#0e1330"
color-link type.keyword "#b09ac0,#0e1330"
color-link type.extended "default"
color-link special "#7a8ae0,#0e1330"
color-link underlined "#d4607a,#0e1330"
color-link error "bold #d4607a,#0e1330"
color-link todo "bold #fbbf24,#0e1330"

# UI elements
color-link statusline "#d8dce8,#161b40"
color-link statusline.inactive "#5a6088,#0c1024"
color-link statusline.suggestions "#0e1330,#8ac0e0"
color-link tabbar "#5a6088,#0c1024"
color-link tabbar.active "#d8dce8,#161b40"
color-link indent-char "#2a3060,#0e1330"
color-link line-number "#5a6088,#0e1330"
color-link current-line-number "#d8dce8,#0e1330"
color-link cursor-line "#161b40"
color-link color-column "#161b40"
color-link divider "#2a3060"
color-link scrollbar "#2a3060"

# Visual indicators
color-link selection "#d8dce8,#2a3060"
color-link hlsearch "#0e1330,#8ac0e0"
color-link match-brace "#0e1330,#7a8ae0"
color-link diff-added "#69db7c"
color-link diff-modified "#7a8ae0"
color-link diff-deleted "#d4607a"
color-link gutter-error "#d4607a,#0e1330"
color-link gutter-warning "#fbbf24,#0e1330"
color-link gutter-info "#7a8ae0,#0e1330"
color-link tab-error "#d4607a"
color-link trailingws "#d4607a"
color-link message "#8ac0e0"
color-link error-message "bold #d4607a"
