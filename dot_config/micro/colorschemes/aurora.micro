# Aurora palette.
color-link default "#e2e8f0,#0d1117"
color-link comment "#6b7a90,#0d1117"
color-link identifier "#e2e8f0,#0d1117"
color-link constant "#fbbf24,#0d1117"
color-link constant.string "#4ade80,#0d1117"
color-link constant.string.char "#4ade80,#0d1117"
color-link constant.number "#fbbf24,#0d1117"
color-link constant.bool "#fbbf24,#0d1117"
color-link statement "#c084fc,#0d1117"
color-link symbol.operator "#94a3b8,#0d1117"
color-link symbol.brackets "#94a3b8,#0d1117"
color-link symbol.tag "#5de5d5,#0d1117"
color-link preproc "#fbbf24,#0d1117"
color-link type "#7eeee0,#0d1117"
color-link type.keyword "#7eeee0,#0d1117"
color-link special "#5de5d5,#0d1117"
color-link underlined "#f87171,#0d1117"
color-link error "bold #f87171,#0d1117"
color-link todo "bold #fbbf24,#0d1117"
color-link statusline "#e2e8f0,#161b22"
color-link statusline.inactive "#6b7a90,#0d1117"
color-link statusline.suggestions "#0d1117,#5de5d5"
color-link tabbar "#6b7a90,#0d1117"
color-link tabbar.active "#e2e8f0,#161b22"
color-link indent-char "#26303b,#0d1117"
color-link line-number "#6b7a90,#0d1117"
color-link current-line-number "#e2e8f0,#0d1117"
color-link cursor-line "#161b22"
color-link color-column "#161b22"
color-link divider "#26303b"
color-link scrollbar "#26303b"
color-link selection "#e2e8f0,#1f3a3d"
color-link hlsearch "#0d1117,#fbbf24"
color-link match-brace "#0d1117,#5de5d5"
color-link diff-added "#4ade80"
color-link diff-modified "#60a5fa"
color-link diff-deleted "#f87171"
color-link gutter-error "#f87171,#0d1117"
color-link gutter-warning "#fbbf24,#0d1117"
color-link gutter-info "#5de5d5,#0d1117"
color-link tab-error "#f87171"
color-link trailingws "#f87171"
color-link message "#5de5d5"
color-link error-message "bold #f87171"
