# Everforest Light Medium palette (sainnhe/everforest).
color-link default "#5c6a72,#fdf6e3"
color-link comment "#939f91,#fdf6e3"
color-link identifier "#5c6a72,#fdf6e3"
color-link constant "#df69ba,#fdf6e3"
color-link constant.string "#8da101,#fdf6e3"
color-link constant.string.char "#8da101,#fdf6e3"
color-link constant.number "#df69ba,#fdf6e3"
color-link constant.bool "#df69ba,#fdf6e3"
color-link statement "#f85552,#fdf6e3"
color-link symbol.operator "#f57d26,#fdf6e3"
color-link symbol.brackets "#5c6a72,#fdf6e3"
color-link symbol.tag "#f57d26,#fdf6e3"
color-link preproc "#df69ba,#fdf6e3"
color-link type "#dfa000,#fdf6e3"
color-link type.keyword "#f57d26,#fdf6e3"
color-link special "#35a77c,#fdf6e3"
color-link underlined "#3a94c5,#fdf6e3"
color-link error "bold #f85552,#fdf6e3"
color-link todo "bold #dfa000,#fdf6e3"
color-link statusline "#5c6a72,#f4f0d9"
color-link statusline.inactive "#939f91,#fdf6e3"
color-link statusline.suggestions "#fdf6e3,#93b259"
color-link tabbar "#939f91,#efebd4"
color-link tabbar.active "#5c6a72,#fdf6e3"
color-link indent-char "#e0dcc7,#fdf6e3"
color-link line-number "#a6b0a0,#fdf6e3"
color-link current-line-number "#829181,#fdf6e3"
color-link cursor-line "#f4f0d9"
color-link color-column "#f4f0d9"
color-link divider "#e0dcc7"
color-link scrollbar "#bdc3af"
color-link selection "#5c6a72,#eaedc8"
color-link hlsearch "#fdf6e3,#93b259"
color-link match-brace "#fdf6e3,#35a77c"
color-link diff-added "#8da101"
color-link diff-modified "#3a94c5"
color-link diff-deleted "#f85552"
color-link gutter-error "#f85552,#fdf6e3"
color-link gutter-warning "#dfa000,#fdf6e3"
color-link gutter-info "#3a94c5,#fdf6e3"
color-link tab-error "#f85552"
color-link trailingws "#f85552"
color-link message "#35a77c"
color-link error-message "bold #f85552"
