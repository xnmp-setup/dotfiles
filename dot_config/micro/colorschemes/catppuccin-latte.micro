color-link line-number "#6c6f85,#eff1f5"
color-link current-line-number "#4c4f69,#eff1f5"
color-link cursor-line "#e6e9ef"
color-link color-column "#e6e9ef"
color-link divider "#bcc0cc"
color-link scrollbar "#bcc0cc"
color-link selection "#4c4f69,#ccd0da"
color-link hlsearch "#4c4f69,#df8e1d"
color-link match-brace "#eff1f5,#8839ef"
color-link diff-added "#40a02b"
color-link diff-modified "#179299"
color-link diff-deleted "#d20f39"
