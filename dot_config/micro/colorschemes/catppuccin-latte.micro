color-link constant "#fe640b,#eff1f5"
color-link constant.string "#40a02b,#eff1f5"
color-link constant.string.char "#40a02b,#eff1f5"
color-link constant.number "#fe640b,#eff1f5"
color-link constant.bool "#fe640b,#eff1f5"
color-link statement "#8839ef,#eff1f5"
color-link symbol.operator "#1e66f5,#eff1f5"
color-link symbol.brackets "#4c4f69,#eff1f5"
color-link symbol.tag "#1e66f5,#eff1f5"
color-link preproc "#df8e1d,#eff1f5"
color-link type "#179299,#eff1f5"
color-link type.keyword "#179299,#eff1f5"
color-link special "#179299,#eff1f5"
color-link underlined "#d20f39,#eff1f5"
color-link error "bold #d20f39,#eff1f5"
color-link todo "bold #df8e1d,#eff1f5"
