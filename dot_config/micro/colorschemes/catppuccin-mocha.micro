# Catppuccin Mocha - ported from the canonical Catppuccin Mocha palette
# Deep blue-grey/purple base with soft mauve accent, blue/yellow/green syntax colors

# Syntax highlighting
color-link default "#cdd6f4,#1e1e2e"
color-link comment "#6c7086,#1e1e2e"
color-link identifier "#89b4fa,#1e1e2e"
color-link constant "#fab387,#1e1e2e"
color-link constant.string "#a6e3a1,#1e1e2e"
color-link constant.string.char "#a6e3a1,#1e1e2e"
color-link constant.number "#fab387,#1e1e2e"
color-link constant.bool "#fab387,#1e1e2e"
color-link statement "#cba6f7,#1e1e2e"
color-link symbol.operator "#89dceb,#1e1e2e"
color-link symbol.brackets "#cdd6f4,#1e1e2e"
color-link symbol.tag "#89b4fa,#1e1e2e"
color-link preproc "#f9e2af,#1e1e2e"
color-link type "#f9e2af,#1e1e2e"
color-link type.keyword "#f9e2af,#1e1e2e"
color-link type.extended "default"
color-link special "#89b4fa,#1e1e2e"
color-link underlined "#cba6f7,#1e1e2e"
color-link error "bold #f38ba8,#1e1e2e"
color-link todo "bold #cba6f7,#1e1e2e"

# UI elements
color-link statusline "#cdd6f4,#313244"
color-link statusline.inactive "#7f849c,#11111b"
color-link statusline.suggestions "#1e1e2e,#89b4fa"
color-link tabbar "#7f849c,#11111b"
color-link tabbar.active "#cdd6f4,#313244"
color-link indent-char "#45475a,#1e1e2e"
color-link line-number "#6c7086,#1e1e2e"
color-link current-line-number "#cdd6f4,#1e1e2e"
color-link cursor-line "#313244"
color-link color-column "#313244"
color-link divider "#45475a"
color-link scrollbar "#45475a"

# Visual indicators
color-link selection "#cdd6f4,#575971"
color-link hlsearch "#1e1e2e,#89b4fa"
color-link match-brace "#1e1e2e,#89b4fa"
color-link diff-added "#a6e3a1"
color-link diff-modified "#89b4fa"
color-link diff-deleted "#eba0ac"
color-link gutter-error "#f38ba8,#1e1e2e"
color-link gutter-warning "#cba6f7,#1e1e2e"
color-link gutter-info "#89b4fa,#1e1e2e"
color-link tab-error "#f38ba8"
color-link trailingws "#eba0ac"
color-link message "#89b4fa"
color-link error-message "bold #f38ba8"
