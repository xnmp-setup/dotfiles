# Omarchy Ayu Light palette.
color-link default "#5c6166,#f8f9fa"
color-link comment "#8a9199,#f8f9fa"
color-link identifier "#5c6166,#f8f9fa"
color-link constant "#f07171,#f8f9fa"
color-link constant.string "#6cbf43,#f8f9fa"
color-link constant.string.char "#6cbf43,#f8f9fa"
color-link constant.number "#f07171,#f8f9fa"
color-link constant.bool "#f07171,#f8f9fa"
color-link statement "#9e75c7,#f8f9fa"
color-link symbol.operator "#399ee6,#f8f9fa"
color-link symbol.brackets "#5c6166,#f8f9fa"
color-link symbol.tag "#3199e1,#f8f9fa"
color-link preproc "#eca944,#f8f9fa"
color-link type "#46ba94,#f8f9fa"
color-link type.keyword "#46ba94,#f8f9fa"
color-link special "#46ba94,#f8f9fa"
color-link underlined "#ea6c6d,#f8f9fa"
color-link error "bold #ea6c6d,#f8f9fa"
color-link todo "bold #eca944,#f8f9fa"
color-link statusline "#5c6166,#f3f4f5"
color-link statusline.inactive "#8a9199,#f8f9fa"
color-link statusline.suggestions "#000000,#3199e1"
color-link tabbar "#8a9199,#f8f9fa"
color-link tabbar.active "#5c6166,#f3f4f5"
color-link indent-char "#d3e1f5,#f8f9fa"
color-link line-number "#8a9199,#f8f9fa"
color-link current-line-number "#5c6166,#f8f9fa"
color-link cursor-line "#f3f4f5"
color-link color-column "#f3f4f5"
color-link divider "#c7c7c7"
color-link scrollbar "#c7c7c7"
color-link selection "#5c6166,#d3e1f5"
color-link hlsearch "#000000,#eca944"
color-link match-brace "#000000,#3199e1"
color-link diff-added "#6cbf43"
color-link diff-modified "#46ba94"
color-link diff-deleted "#ea6c6d"
color-link gutter-error "#ea6c6d,#f8f9fa"
color-link gutter-warning "#eca944,#f8f9fa"
color-link gutter-info "#46ba94,#f8f9fa"
color-link tab-error "#ea6c6d"
color-link trailingws "#ea6c6d"
color-link message "#46ba94"
color-link error-message "bold #ea6c6d"
