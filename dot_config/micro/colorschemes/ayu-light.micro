# Omarchy Ayu Light palette.
color-link default "#474c52,#f8f9fa"
color-link comment "#6f767e,#f8f9fa"
color-link identifier "#474c52,#f8f9fa"
color-link constant "#e25a5a,#f8f9fa"
color-link constant.string "#4f9f2a,#f8f9fa"
color-link constant.string.char "#4f9f2a,#f8f9fa"
color-link constant.number "#e25a5a,#f8f9fa"
color-link constant.bool "#e25a5a,#f8f9fa"
color-link statement "#8759b8,#f8f9fa"
color-link symbol.operator "#2389d4,#f8f9fa"
color-link symbol.brackets "#474c52,#f8f9fa"
color-link symbol.tag "#1b82cc,#f8f9fa"
color-link preproc "#cf8a16,#f8f9fa"
color-link type "#2a9c78,#f8f9fa"
color-link type.keyword "#2a9c78,#f8f9fa"
color-link special "#2a9c78,#f8f9fa"
color-link underlined "#d9504f,#f8f9fa"
color-link error "bold #d9504f,#f8f9fa"
color-link todo "bold #cf8a16,#f8f9fa"
color-link statusline "#474c52,#eef0f2"
color-link statusline.inactive "#6f767e,#f8f9fa"
color-link statusline.suggestions "#000000,#1b82cc"
color-link tabbar "#6f767e,#f8f9fa"
color-link tabbar.active "#474c52,#eef0f2"
color-link indent-char "#c4d7f2,#f8f9fa"
color-link line-number "#6f767e,#f8f9fa"
color-link current-line-number "#474c52,#f8f9fa"
color-link cursor-line "#eef0f2"
color-link color-column "#eef0f2"
color-link divider "#b3b8be"
color-link scrollbar "#b3b8be"
color-link selection "#474c52,#c4d7f2"
color-link hlsearch "#000000,#cf8a16"
color-link match-brace "#000000,#1b82cc"
color-link diff-added "#4f9f2a"
color-link diff-modified "#2a9c78"
color-link diff-deleted "#d9504f"
color-link gutter-error "#d9504f,#f8f9fa"
color-link gutter-warning "#cf8a16,#f8f9fa"
color-link gutter-info "#2a9c78,#f8f9fa"
color-link tab-error "#d9504f"
color-link trailingws "#d9504f"
color-link message "#2a9c78"
color-link error-message "bold #d9504f"
