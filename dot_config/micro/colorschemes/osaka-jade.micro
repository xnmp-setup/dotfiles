# Osaka Jade palette.
color-link default "#c1c497,#111c18"
color-link comment "#81b8a8,#111c18"
color-link identifier "#c1c497,#111c18"
color-link constant "#a2734b,#111c18"
color-link constant.string "#549e6a,#111c18"
color-link constant.string.char "#549e6a,#111c18"
color-link constant.number "#a2734b,#111c18"
color-link constant.bool "#a2734b,#111c18"
color-link statement "#d2689c,#111c18"
color-link symbol.operator "#acd4cf,#111c18"
color-link symbol.brackets "#c1c497,#111c18"
color-link symbol.tag "#509475,#111c18"
color-link preproc "#459451,#111c18"
color-link type "#2dd5b7,#111c18"
color-link type.keyword "#2dd5b7,#111c18"
color-link special "#8cd3cb,#111c18"
color-link underlined "#db9f9c,#111c18"
color-link error "bold #db9f9c,#111c18"
color-link todo "bold #e5c736,#111c18"
color-link statusline "#c1c497,#23372b"
color-link statusline.inactive "#81b8a8,#111c18"
color-link statusline.suggestions "#111c18,#8cd3cb"
color-link tabbar "#81b8a8,#111c18"
color-link tabbar.active "#c1c497,#23372b"
color-link indent-char "#32473b,#111c18"
color-link line-number "#81b8a8,#111c18"
color-link current-line-number "#c1c497,#111c18"
color-link cursor-line "#23372b"
color-link color-column "#23372b"
color-link divider "#53685b"
color-link scrollbar "#53685b"
color-link selection "#c1c497,#32473b"
color-link hlsearch "#111c18,#e5c736"
color-link match-brace "#111c18,#8cd3cb"
color-link diff-added "#549e6a"
color-link diff-modified "#509475"
color-link diff-deleted "#db9f9c"
color-link gutter-error "#db9f9c,#111c18"
color-link gutter-warning "#459451,#111c18"
color-link gutter-info "#8cd3cb,#111c18"
color-link tab-error "#db9f9c"
color-link trailingws "#db9f9c"
color-link message "#8cd3cb"
color-link error-message "bold #db9f9c"
