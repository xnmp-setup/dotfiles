# Nord - the canonical Nord color scheme (arctic, north-bluish palette)
# Polar Night backgrounds, Snow Storm foregrounds, Frost/Aurora accents

# Syntax highlighting
color-link default "#d8dee9,#2e3440"
color-link comment "#616e88,#2e3440"
color-link identifier "#d8dee9,#2e3440"
color-link constant "#81a1c1,#2e3440"
color-link constant.string "#a3be8c,#2e3440"
color-link constant.string.char "#a3be8c,#2e3440"
color-link constant.number "#b48ead,#2e3440"
color-link constant.bool "#81a1c1,#2e3440"
color-link statement "#81a1c1,#2e3440"
color-link symbol.operator "#81a1c1,#2e3440"
color-link symbol.brackets "#d8dee9,#2e3440"
color-link symbol.tag "#88c0d0,#2e3440"
color-link preproc "#ebcb8b,#2e3440"
color-link type "#8fbcbb,#2e3440"
color-link type.keyword "#8fbcbb,#2e3440"
color-link type.extended "default"
color-link special "#88c0d0,#2e3440"
color-link underlined "#bf616a,#2e3440"
color-link error "bold #bf616a,#2e3440"
color-link todo "bold #ebcb8b,#2e3440"

# UI elements
color-link statusline "#d8dee9,#3b4252"
color-link statusline.inactive "#616e88,#2e3440"
color-link statusline.suggestions "#2e3440,#88c0d0"
color-link tabbar "#616e88,#2e3440"
color-link tabbar.active "#d8dee9,#3b4252"
color-link indent-char "#3b4252,#2e3440"
color-link line-number "#616e88,#2e3440"
color-link current-line-number "#d8dee9,#2e3440"
color-link cursor-line "#3b4252"
color-link color-column "#3b4252"
color-link divider "#4c566a"
color-link scrollbar "#4c566a"

# Visual indicators
color-link selection "#d8dee9,#434c5e"
color-link hlsearch "#2e3440,#88c0d0"
color-link match-brace "#2e3440,#88c0d0"
color-link diff-added "#a3be8c"
color-link diff-modified "#88c0d0"
color-link diff-deleted "#bf616a"
color-link gutter-error "#bf616a,#2e3440"
color-link gutter-warning "#ebcb8b,#2e3440"
color-link gutter-info "#88c0d0,#2e3440"
color-link tab-error "#bf616a"
color-link trailingws "#bf616a"
color-link message "#88c0d0"
color-link error-message "bold #bf616a"
