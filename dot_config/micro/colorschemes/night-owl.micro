# Night Owl - Sarah Drasner's canonical Night Owl palette
# Deep-blue night coding theme with cool blue/purple/aqua accents

# Syntax highlighting
color-link default "#D6DEEB,#011627"
color-link comment "#637777,#011627"
color-link identifier "#D6DEEB,#011627"
color-link constant "#82AAFF,#011627"
color-link constant.string "#ECC48D,#011627"
color-link constant.string.char "#ECC48D,#011627"
color-link constant.number "#F78C6C,#011627"
color-link constant.bool "#F78C6C,#011627"
color-link statement "#C792EA,#011627"
color-link symbol.operator "#7FDBCA,#011627"
color-link symbol.brackets "#D6DEEB,#011627"
color-link symbol.tag "#82AAFF,#011627"
color-link preproc "#FFCB8B,#011627"
color-link type "#FFCB8B,#011627"
color-link type.keyword "#FFCB8B,#011627"
color-link type.extended "default"
color-link special "#21C7A8,#011627"
color-link underlined "#C792EA,#011627"
color-link error "bold #EF5350,#011627"
color-link todo "bold #FFEB95,#011627"

# UI elements
color-link statusline "#D6DEEB,#0B2942"
color-link statusline.inactive "#637777,#011627"
color-link statusline.suggestions "#011627,#21C7A8"
color-link tabbar "#637777,#011627"
color-link tabbar.active "#D6DEEB,#0B2942"
color-link indent-char "#0B2942,#011627"
color-link line-number "#637777,#011627"
color-link current-line-number "#D6DEEB,#011627"
color-link cursor-line "#0B2942"
color-link color-column "#0B2942"
color-link divider "#1E3A5C"
color-link scrollbar "#1E3A5C"

# Visual indicators
color-link selection "#D6DEEB,#1D3B53"
color-link hlsearch "#011627,#21C7A8"
color-link match-brace "#011627,#21C7A8"
color-link diff-added "#22DA6E"
color-link diff-modified "#82AAFF"
color-link diff-deleted "#EF5350"
color-link gutter-error "#EF5350,#011627"
color-link gutter-warning "#FFEB95,#011627"
color-link gutter-info "#82AAFF,#011627"
color-link tab-error "#EF5350"
color-link trailingws "#EF5350"
color-link message "#82AAFF"
color-link error-message "bold #EF5350"
