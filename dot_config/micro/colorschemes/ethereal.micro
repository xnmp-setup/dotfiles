# Omarchy Ethereal palette.
color-link default "#ffcead,#060b1e"
color-link comment "#6d7db6,#060b1e"
color-link identifier "#ffcead,#060b1e"
color-link constant "#eb8b54,#060b1e"
color-link constant.string "#92a593,#060b1e"
color-link constant.string.char "#92a593,#060b1e"
color-link constant.number "#eb8b54,#060b1e"
color-link constant.bool "#eb8b54,#060b1e"
color-link statement "#c89dc1,#060b1e"
color-link symbol.operator "#dfeaf0,#060b1e"
color-link symbol.brackets "#ffcead,#060b1e"
color-link symbol.tag "#7d82d9,#060b1e"
color-link preproc "#e9bb4f,#060b1e"
color-link type "#a3bfd1,#060b1e"
color-link type.keyword "#a3bfd1,#060b1e"
color-link special "#dfeaf0,#060b1e"
color-link underlined "#faaaa9,#060b1e"
color-link error "bold #faaaa9,#060b1e"
color-link todo "bold #f7dc9c,#060b1e"
color-link statusline "#ffcead,#131a3a"
color-link statusline.inactive "#6d7db6,#060b1e"
color-link statusline.suggestions "#060b1e,#7d82d9"
color-link tabbar "#6d7db6,#060b1e"
color-link tabbar.active "#ffcead,#131a3a"
color-link indent-char "#252e56,#060b1e"
color-link line-number "#6d7db6,#060b1e"
color-link current-line-number "#ffcead,#060b1e"
color-link cursor-line "#131a3a"
color-link color-column "#131a3a"
color-link divider "#6d7db6"
color-link scrollbar "#6d7db6"
color-link selection "#ffcead,#252e56"
color-link hlsearch "#060b1e,#e9bb4f"
color-link match-brace "#060b1e,#a3bfd1"
color-link diff-added "#92a593"
color-link diff-modified "#a3bfd1"
color-link diff-deleted "#faaaa9"
color-link gutter-error "#faaaa9,#060b1e"
color-link gutter-warning "#e9bb4f,#060b1e"
color-link gutter-info "#a3bfd1,#060b1e"
color-link tab-error "#faaaa9"
color-link trailingws "#faaaa9"
color-link message "#a3bfd1"
color-link error-message "bold #faaaa9"
