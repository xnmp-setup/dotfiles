# Horizon Dark - canonical Horizon palette (cinematic sunset-noir)
# Deep indigo dark theme with warm rose/orange and cool cyan/blue accents

# Syntax highlighting
color-link default "#d5d8da,#1c1e26"
color-link comment "#6c6f93,#1c1e26"
color-link identifier "#d5d8da,#1c1e26"
color-link constant "#fab795,#1c1e26"
color-link constant.string "#29d398,#1c1e26"
color-link constant.string.char "#29d398,#1c1e26"
color-link constant.number "#fab795,#1c1e26"
color-link constant.bool "#fab795,#1c1e26"
color-link statement "#ee64ac,#1c1e26"
color-link symbol.operator "#59e1e3,#1c1e26"
color-link symbol.brackets "#d5d8da,#1c1e26"
color-link symbol.tag "#26bbd9,#1c1e26"
color-link preproc "#26bbd9,#1c1e26"
color-link type "#26bbd9,#1c1e26"
color-link type.keyword "#26bbd9,#1c1e26"
color-link type.extended "default"
color-link special "#26bbd9,#1c1e26"
color-link underlined "#ee64ac,#1c1e26"
color-link error "bold #e95678,#1c1e26"
color-link todo "bold #fab795,#1c1e26"

# UI elements
color-link statusline "#d5d8da,#232530"
color-link statusline.inactive "#6c6f93,#1c1e26"
color-link statusline.suggestions "#1c1e26,#26bbd9"
color-link tabbar "#6c6f93,#1c1e26"
color-link tabbar.active "#d5d8da,#232530"
color-link indent-char "#232530,#1c1e26"
color-link line-number "#6c6f93,#1c1e26"
color-link current-line-number "#d5d8da,#1c1e26"
color-link cursor-line "#232530"
color-link color-column "#232530"
color-link divider "#2e303e"
color-link scrollbar "#2e303e"

# Visual indicators
color-link selection "#d5d8da,#2e303e"
color-link hlsearch "#1c1e26,#26bbd9"
color-link match-brace "#1c1e26,#26bbd9"
color-link diff-added "#29d398"
color-link diff-modified "#26bbd9"
color-link diff-deleted "#e95678"
color-link gutter-error "#e95678,#1c1e26"
color-link gutter-warning "#fab795,#1c1e26"
color-link gutter-info "#26bbd9,#1c1e26"
color-link tab-error "#e95678"
color-link trailingws "#e95678"
color-link message "#26bbd9"
color-link error-message "bold #e95678"
