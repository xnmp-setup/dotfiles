# Omarchy Catppuccin Lavender palette.
color-link default "#484453,#f8f8fb"
color-link comment "#706d79,#f8f8fb"
color-link identifier "#484453,#f8f8fb"
color-link constant "#965837,#f8f8fb"
color-link constant.string "#497045,#f8f8fb"
color-link constant.string.char "#497045,#f8f8fb"
color-link constant.number "#965837,#f8f8fb"
color-link constant.bool "#965837,#f8f8fb"
color-link statement "#756681,#f8f8fb"
color-link symbol.operator "#4962a0,#f8f8fb"
color-link symbol.brackets "#484453,#f8f8fb"
color-link symbol.tag "#4962a0,#f8f8fb"
color-link preproc "#865e22,#f8f8fb"
color-link type "#327179,#f8f8fb"
color-link type.keyword "#327179,#f8f8fb"
color-link special "#327179,#f8f8fb"
color-link underlined "#a64a66,#f8f8fb"
color-link error "bold #a64a66,#f8f8fb"
color-link todo "bold #865e22,#f8f8fb"
color-link statusline "#484453,#f0f4f3"
color-link statusline.inactive "#706d79,#f8f8fb"
color-link statusline.suggestions "#f8f8fb,#756681"
color-link tabbar "#706d79,#f8f8fb"
color-link tabbar.active "#484453,#f0f4f3"
color-link indent-char "#e9e7f0,#f8f8fb"
color-link line-number "#706d79,#f8f8fb"
color-link current-line-number "#484453,#f8f8fb"
color-link cursor-line "#f0f4f3"
color-link color-column "#f0f4f3"
color-link divider "#d5d1df"
color-link scrollbar "#d5d1df"
color-link selection "#484453,#e9e7f0"
color-link hlsearch "#484453,#eedfc4"
color-link match-brace "#f8f8fb,#756681"
color-link diff-added "#497045"
color-link diff-modified "#327179"
color-link diff-deleted "#a64a66"
color-link gutter-error "#a64a66,#f8f8fb"
color-link gutter-warning "#865e22,#f8f8fb"
color-link gutter-info "#327179,#f8f8fb"
color-link tab-error "#a64a66"
color-link trailingws "#a64a66"
color-link message "#327179"
color-link error-message "bold #a64a66"
