# Omarchy Kanagawa palette.
color-link default "#dcd7ba,#1f1f28"
color-link comment "#727169,#1f1f28"
color-link identifier "#dcd7ba,#1f1f28"
color-link constant "#c17158,#1f1f28"
color-link constant.string "#76946a,#1f1f28"
color-link constant.string.char "#76946a,#1f1f28"
color-link constant.number "#c17158,#1f1f28"
color-link constant.bool "#c17158,#1f1f28"
color-link statement "#957fb8,#1f1f28"
color-link symbol.operator "#7fb4ca,#1f1f28"
color-link symbol.brackets "#dcd7ba,#1f1f28"
color-link symbol.tag "#7e9cd8,#1f1f28"
color-link preproc "#c0a36e,#1f1f28"
color-link type "#6a9589,#1f1f28"
color-link type.keyword "#6a9589,#1f1f28"
color-link special "#7aa89f,#1f1f28"
color-link underlined "#e82424,#1f1f28"
color-link error "bold #e82424,#1f1f28"
color-link todo "bold #e6c384,#1f1f28"
color-link statusline "#dcd7ba,#223249"
color-link statusline.inactive "#727169,#1f1f28"
color-link statusline.suggestions "#1f1f28,#7aa89f"
color-link tabbar "#727169,#1f1f28"
color-link tabbar.active "#dcd7ba,#223249"
color-link indent-char "#363646,#1f1f28"
color-link line-number "#727169,#1f1f28"
color-link current-line-number "#dcd7ba,#1f1f28"
color-link cursor-line "#223249"
color-link color-column "#223249"
color-link divider "#54546d"
color-link scrollbar "#54546d"
color-link selection "#dcd7ba,#363646"
color-link hlsearch "#1f1f28,#e6c384"
color-link match-brace "#1f1f28,#7aa89f"
color-link diff-added "#76946a"
color-link diff-modified "#7fb4ca"
color-link diff-deleted "#e82424"
color-link gutter-error "#e82424,#1f1f28"
color-link gutter-warning "#c0a36e,#1f1f28"
color-link gutter-info "#7aa89f,#1f1f28"
color-link tab-error "#e82424"
color-link trailingws "#e82424"
color-link message "#7aa89f"
color-link error-message "bold #e82424"
