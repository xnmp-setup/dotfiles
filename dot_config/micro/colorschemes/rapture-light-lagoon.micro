# Rapture Light Lagoon palette.
color-link default "#223d50,#f0f9fd"
color-link comment "#526f80,#f0f9fd"
color-link identifier "#223d50,#f0f9fd"
color-link constant "#8b691e,#f0f9fd"
color-link constant.string "#14758f,#f0f9fd"
color-link constant.string.char "#14758f,#f0f9fd"
color-link constant.number "#8b691e,#f0f9fd"
color-link constant.bool "#8b691e,#f0f9fd"
color-link statement "#af3e79,#f0f9fd"
color-link symbol.operator "#526f80,#f0f9fd"
color-link symbol.brackets "#223d50,#f0f9fd"
color-link symbol.tag "#14758f,#f0f9fd"
color-link preproc "#8b691e,#f0f9fd"
color-link type "#af3e79,#f0f9fd"
color-link type.keyword "#af3e79,#f0f9fd"
color-link special "#14758f,#f0f9fd"
color-link underlined "#b45343,#f0f9fd"
color-link error "bold #b45343,#f0f9fd"
color-link todo "bold #8b691e,#f0f9fd"
color-link statusline "#223d50,#e0f1f8"
color-link statusline.inactive "#526f80,#f0f9fd"
color-link statusline.suggestions "#f0f9fd,#14758f"
color-link tabbar "#526f80,#f0f9fd"
color-link tabbar.active "#223d50,#e0f1f8"
color-link indent-char "#c7e9f4,#f0f9fd"
color-link line-number "#526f80,#f0f9fd"
color-link current-line-number "#223d50,#f0f9fd"
color-link cursor-line "#e0f1f8"
color-link color-column "#e0f1f8"
color-link divider "#bfddeb"
color-link scrollbar "#bfddeb"
color-link selection "#223d50,#c7e9f4"
color-link hlsearch "#f0f9fd,#8b691e"
color-link match-brace "#f0f9fd,#14758f"
color-link diff-added "#187c70"
color-link diff-modified "#14758f"
color-link diff-deleted "#b45343"
color-link gutter-error "#b45343,#f0f9fd"
color-link gutter-warning "#8b691e,#f0f9fd"
color-link gutter-info "#14758f,#f0f9fd"
color-link tab-error "#b45343"
color-link trailingws "#b45343"
color-link message "#14758f"
color-link error-message "bold #b45343"
