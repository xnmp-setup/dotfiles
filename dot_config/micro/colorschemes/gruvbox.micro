# Gruvbox Dark Medium - canonical Gruvbox palette (medium contrast)
# Classic retro-warm dark theme with vivid red/orange/aqua/yellow accents

# Syntax highlighting
color-link default "#EBDBB2,#282828"
color-link comment "#928374,#282828"
color-link identifier "#EBDBB2,#282828"
color-link constant "#D3869B,#282828"
color-link constant.string "#8EC07C,#282828"
color-link constant.string.char "#8EC07C,#282828"
color-link constant.number "#D3869B,#282828"
color-link constant.bool "#D3869B,#282828"
color-link statement "#FB4934,#282828"
color-link symbol.operator "#FE8019,#282828"
color-link symbol.brackets "#EBDBB2,#282828"
color-link symbol.tag "#83A598,#282828"
color-link preproc "#FABD2F,#282828"
color-link type "#FABD2F,#282828"
color-link type.keyword "#FABD2F,#282828"
color-link type.extended "default"
color-link special "#83A598,#282828"
color-link underlined "#FB4934,#282828"
color-link error "bold #FB4934,#282828"
color-link todo "bold #FABD2F,#282828"

# UI elements
color-link statusline "#EBDBB2,#3C3836"
color-link statusline.inactive "#928374,#282828"
color-link statusline.suggestions "#282828,#83A598"
color-link tabbar "#928374,#282828"
color-link tabbar.active "#EBDBB2,#3C3836"
color-link indent-char "#3C3836,#282828"
color-link line-number "#928374,#282828"
color-link current-line-number "#EBDBB2,#282828"
color-link cursor-line "#3C3836"
color-link color-column "#3C3836"
color-link divider "#665C54"
color-link scrollbar "#665C54"

# Visual indicators
color-link selection "#EBDBB2,#504945"
color-link hlsearch "#282828,#83A598"
color-link match-brace "#282828,#83A598"
color-link diff-added "#B8BB26"
color-link diff-modified "#83A598"
color-link diff-deleted "#FB4934"
color-link gutter-error "#FB4934,#282828"
color-link gutter-warning "#FABD2F,#282828"
color-link gutter-info "#83A598,#282828"
color-link tab-error "#FB4934"
color-link trailingws "#FB4934"
color-link message "#458588"
color-link error-message "bold #FB4934"
