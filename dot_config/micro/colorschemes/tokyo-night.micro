# Tokyo Night - canonical Tokyo Night palette (cool, night-city inspired)
# Palette: bg=#1a1b26, red=#f7768e, green=#9ece6a, yellow=#e0af68, blue=#7aa2f7, purple=#ad8ee6, cyan=#449dab

# Syntax highlighting
color-link default "#a9b1d6,#1a1b26"
color-link comment "#565f89,#1a1b26"
color-link identifier "#a9b1d6,#1a1b26"
color-link constant "#eb927b,#1a1b26"
color-link constant.string "#9ece6a,#1a1b26"
color-link constant.string.char "#9ece6a,#1a1b26"
color-link constant.number "#eb927b,#1a1b26"
color-link constant.bool "#eb927b,#1a1b26"
color-link statement "#ad8ee6,#1a1b26"
color-link symbol.operator "#0db9d7,#1a1b26"
color-link symbol.brackets "#a9b1d6,#1a1b26"
color-link symbol.tag "#7aa2f7,#1a1b26"
color-link preproc "#e0af68,#1a1b26"
color-link type "#449dab,#1a1b26"
color-link type.keyword "#449dab,#1a1b26"
color-link type.extended "default"
color-link special "#449dab,#1a1b26"
color-link underlined "#f7768e,#1a1b26"
color-link error "bold #f7768e,#1a1b26"
color-link todo "bold #e0af68,#1a1b26"

# UI elements
color-link statusline "#a9b1d6,#24283b"
color-link statusline.inactive "#565f89,#1a1b26"
color-link statusline.suggestions "#1a1b26,#449dab"
color-link tabbar "#565f89,#1a1b26"
color-link tabbar.active "#a9b1d6,#24283b"
color-link indent-char "#24283b,#1a1b26"
color-link line-number "#565f89,#1a1b26"
color-link current-line-number "#c0caf5,#1a1b26"
color-link cursor-line "#24283b"
color-link color-column "#24283b"
color-link divider "#414868"
color-link scrollbar "#414868"

# Visual indicators
color-link selection "#c0caf5,#292e42"
color-link hlsearch "#1a1b26,#449dab"
color-link match-brace "#1a1b26,#449dab"
color-link diff-added "#9ece6a"
color-link diff-modified "#449dab"
color-link diff-deleted "#f7768e"
color-link gutter-error "#f7768e,#1a1b26"
color-link gutter-warning "#e0af68,#1a1b26"
color-link gutter-info "#449dab,#1a1b26"
color-link tab-error "#f7768e"
color-link trailingws "#f7768e"
color-link message "#449dab"
color-link error-message "bold #f7768e"
