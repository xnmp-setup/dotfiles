# Omarchy Flexoki Light palette.
color-link default "#100f0f,#fffcf0"
color-link comment "#878580,#fffcf0"
color-link identifier "#100f0f,#fffcf0"
color-link constant "#d0772b,#fffcf0"
color-link constant.string "#879a39,#fffcf0"
color-link constant.string.char "#879a39,#fffcf0"
color-link constant.number "#d0772b,#fffcf0"
color-link constant.bool "#d0772b,#fffcf0"
color-link statement "#ce5d97,#fffcf0"
color-link symbol.operator "#4385be,#fffcf0"
color-link symbol.brackets "#100f0f,#fffcf0"
color-link symbol.tag "#205ea6,#fffcf0"
color-link preproc "#d0a215,#fffcf0"
color-link type "#3aa99f,#fffcf0"
color-link type.keyword "#3aa99f,#fffcf0"
color-link special "#3aa99f,#fffcf0"
color-link underlined "#d14d41,#fffcf0"
color-link error "bold #d14d41,#fffcf0"
color-link todo "bold #d0a215,#fffcf0"
color-link statusline "#100f0f,#f2efe4"
color-link statusline.inactive "#878580,#fffcf0"
color-link statusline.suggestions "#fffcf0,#205ea6"
color-link tabbar "#878580,#fffcf0"
color-link tabbar.active "#100f0f,#f2efe4"
color-link indent-char "#cecdc3,#fffcf0"
color-link line-number "#878580,#fffcf0"
color-link current-line-number "#100f0f,#fffcf0"
color-link cursor-line "#f2efe4"
color-link color-column "#f2efe4"
color-link divider "#b7b5ac"
color-link scrollbar "#b7b5ac"
color-link selection "#100f0f,#cecdc3"
color-link hlsearch "#fffcf0,#d0a215"
color-link match-brace "#fffcf0,#205ea6"
color-link diff-added "#879a39"
color-link diff-modified "#3aa99f"
color-link diff-deleted "#d14d41"
color-link gutter-error "#d14d41,#fffcf0"
color-link gutter-warning "#d0a215,#fffcf0"
color-link gutter-info "#3aa99f,#fffcf0"
color-link tab-error "#d14d41"
color-link trailingws "#d14d41"
color-link message "#3aa99f"
color-link error-message "bold #d14d41"
