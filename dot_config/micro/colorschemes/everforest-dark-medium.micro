# Everforest Dark Medium - canonical Everforest palette (medium contrast)
# Warm, forest-inspired dark theme with muted green/aqua/yellow accents

# Syntax highlighting
color-link default "#d3c6aa,#2d353b"
color-link comment "#859289,#2d353b"
color-link identifier "#d3c6aa,#2d353b"
color-link constant "#d699b6,#2d353b"
color-link constant.string "#83c092,#2d353b"
color-link constant.string.char "#83c092,#2d353b"
color-link constant.number "#d699b6,#2d353b"
color-link constant.bool "#d699b6,#2d353b"
color-link statement "#e67e80,#2d353b"
color-link symbol.operator "#e69875,#2d353b"
color-link symbol.brackets "#d3c6aa,#2d353b"
color-link symbol.tag "#7fbbb3,#2d353b"
color-link preproc "#dbbc7f,#2d353b"
color-link type "#dbbc7f,#2d353b"
color-link type.keyword "#dbbc7f,#2d353b"
color-link type.extended "default"
color-link special "#7fbbb3,#2d353b"
color-link underlined "#e67e80,#2d353b"
color-link error "bold #e67e80,#2d353b"
color-link todo "bold #dbbc7f,#2d353b"

# UI elements
color-link statusline "#d3c6aa,#343f44"
color-link statusline.inactive "#859289,#2d353b"
color-link statusline.suggestions "#2d353b,#7fbbb3"
color-link tabbar "#859289,#2d353b"
color-link tabbar.active "#d3c6aa,#343f44"
color-link indent-char "#343f44,#2d353b"
color-link line-number "#859289,#2d353b"
color-link current-line-number "#d3c6aa,#2d353b"
color-link cursor-line "#343f44"
color-link color-column "#343f44"
color-link divider "#475258"
color-link scrollbar "#475258"

# Visual indicators
color-link selection "#d3c6aa,#3d484d"
color-link hlsearch "#2d353b,#7fbbb3"
color-link match-brace "#2d353b,#7fbbb3"
color-link diff-added "#a7c080"
color-link diff-modified "#7fbbb3"
color-link diff-deleted "#e67e80"
color-link gutter-error "#e67e80,#2d353b"
color-link gutter-warning "#dbbc7f,#2d353b"
color-link gutter-info "#7fbbb3,#2d353b"
color-link tab-error "#e67e80"
color-link trailingws "#e67e80"
color-link message "#7fbbb3"
color-link error-message "bold #e67e80"
