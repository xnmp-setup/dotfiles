# MapQuest palette.
color-link default "#3c4747,#ecd3a1"
color-link comment "#6f654f,#ecd3a1"
color-link identifier "#3c4747,#ecd3a1"
color-link constant "#966133,#ecd3a1"
color-link constant.string "#3a443d,#ecd3a1"
color-link constant.string.char "#3a443d,#ecd3a1"
color-link constant.number "#966133,#ecd3a1"
color-link constant.bool "#966133,#ecd3a1"
color-link statement "#764e27,#ecd3a1"
color-link symbol.operator "#5a7c91,#ecd3a1"
color-link symbol.brackets "#3c4747,#ecd3a1"
color-link symbol.tag "#465353,#ecd3a1"
color-link preproc "#826e48,#ecd3a1"
color-link type "#7b826d,#ecd3a1"
color-link type.keyword "#7b826d,#ecd3a1"
color-link special "#a8ae9d,#ecd3a1"
color-link underlined "#966133,#ecd3a1"
color-link error "bold #966133,#ecd3a1"
color-link todo "bold #b59d71,#ecd3a1"
color-link statusline "#3c4747,#f4dfb5"
color-link statusline.inactive "#6f654f,#ecd3a1"
color-link statusline.suggestions "#ecd3a1,#a8ae9d"
color-link tabbar "#6f654f,#ecd3a1"
color-link tabbar.active "#3c4747,#f4dfb5"
color-link indent-char "#b79f70,#ecd3a1"
color-link line-number "#6f654f,#ecd3a1"
color-link current-line-number "#3c4747,#ecd3a1"
color-link cursor-line "#f4dfb5"
color-link color-column "#f4dfb5"
color-link divider "#826e48"
color-link scrollbar "#826e48"
color-link selection "#3c4747,#b79f70"
color-link hlsearch "#ecd3a1,#b59d71"
color-link match-brace "#ecd3a1,#a8ae9d"
color-link diff-added "#3a443d"
color-link diff-modified "#465353"
color-link diff-deleted "#966133"
color-link gutter-error "#966133,#ecd3a1"
color-link gutter-warning "#826e48,#ecd3a1"
color-link gutter-info "#a8ae9d,#ecd3a1"
color-link tab-error "#966133"
color-link trailingws "#966133"
color-link message "#a8ae9d"
color-link error-message "bold #966133"
