# Ayu Mirage - ported from the canonical Ayu Mirage palette
# Deep blue-grey base with warm gold accent, blue/purple/green syntax colors

# Syntax highlighting
color-link default "#cbccc6,#1f2430"
color-link comment "#5c6773,#1f2430"
color-link identifier "#73d0ff,#1f2430"
color-link constant "#d4bfff,#1f2430"
color-link constant.string "#bae67e,#1f2430"
color-link constant.string.char "#bae67e,#1f2430"
color-link constant.number "#d4bfff,#1f2430"
color-link constant.bool "#d4bfff,#1f2430"
color-link statement "#ffa759,#1f2430"
color-link symbol.operator "#f29e74,#1f2430"
color-link symbol.brackets "#cbccc6,#1f2430"
color-link symbol.tag "#5ccfe6,#1f2430"
color-link preproc "#ffd580,#1f2430"
color-link type "#d4bfff,#1f2430"
color-link type.keyword "#d4bfff,#1f2430"
color-link type.extended "default"
color-link special "#5ccfe6,#1f2430"
color-link underlined "#ffcc66,#1f2430"
color-link error "bold #ff3333,#1f2430"
color-link todo "bold #ffcc66,#1f2430"

# UI elements
color-link statusline "#cbccc6,#232834"
color-link statusline.inactive "#707a8c,#171b24"
color-link statusline.suggestions "#1f2430,#73d0ff"
color-link tabbar "#707a8c,#171b24"
color-link tabbar.active "#cbccc6,#232834"
color-link indent-char "#34455a,#1f2430"
color-link line-number "#5c6773,#1f2430"
color-link current-line-number "#cbccc6,#1f2430"
color-link cursor-line "#232834"
color-link color-column "#232834"
color-link divider "#34455a"
color-link scrollbar "#34455a"

# Visual indicators
color-link selection "#d7d8d3,#48607d"
color-link hlsearch "#1f2430,#73d0ff"
color-link match-brace "#1f2430,#5ccfe6"
color-link diff-added "#bae67e"
color-link diff-modified "#5ccfe6"
color-link diff-deleted "#f28779"
color-link gutter-error "#ff3333,#1f2430"
color-link gutter-warning "#ffcc66,#1f2430"
color-link gutter-info "#5ccfe6,#1f2430"
color-link tab-error "#ff3333"
color-link trailingws "#f28779"
color-link message "#73d0ff"
color-link error-message "bold #ff3333"
