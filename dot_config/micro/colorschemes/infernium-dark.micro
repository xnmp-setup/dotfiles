# Infernium Dark palette.
color-link default "#e0e0e0,#1c1c1c"
color-link comment "#767476,#1c1c1c"
color-link identifier "#e0e0e0,#1c1c1c"
color-link constant "#e99867,#1c1c1c"
color-link constant.string "#767476,#1c1c1c"
color-link constant.string.char "#767476,#1c1c1c"
color-link constant.number "#e99867,#1c1c1c"
color-link constant.bool "#e99867,#1c1c1c"
color-link statement "#ba6435,#1c1c1c"
color-link symbol.operator "#cad1e0,#1c1c1c"
color-link symbol.brackets "#e0e0e0,#1c1c1c"
color-link symbol.tag "#aeb1c0,#1c1c1c"
color-link preproc "#f7d383,#1c1c1c"
color-link type "#e99867,#1c1c1c"
color-link type.keyword "#e99867,#1c1c1c"
color-link special "#f7d383,#1c1c1c"
color-link underlined "#e3884a,#1c1c1c"
color-link error "bold #e3884a,#1c1c1c"
color-link todo "bold #ffe39a,#1c1c1c"
color-link statusline "#e0e0e0,#292522"
color-link statusline.inactive "#767476,#1c1c1c"
color-link statusline.suggestions "#1c1c1c,#f7d383"
color-link tabbar "#767476,#1c1c1c"
color-link tabbar.active "#e0e0e0,#292522"
color-link indent-char "#d66938,#1c1c1c"
color-link line-number "#767476,#1c1c1c"
color-link current-line-number "#e0e0e0,#1c1c1c"
color-link cursor-line "#292522"
color-link color-column "#292522"
color-link divider "#767476"
color-link scrollbar "#767476"
color-link selection "#e0e0e0,#d66938"
color-link hlsearch "#1c1c1c,#ffe39a"
color-link match-brace "#1c1c1c,#f7d383"
color-link diff-added "#767476"
color-link diff-modified "#aeb1c0"
color-link diff-deleted "#e3884a"
color-link gutter-error "#e3884a,#1c1c1c"
color-link gutter-warning "#f7d383,#1c1c1c"
color-link gutter-info "#f7d383,#1c1c1c"
color-link tab-error "#e3884a"
color-link trailingws "#e3884a"
color-link message "#f7d383"
color-link error-message "bold #e3884a"
