    "editorBracketMatch.background": "#32473b80",
    "editorBracketMatch.border": "#509475",
    "editorGutter.addedBackground": "#549e6a",
    "editorGutter.modifiedBackground": "#509475",
    "editorGutter.deletedBackground": "#ff5345",
    "activityBar.background": "#0c1512",
    "activityBar.foreground": "#c1c497",
    "activityBar.inactiveForeground": "#81b8a8",
    "activityBarBadge.background": "#509475",
    "activityBarBadge.foreground": "#111c18",
    "sideBar.background": "#0c1512",
    "sideBar.foreground": "#d6d5bc",
    "sideBarSectionHeader.background": "#23372b",
    "sideBarSectionHeader.foreground": "#c1c497",
    "list.activeSelectionBackground": "#32473b",
