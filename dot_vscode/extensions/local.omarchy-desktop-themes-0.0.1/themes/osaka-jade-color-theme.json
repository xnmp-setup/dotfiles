    "tab.border": "#32473b",
    "tab.activeBorderTop": "#509475",
    "editorGroupHeader.tabsBackground": "#0c1512",
    "statusBar.background": "#23372b",
    "statusBar.foreground": "#c1c497",
    "input.background": "#0c1512",
