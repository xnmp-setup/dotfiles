    "list.hoverBackground": "#23372b",
    "list.inactiveSelectionBackground": "#32473b99",
    "list.highlightForeground": "#509475",
    "titleBar.activeBackground": "#0c1512",
    "titleBar.activeForeground": "#c1c497",
    "titleBar.inactiveBackground": "#0c1512",
    "titleBar.inactiveForeground": "#81b8a8",
    "tab.activeBackground": "#111c18",
