    "input.placeholderForeground": "#81b8a8",
    "dropdown.background": "#0c1512",
    "dropdown.foreground": "#c1c497",
    "dropdown.border": "#53685b",
    "button.background": "#509475",
    "button.foreground": "#111c18",
    "button.hoverBackground": "#71cead",
    "scrollbarSlider.background": "#53685b60",
    "scrollbarSlider.hoverBackground": "#53685ba0",
    "scrollbarSlider.activeBackground": "#53685bc0",
    "panel.background": "#0c1512",
    "panel.border": "#53685b",
    "panelTitle.activeBorder": "#509475",
    "terminal.background": "#111c18",
    "terminal.foreground": "#c1c497",
    "terminal.ansiBlack": "#111c18",
    "terminal.ansiRed": "#ff5345",
    "terminal.ansiGreen": "#549e6a",
    "terminal.ansiYellow": "#459451",
    "terminal.ansiBlue": "#509475",
    "terminal.ansiMagenta": "#d2689c",
    "terminal.ansiCyan": "#2dd5b7",
    "terminal.ansiWhite": "#c1c497",
    "terminal.ansiBrightBlack": "#53685b",
    "terminal.ansiBrightRed": "#db9f9c",
    "terminal.ansiBrightGreen": "#63b07a",
    "terminal.ansiBrightYellow": "#e5c736",
    "terminal.ansiBrightBlue": "#acd4cf",
    "terminal.ansiBrightMagenta": "#75bbb3",
    "terminal.ansiBrightCyan": "#8cd3cb",
    "terminal.ansiBrightWhite": "#f7e8b2",
    "gitDecoration.addedResourceForeground": "#549e6a",
    "gitDecoration.modifiedResourceForeground": "#509475",
    "gitDecoration.deletedResourceForeground": "#ff5345",
    "gitDecoration.untrackedResourceForeground": "#63b07a",
    "gitDecoration.ignoredResourceForeground": "#81b8a8",
    "notificationCenterHeader.background": "#23372b",
    "notifications.background": "#0c1512",
    "notifications.foreground": "#c1c497"
  },
  "semanticTokenColors": {
    "parameter": "#d6d5bc",
    "variable": "#c1c497",
    "variable.readonly": "#e5c736",
    "property": "#2dd5b7",
    "function": "#509475",
    "method": "#509475",
    "class": "#459451",
    "interface": "#459451",
    "enum": "#459451",
    "type": "#2dd5b7",
    "namespace": "#509475",
    "decorator": "#ff5345",
    "string": "#549e6a",
    "number": "#a2734b",
    "keyword": "#d2689c",
    "comment": {
      "foreground": "#81b8a8",
      "italic": true
    },
    "operator": "#acd4cf"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#81b8a8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d2689c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#509475"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#549e6a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a2734b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#2dd5b7"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c1c497"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#db9f9c"
      }
    }
  ]
}
