    "variable.readonly": "#df8e1d",
    "property": "#179299",
    "function": "#1e66f5",
    "method": "#1e66f5",
    "class": "#df8e1d",
    "interface": "#df8e1d",
    "enum": "#df8e1d",
    "type": "#179299",
    "namespace": "#8839ef",
    "decorator": "#d20f39",
    "string": "#40a02b",
    "number": "#d20f39",
    "keyword": "#8839ef",
    "comment": {
      "foreground": "#6c6f85",
      "italic": true
    },
    "operator": "#8839ef"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c6f85",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#179299"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    }
  ]
}
