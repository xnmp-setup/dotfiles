    "editor.lineHighlightBackground": "#F4F0D9",
    "editor.selectionBackground": "#EAEDC8",
    "editor.findMatchBackground": "#DFA00055",
    "editor.findMatchHighlightBackground": "#DFA00030",
    "editorCursor.foreground": "#5C6A72",
    "editorLineNumber.foreground": "#A6B0A0",
    "editorLineNumber.activeForeground": "#829181",
    "editorIndentGuide.background1": "#E6E2CC",
    "editorIndentGuide.activeBackground1": "#BDC3AF",
    "editorBracketMatch.background": "#E0DCC7",
    "editorBracketMatch.border": "#35A77C",
    "editorGutter.addedBackground": "#8DA101",
    "editorGutter.modifiedBackground": "#3A94C5",
    "editorGutter.deletedBackground": "#F85552",
    "activityBar.background": "#F4F0D9",
    "activityBar.foreground": "#5C6A72",
    "activityBar.inactiveForeground": "#939F91",
    "activityBarBadge.background": "#8DA101",
    "activityBarBadge.foreground": "#FDF6E3",
    "sideBar.background": "#F4F0D9",
    "sideBar.foreground": "#5C6A72",
    "sideBarSectionHeader.background": "#EFEBD4",
    "sideBarSectionHeader.foreground": "#5C6A72",
    "list.activeSelectionBackground": "#EAEDC8",
    "list.activeSelectionForeground": "#5C6A72",
    "list.hoverBackground": "#EFEBD4",
    "list.inactiveSelectionBackground": "#E6E2CC",
    "list.highlightForeground": "#8DA101",
    "titleBar.activeBackground": "#F4F0D9",
    "titleBar.activeForeground": "#5C6A72",
    "titleBar.inactiveBackground": "#F4F0D9",
    "titleBar.inactiveForeground": "#939F91",
    "tab.activeBackground": "#FDF6E3",
    "tab.activeForeground": "#5C6A72",
    "tab.inactiveBackground": "#EFEBD4",
    "tab.inactiveForeground": "#939F91",
    "tab.border": "#E0DCC7",
    "tab.activeBorderTop": "#8DA101",
    "editorGroupHeader.tabsBackground": "#EFEBD4",
    "statusBar.background": "#F4F0D9",
    "statusBar.foreground": "#708089",
    "input.background": "#FDF6E3",
    "input.foreground": "#5C6A72",
    "input.border": "#BDC3AF",
    "input.placeholderForeground": "#A6B0A0",
    "dropdown.background": "#FDF6E3",
    "dropdown.foreground": "#5C6A72",
    "dropdown.border": "#BDC3AF",
    "button.background": "#8DA101",
    "button.foreground": "#FDF6E3",
    "button.hoverBackground": "#93B259",
    "scrollbarSlider.background": "#BDC3AF60",
    "scrollbarSlider.hoverBackground": "#A6B0A080",
    "scrollbarSlider.activeBackground": "#939F91B0",
    "panel.background": "#F4F0D9",
    "panel.border": "#E0DCC7",
    "panelTitle.activeBorder": "#8DA101",
    "terminal.background": "#FDF6E3",
    "terminal.foreground": "#5C6A72",
    "terminal.ansiBlack": "#5C6A72",
    "terminal.ansiRed": "#F85552",
    "terminal.ansiGreen": "#8DA101",
    "terminal.ansiYellow": "#DFA000",
    "terminal.ansiBlue": "#3A94C5",
    "terminal.ansiMagenta": "#DF69BA",
    "terminal.ansiCyan": "#35A77C",
    "terminal.ansiWhite": "#E6E2CC",
    "terminal.ansiBrightBlack": "#829181",
    "terminal.ansiBrightRed": "#F85552",
    "terminal.ansiBrightGreen": "#8DA101",
    "terminal.ansiBrightYellow": "#DFA000",
    "terminal.ansiBrightBlue": "#3A94C5",
    "terminal.ansiBrightMagenta": "#DF69BA",
    "terminal.ansiBrightCyan": "#35A77C",
    "terminal.ansiBrightWhite": "#FDF6E3",
    "gitDecoration.addedResourceForeground": "#8DA101",
    "gitDecoration.modifiedResourceForeground": "#3A94C5",
    "gitDecoration.deletedResourceForeground": "#F85552",
    "gitDecoration.untrackedResourceForeground": "#35A77C",
    "gitDecoration.ignoredResourceForeground": "#A6B0A0",
    "notificationCenterHeader.background": "#EFEBD4",
    "notifications.background": "#F4F0D9",
    "notifications.foreground": "#5C6A72"
  },
  "semanticTokenColors": {
    "parameter": "#5C6A72",
    "variable": "#5C6A72",
    "variable.readonly": "#DF69BA",
    "property": "#3A94C5",
    "function": "#8DA101",
    "method": "#8DA101",
    "class": "#DFA000",
    "interface": "#DFA000",
    "enum": "#DFA000",
    "type": "#DFA000",
    "namespace": "#DFA000",
    "decorator": "#DF69BA",
    "string": "#35A77C",
    "number": "#DF69BA",
    "keyword": "#F85552",
    "comment": { "foreground": "#939F91", "italic": true },
    "operator": "#F57D26"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#939F91", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.modifier"], "settings": { "foreground": "#F85552" } },
    { "scope": ["storage.type", "keyword.operator"], "settings": { "foreground": "#F57D26" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#8DA101" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#35A77C" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#DF69BA" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#DFA000" } },
    { "scope": ["variable"], "settings": { "foreground": "#5C6A72" } },
    { "scope": ["meta.object-literal.key", "variable.other.property"], "settings": { "foreground": "#3A94C5" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F85552" } }
  ]
}
