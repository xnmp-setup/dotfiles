  "semanticTokenColors": {
    "parameter": "#a9b1d6",
    "variable": "#a9b1d6",
    "variable.readonly": "#ff9e64",
    "property": "#449dab",
    "function": "#7aa2f7",
    "method": "#7aa2f7",
    "class": "#e0af68",
    "interface": "#e0af68",
    "enum": "#e0af68",
    "type": "#449dab",
    "namespace": "#7aa2f7",
    "decorator": "#f7768e",
    "string": "#9ece6a",
    "number": "#eb927b",
    "keyword": "#ad8ee6",
    "comment": { "foreground": "#565f89", "italic": true },
    "operator": "#0db9d7"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#ad8ee6" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9ece6a" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#eb927b" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#449dab" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#a9b1d6" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff7a93" } }
  ]
}
