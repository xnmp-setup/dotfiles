    "terminal.background": "#181c1f",
    "terminal.foreground": "#fdf9f8",
    "terminal.ansiBlack": "#181c1f",
    "terminal.ansiRed": "#9b584d",
    "terminal.ansiGreen": "#9f6769",
    "terminal.ansiYellow": "#bb6d6c",
    "terminal.ansiBlue": "#b97670",
    "terminal.ansiMagenta": "#9a8c8a",
    "terminal.ansiCyan": "#da7a6f",
    "terminal.ansiWhite": "#fdf9f8",
    "terminal.ansiBrightBlack": "#b18d85",
    "terminal.ansiBrightRed": "#ca887f",
    "terminal.ansiBrightGreen": "#c79d9f",
    "terminal.ansiBrightYellow": "#d7adad",
    "terminal.ansiBrightBlue": "#d7b2ae",
    "terminal.ansiBrightMagenta": "#c4bcbb",
    "terminal.ansiBrightCyan": "#ecbeb9",
    "terminal.ansiBrightWhite": "#ffffff",
    "gitDecoration.addedResourceForeground": "#9f6769",
    "gitDecoration.modifiedResourceForeground": "#b97670",
    "gitDecoration.deletedResourceForeground": "#9b584d",
    "gitDecoration.untrackedResourceForeground": "#c79d9f",
    "gitDecoration.ignoredResourceForeground": "#b18d85",
    "notificationCenterHeader.background": "#2b2728",
    "notifications.background": "#121517",
    "notifications.foreground": "#fdf9f8"
  },
  "semanticTokenColors": {
    "parameter": "#edbcb3",
    "variable": "#fdf9f8",
    "variable.readonly": "#d7adad",
    "property": "#da7a6f",
    "function": "#b97670",
    "method": "#b97670",
    "class": "#bb6d6c",
    "interface": "#bb6d6c",
    "enum": "#bb6d6c",
    "type": "#da7a6f",
    "namespace": "#b97670",
    "decorator": "#9b584d",
    "string": "#9f6769",
    "number": "#ca887f",
    "keyword": "#9a8c8a",
    "comment": {
      "foreground": "#b18d85",
      "italic": true
    },
    "operator": "#d7b2ae"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b18d85",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9a8c8a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#b97670"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#9f6769"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ca887f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#da7a6f"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#fdf9f8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ca887f"
      }
    }
  ]
}
