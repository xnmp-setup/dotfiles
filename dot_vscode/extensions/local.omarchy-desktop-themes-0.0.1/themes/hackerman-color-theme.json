    "selection.background": "#1f253a90",
    "descriptionForeground": "#6a6e95",
    "errorForeground": "#50f872",
    "icon.foreground": "#b5c5db",
    "editor.background": "#0b0c16",
    "editor.foreground": "#ddf7ff",
    "editor.lineHighlightBackground": "#15182880",
    "editor.selectionBackground": "#1f253a90",
    "editor.findMatchBackground": "#82fb9c55",
    "editor.findMatchHighlightBackground": "#82fb9c30",
    "editorCursor.foreground": "#82fb9c",
    "editorLineNumber.foreground": "#6a6e95",
    "editorLineNumber.activeForeground": "#ddf7ff",
    "editorIndentGuide.background1": "#1f253a60",
    "editorIndentGuide.activeBackground1": "#2d3450",
    "editorBracketMatch.background": "#1f253a80",
    "editorBracketMatch.border": "#82fb9c",
    "editorGutter.addedBackground": "#4fe88f",
    "editorGutter.modifiedBackground": "#829dd4",
    "editorGutter.deletedBackground": "#50f872",
    "activityBar.background": "#080910",
    "activityBar.foreground": "#ddf7ff",
    "activityBar.inactiveForeground": "#6a6e95",
    "activityBarBadge.background": "#82fb9c",
    "activityBarBadge.foreground": "#0b0c16",
    "sideBar.background": "#080910",
    "sideBar.foreground": "#b5c5db",
    "sideBarSectionHeader.background": "#151828",
    "sideBarSectionHeader.foreground": "#ddf7ff",
    "list.activeSelectionBackground": "#1f253a",
    "list.activeSelectionForeground": "#ddf7ff",
    "list.hoverBackground": "#151828",
    "list.inactiveSelectionBackground": "#1f253a99",
    "list.highlightForeground": "#82fb9c",
    "titleBar.activeBackground": "#080910",
    "titleBar.activeForeground": "#ddf7ff",
    "titleBar.inactiveBackground": "#080910",
    "titleBar.inactiveForeground": "#6a6e95",
    "tab.activeBackground": "#0b0c16",
    "tab.activeForeground": "#ddf7ff",
    "tab.inactiveBackground": "#080910",
    "tab.inactiveForeground": "#6a6e95",
    "tab.border": "#1f253a",
    "tab.activeBorderTop": "#82fb9c",
    "editorGroupHeader.tabsBackground": "#080910",
    "statusBar.background": "#151828",
    "statusBar.foreground": "#ddf7ff",
    "input.background": "#080910",
    "input.foreground": "#ddf7ff",
    "input.border": "#2d3450",
    "input.placeholderForeground": "#6a6e95",
    "dropdown.background": "#080910",
    "dropdown.foreground": "#ddf7ff",
    "dropdown.border": "#2d3450",
    "button.background": "#82fb9c",
    "button.foreground": "#0b0c16",
    "button.hoverBackground": "#9cf7c2",
    "scrollbarSlider.background": "#2d345060",
    "scrollbarSlider.hoverBackground": "#2d3450a0",
    "scrollbarSlider.activeBackground": "#2d3450c0",
    "panel.background": "#080910",
    "panel.border": "#2d3450",
    "panelTitle.activeBorder": "#82fb9c",
    "terminal.background": "#0b0c16",
    "terminal.foreground": "#ddf7ff",
    "terminal.ansiBlack": "#0b0c16",
    "terminal.ansiRed": "#50f872",
    "terminal.ansiGreen": "#4fe88f",
    "terminal.ansiYellow": "#50f7d4",
    "terminal.ansiBlue": "#829dd4",
    "terminal.ansiMagenta": "#86a7df",
    "terminal.ansiCyan": "#7cf8f7",
    "terminal.ansiWhite": "#ddf7ff",
    "terminal.ansiBrightBlack": "#2d3450",
    "terminal.ansiBrightRed": "#85ff9d",
    "terminal.ansiBrightGreen": "#9cf7c2",
    "terminal.ansiBrightYellow": "#a4ffec",
    "terminal.ansiBrightBlue": "#c4d2ed",
    "terminal.ansiBrightMagenta": "#cddbf4",
    "terminal.ansiBrightCyan": "#d1fffe",
    "terminal.ansiBrightWhite": "#ddf7ff",
    "gitDecoration.addedResourceForeground": "#4fe88f",
    "gitDecoration.modifiedResourceForeground": "#829dd4",
    "gitDecoration.deletedResourceForeground": "#50f872",
    "gitDecoration.untrackedResourceForeground": "#9cf7c2",
    "gitDecoration.ignoredResourceForeground": "#6a6e95",
    "notificationCenterHeader.background": "#151828",
    "notifications.background": "#080910",
    "notifications.foreground": "#ddf7ff"
  },
  "semanticTokenColors": {
    "parameter": "#b5c5db",
    "variable": "#ddf7ff",
    "variable.readonly": "#a4ffec",
    "property": "#7cf8f7",
    "function": "#829dd4",
    "method": "#829dd4",
    "class": "#50f7d4",
    "interface": "#50f7d4",
    "enum": "#50f7d4",
    "type": "#7cf8f7",
    "namespace": "#829dd4",
    "decorator": "#85ff9d",
    "string": "#4fe88f",
    "number": "#50f7a3",
    "keyword": "#86a7df",
    "comment": { "foreground": "#6a6e95", "italic": true },
    "operator": "#a4ffec"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a6e95", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#86a7df" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#829dd4" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#4fe88f" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#50f7a3" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#7cf8f7" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#ddf7ff" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#85ff9d" } }
  ]
}
