{
  "name": "Flexoki Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#100f0f",
    "focusBorder": "#205ea6",
    "selection.background": "#cecdc390",
    "descriptionForeground": "#878580",
    "errorForeground": "#d14d41",
    "icon.foreground": "#403e3c",
    "editor.background": "#fffcf0",
    "editor.foreground": "#100f0f",
    "editor.lineHighlightBackground": "#f2efe4",
    "editor.selectionBackground": "#cecdc390",
    "editor.findMatchBackground": "#d0a21555",
    "editor.findMatchHighlightBackground": "#d0a21530",
    "editorCursor.foreground": "#205ea6",
    "editorLineNumber.foreground": "#878580",
    "editorLineNumber.activeForeground": "#100f0f",
    "editorIndentGuide.background1": "#cecdc360",
    "editorIndentGuide.activeBackground1": "#b7b5ac",
    "editorBracketMatch.background": "#cecdc380",
    "editorBracketMatch.border": "#205ea6",
    "editorGutter.addedBackground": "#879a39",
    "editorGutter.modifiedBackground": "#205ea6",
    "editorGutter.deletedBackground": "#d14d41",
    "activityBar.background": "#f2efe4",
    "activityBar.foreground": "#100f0f",
    "activityBar.inactiveForeground": "#878580",
    "activityBarBadge.background": "#205ea6",
    "activityBarBadge.foreground": "#fffcf0",
    "sideBar.background": "#f2efe4",
    "sideBar.foreground": "#403e3c",
    "sideBarSectionHeader.background": "#e6e4d9",
    "sideBarSectionHeader.foreground": "#100f0f",
    "list.activeSelectionBackground": "#cecdc3",
    "list.activeSelectionForeground": "#100f0f",
    "list.hoverBackground": "#e6e4d9",
    "list.inactiveSelectionBackground": "#cecdc399",
    "list.highlightForeground": "#205ea6",
    "titleBar.activeBackground": "#f2efe4",
    "titleBar.activeForeground": "#100f0f",
    "titleBar.inactiveBackground": "#f2efe4",
    "titleBar.inactiveForeground": "#878580",
    "tab.activeBackground": "#fffcf0",
    "tab.activeForeground": "#100f0f",
    "tab.inactiveBackground": "#f2efe4",
    "tab.inactiveForeground": "#878580",
    "tab.border": "#cecdc3",
    "tab.activeBorderTop": "#205ea6",
    "editorGroupHeader.tabsBackground": "#f2efe4",
    "statusBar.background": "#e6e4d9",
    "statusBar.foreground": "#100f0f",
    "input.background": "#fffcf0",
    "input.foreground": "#100f0f",
    "input.border": "#b7b5ac",
    "input.placeholderForeground": "#878580",
    "dropdown.background": "#fffcf0",
    "dropdown.foreground": "#100f0f",
    "dropdown.border": "#b7b5ac",
    "button.background": "#205ea6",
    "button.foreground": "#fffcf0",
    "button.hoverBackground": "#4385be",
    "scrollbarSlider.background": "#b7b5ac60",
    "scrollbarSlider.hoverBackground": "#87858080",
    "scrollbarSlider.activeBackground": "#878580b0",
    "panel.background": "#f2efe4",
    "panel.border": "#b7b5ac",
    "panelTitle.activeBorder": "#205ea6",
    "terminal.background": "#fffcf0",
    "terminal.foreground": "#100f0f",
    "terminal.ansiBlack": "#fffcf0",
    "terminal.ansiRed": "#d14d41",
    "terminal.ansiGreen": "#879a39",
    "terminal.ansiYellow": "#d0a215",
    "terminal.ansiBlue": "#205ea6",
    "terminal.ansiMagenta": "#ce5d97",
    "terminal.ansiCyan": "#3aa99f",
    "terminal.ansiWhite": "#100f0f",
    "terminal.ansiBrightBlack": "#b7b5ac",
    "terminal.ansiBrightRed": "#d14d41",
    "terminal.ansiBrightGreen": "#879a39",
    "terminal.ansiBrightYellow": "#d0a215",
    "terminal.ansiBrightBlue": "#4385be",
    "terminal.ansiBrightMagenta": "#ce5d97",
    "terminal.ansiBrightCyan": "#3aa99f",
    "terminal.ansiBrightWhite": "#100f0f",
    "gitDecoration.addedResourceForeground": "#879a39",
    "gitDecoration.modifiedResourceForeground": "#205ea6",
    "gitDecoration.deletedResourceForeground": "#d14d41",
    "gitDecoration.untrackedResourceForeground": "#879a39",
    "gitDecoration.ignoredResourceForeground": "#878580",
    "notificationCenterHeader.background": "#e6e4d9",
    "notifications.background": "#f2efe4",
    "notifications.foreground": "#100f0f"
  },
  "semanticTokenColors": {
    "parameter": "#403e3c",
    "variable": "#100f0f",
    "variable.readonly": "#d0a215",
    "property": "#3aa99f",
    "function": "#205ea6",
    "method": "#205ea6",
    "class": "#d0a215",
    "interface": "#d0a215",
    "enum": "#d0a215",
    "type": "#3aa99f",
    "namespace": "#205ea6",
    "decorator": "#d14d41",
    "string": "#879a39",
    "number": "#d0772b",
    "keyword": "#ce5d97",
    "comment": { "foreground": "#878580", "italic": true },
    "operator": "#4385be"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#878580", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#ce5d97" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#205ea6" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#879a39" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d0772b" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#3aa99f" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#100f0f" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#d14d41" } }
  ]
}
