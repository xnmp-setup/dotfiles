    "editorGutter.addedBackground": "#f29b9a",
    "editorGutter.modifiedBackground": "#d9a56c",
    "editorGutter.deletedBackground": "#e85f6f",
    "activityBar.background": "#060204",
    "activityBar.foreground": "#f0eaed",
    "activityBar.inactiveForeground": "#c6afba",
    "activityBarBadge.background": "#d9a56c",
    "activityBarBadge.foreground": "#0d0509",
    "sideBar.background": "#060204",
    "sideBar.foreground": "#f8f6f7",
    "sideBarSectionHeader.background": "#230e18",
    "sideBarSectionHeader.foreground": "#f0eaed",
    "list.activeSelectionBackground": "#230e18",
    "list.activeSelectionForeground": "#f0eaed",
    "list.hoverBackground": "#230e18",
    "list.inactiveSelectionBackground": "#230e1899",
    "list.highlightForeground": "#d9a56c",
    "titleBar.activeBackground": "#060204",
    "titleBar.activeForeground": "#f0eaed",
    "titleBar.inactiveBackground": "#060204",
    "titleBar.inactiveForeground": "#c6afba",
    "tab.activeBackground": "#0d0509",
    "tab.activeForeground": "#f0eaed",
