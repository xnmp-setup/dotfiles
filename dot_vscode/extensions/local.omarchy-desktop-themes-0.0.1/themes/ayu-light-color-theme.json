{
  "name": "Ayu Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#474c52",
    "focusBorder": "#1b82cc",
    "selection.background": "#c4d7f290",
    "descriptionForeground": "#6f767e",
    "errorForeground": "#d9504f",
    "icon.foreground": "#565656",
    "editor.background": "#f8f9fa",
    "editor.foreground": "#474c52",
    "editor.lineHighlightBackground": "#eef0f2",
    "editor.selectionBackground": "#c4d7f290",
    "editor.findMatchBackground": "#cf8a1655",
    "editor.findMatchHighlightBackground": "#cf8a1630",
    "editorCursor.foreground": "#1b82cc",
    "editorLineNumber.foreground": "#6f767e",
    "editorLineNumber.activeForeground": "#474c52",
    "editorIndentGuide.background1": "#c4d7f260",
    "editorIndentGuide.activeBackground1": "#b3b8be",
    "editorBracketMatch.background": "#c4d7f280",
    "editorBracketMatch.border": "#1b82cc",
    "editorGutter.addedBackground": "#4f9f2a",
    "editorGutter.modifiedBackground": "#1b82cc",
    "editorGutter.deletedBackground": "#d9504f",
    "activityBar.background": "#eef0f2",
    "activityBar.foreground": "#474c52",
    "activityBar.inactiveForeground": "#6f767e",
    "activityBarBadge.background": "#1b82cc",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#eef0f2",
    "sideBar.foreground": "#565656",
    "sideBarSectionHeader.background": "#dde1e5",
    "sideBarSectionHeader.foreground": "#474c52",
    "list.activeSelectionBackground": "#c4d7f2",
    "list.activeSelectionForeground": "#474c52",
    "list.hoverBackground": "#dde1e5",
    "list.inactiveSelectionBackground": "#c4d7f299",
    "list.highlightForeground": "#247fbd",
    "titleBar.activeBackground": "#eef0f2",
    "titleBar.activeForeground": "#474c52",
    "titleBar.inactiveBackground": "#eef0f2",
    "titleBar.inactiveForeground": "#6f767e",
    "tab.activeBackground": "#f8f9fa",
    "tab.activeForeground": "#474c52",
    "tab.inactiveBackground": "#eef0f2",
    "tab.inactiveForeground": "#6f767e",
    "tab.border": "#c4d7f2",
    "tab.activeBorderTop": "#1b82cc",
    "editorGroupHeader.tabsBackground": "#eef0f2",
    "statusBar.background": "#dde1e5",
    "statusBar.foreground": "#474c52",
    "input.background": "#f8f9fa",
    "input.foreground": "#474c52",
    "input.border": "#b3b8be",
    "input.placeholderForeground": "#6f767e",
    "dropdown.background": "#f8f9fa",
    "dropdown.foreground": "#474c52",
    "dropdown.border": "#b3b8be",
    "button.background": "#1b82cc",
    "button.foreground": "#000000",
    "button.hoverBackground": "#2389d4",
    "scrollbarSlider.background": "#b3b8be60",
    "scrollbarSlider.hoverBackground": "#6f767e80",
    "scrollbarSlider.activeBackground": "#6f767eb0",
    "panel.background": "#eef0f2",
    "panel.border": "#b3b8be",
    "panelTitle.activeBorder": "#1b82cc",
    "terminal.background": "#f8f9fa",
    "terminal.foreground": "#474c52",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#d9504f",
    "terminal.ansiGreen": "#4f9f2a",
    "terminal.ansiYellow": "#cf8a16",
    "terminal.ansiBlue": "#1b82cc",
    "terminal.ansiMagenta": "#8759b8",
    "terminal.ansiCyan": "#2a9c78",
    "terminal.ansiWhite": "#b3b8be",
    "terminal.ansiBrightBlack": "#565656",
    "terminal.ansiBrightRed": "#e25a5a",
    "terminal.ansiBrightGreen": "#6a9300",
    "terminal.ansiBrightYellow": "#d99420",
    "terminal.ansiBrightBlue": "#2389d4",
    "terminal.ansiBrightMagenta": "#8e62bd",
    "terminal.ansiBrightCyan": "#31a381",
    "terminal.ansiBrightWhite": "#d1d1d1",
    "gitDecoration.addedResourceForeground": "#568f31",
    "gitDecoration.modifiedResourceForeground": "#247fbd",
    "gitDecoration.deletedResourceForeground": "#c84f50",
    "gitDecoration.untrackedResourceForeground": "#568f31",
    "gitDecoration.ignoredResourceForeground": "#6f767e",
    "notificationCenterHeader.background": "#dde1e5",
    "notifications.background": "#eef0f2",
    "notifications.foreground": "#474c52"
  },
  "semanticTokenColors": {
    "parameter": "#565656",
    "variable": "#474c52",
    "variable.readonly": "#b97817",
    "property": "#268b6d",
    "function": "#247fbd",
    "method": "#247fbd",
    "class": "#b97817",
    "interface": "#b97817",
    "enum": "#b97817",
    "type": "#268b6d",
    "namespace": "#247fbd",
    "decorator": "#c84f50",
    "string": "#568f31",
    "number": "#c84f50",
    "keyword": "#815aad",
    "comment": { "foreground": "#6f767e", "italic": true },
    "operator": "#247fbd"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6f767e", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#815aad" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#247fbd" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#568f31" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#c84f50" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#268b6d" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#474c52" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#c84f50" } }
  ]
}
