    "focusBorder": "#3199e1",
    "selection.background": "#d3e1f590",
    "descriptionForeground": "#8a9199",
    "errorForeground": "#ea6c6d",
    "icon.foreground": "#686868",
    "editor.background": "#f8f9fa",
    "editor.foreground": "#5c6166",
    "editor.lineHighlightBackground": "#f3f4f5",
    "editor.selectionBackground": "#d3e1f590",
    "editor.findMatchBackground": "#eca94455",
    "editor.findMatchHighlightBackground": "#eca94430",
    "editorCursor.foreground": "#3199e1",
    "editorLineNumber.foreground": "#8a9199",
    "editorLineNumber.activeForeground": "#5c6166",
    "editorIndentGuide.background1": "#d3e1f560",
    "editorIndentGuide.activeBackground1": "#c7c7c7",
    "editorBracketMatch.background": "#d3e1f580",
    "editorBracketMatch.border": "#3199e1",
    "editorGutter.addedBackground": "#6cbf43",
    "editorGutter.modifiedBackground": "#3199e1",
    "editorGutter.deletedBackground": "#ea6c6d",
    "activityBar.background": "#f3f4f5",
    "activityBar.foreground": "#5c6166",
    "activityBar.inactiveForeground": "#8a9199",
    "activityBarBadge.background": "#3199e1",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#f3f4f5",
    "sideBar.foreground": "#686868",
    "sideBarSectionHeader.background": "#e6e8eb",
    "sideBarSectionHeader.foreground": "#5c6166",
    "list.activeSelectionBackground": "#d3e1f5",
    "list.activeSelectionForeground": "#5c6166",
    "list.hoverBackground": "#e6e8eb",
    "list.inactiveSelectionBackground": "#d3e1f599",
    "list.highlightForeground": "#247fbd",
    "titleBar.activeBackground": "#f3f4f5",
    "titleBar.activeForeground": "#5c6166",
    "titleBar.inactiveBackground": "#f3f4f5",
    "titleBar.inactiveForeground": "#8a9199",
    "tab.activeBackground": "#f8f9fa",
    "tab.activeForeground": "#5c6166",
    "tab.inactiveBackground": "#f3f4f5",
    "tab.inactiveForeground": "#8a9199",
    "tab.border": "#d3e1f5",
    "tab.activeBorderTop": "#3199e1",
    "editorGroupHeader.tabsBackground": "#f3f4f5",
    "statusBar.background": "#e6e8eb",
    "statusBar.foreground": "#5c6166",
    "input.background": "#f8f9fa",
    "input.foreground": "#5c6166",
    "input.border": "#c7c7c7",
    "input.placeholderForeground": "#8a9199",
    "dropdown.background": "#f8f9fa",
    "dropdown.foreground": "#5c6166",
    "dropdown.border": "#c7c7c7",
    "button.background": "#3199e1",
    "button.foreground": "#000000",
    "button.hoverBackground": "#399ee6",
    "scrollbarSlider.background": "#c7c7c760",
    "scrollbarSlider.hoverBackground": "#8a919980",
    "scrollbarSlider.activeBackground": "#8a9199b0",
    "panel.background": "#f3f4f5",
    "panel.border": "#c7c7c7",
    "panelTitle.activeBorder": "#3199e1",
    "terminal.background": "#f8f9fa",
    "terminal.foreground": "#5c6166",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ea6c6d",
    "terminal.ansiGreen": "#6cbf43",
    "terminal.ansiYellow": "#eca944",
    "terminal.ansiBlue": "#3199e1",
    "terminal.ansiMagenta": "#9e75c7",
    "terminal.ansiCyan": "#46ba94",
    "terminal.ansiWhite": "#c7c7c7",
    "terminal.ansiBrightBlack": "#686868",
    "terminal.ansiBrightRed": "#f07171",
    "terminal.ansiBrightGreen": "#86b300",
    "terminal.ansiBrightYellow": "#f2ae49",
    "terminal.ansiBrightBlue": "#399ee6",
    "terminal.ansiBrightMagenta": "#a37acc",
    "terminal.ansiBrightCyan": "#4cbf99",
    "terminal.ansiBrightWhite": "#d1d1d1",
    "gitDecoration.addedResourceForeground": "#568f31",
    "gitDecoration.modifiedResourceForeground": "#247fbd",
    "gitDecoration.deletedResourceForeground": "#c84f50",
    "gitDecoration.untrackedResourceForeground": "#568f31",
    "gitDecoration.ignoredResourceForeground": "#8a9199",
    "notificationCenterHeader.background": "#e6e8eb",
    "notifications.background": "#f3f4f5",
    "notifications.foreground": "#5c6166"
  },
  "semanticTokenColors": {
    "parameter": "#686868",
    "variable": "#5c6166",
    "variable.readonly": "#b97817",
    "property": "#268b6d",
    "function": "#247fbd",
    "method": "#247fbd",
    "class": "#b97817",
    "interface": "#b97817",
    "enum": "#b97817",
    "type": "#268b6d",
    "namespace": "#247fbd",
    "decorator": "#c84f50",
    "string": "#568f31",
    "number": "#c84f50",
    "keyword": "#815aad",
    "comment": { "foreground": "#8a9199", "italic": true },
    "operator": "#247fbd"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a9199", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#815aad" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#247fbd" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#568f31" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#c84f50" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#268b6d" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#5c6166" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#c84f50" } }
  ]
}
