  "semanticTokenColors": {
    "parameter": "#c8c093",
    "variable": "#dcd7ba",
    "variable.readonly": "#e6c384",
    "property": "#6a9589",
    "function": "#7e9cd8",
    "method": "#7e9cd8",
    "class": "#c0a36e",
    "interface": "#c0a36e",
    "enum": "#c0a36e",
    "type": "#6a9589",
    "namespace": "#7e9cd8",
    "decorator": "#c34043",
    "string": "#76946a",
    "number": "#c17158",
    "keyword": "#957fb8",
    "comment": { "foreground": "#727169", "italic": true },
    "operator": "#7fb4ca"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#727169", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#957fb8" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#7e9cd8" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#76946a" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#c17158" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#6a9589" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#dcd7ba" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e82424" } }
  ]
}
