    "panel.background": "#040303",
    "panel.border": "#969596",
    "panelTitle.activeBorder": "#dda660",
    "terminal.background": "#070605",
    "terminal.foreground": "#ffffff",
    "terminal.ansiBlack": "#070605",
    "terminal.ansiRed": "#dda660",
    "terminal.ansiGreen": "#f7ce6e",
    "terminal.ansiYellow": "#b2a295",
    "terminal.ansiBlue": "#d0b59b",
    "terminal.ansiMagenta": "#ebd2a4",
    "terminal.ansiCyan": "#fce7b0",
    "terminal.ansiWhite": "#ffffff",
    "terminal.ansiBrightBlack": "#969596",
    "terminal.ansiBrightRed": "#efd5b4",
    "terminal.ansiBrightGreen": "#fcefcf",
    "terminal.ansiBrightYellow": "#ddd6d0",
    "terminal.ansiBrightBlue": "#f1e8e0",
    "terminal.ansiBrightMagenta": "#fdfbf8",
    "terminal.ansiBrightCyan": "#ffffff",
    "terminal.ansiBrightWhite": "#ffffff",
    "gitDecoration.addedResourceForeground": "#f7ce6e",
    "gitDecoration.modifiedResourceForeground": "#d0b59b",
    "gitDecoration.deletedResourceForeground": "#dda660",
    "gitDecoration.untrackedResourceForeground": "#fcefcf",
    "gitDecoration.ignoredResourceForeground": "#969596",
    "notificationCenterHeader.background": "#211a14",
    "notifications.background": "#040303",
    "notifications.foreground": "#ffffff"
  },
  "semanticTokenColors": {
    "parameter": "#d7d6d7",
    "variable": "#ffffff",
    "variable.readonly": "#ddd6d0",
    "property": "#fce7b0",
    "function": "#d0b59b",
    "method": "#d0b59b",
    "class": "#b2a295",
    "interface": "#b2a295",
    "enum": "#b2a295",
    "type": "#fce7b0",
    "namespace": "#d0b59b",
    "decorator": "#dda660",
    "string": "#f7ce6e",
    "number": "#efd5b4",
    "keyword": "#ebd2a4",
    "comment": {
      "foreground": "#969596",
      "italic": true
    },
    "operator": "#f1e8e0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#969596",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ebd2a4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d0b59b"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#f7ce6e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#efd5b4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#fce7b0"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#efd5b4"
      }
    }
  ]
}
