    "tab.inactiveBackground": "#040303",
    "tab.inactiveForeground": "#969596",
    "tab.border": "#302519",
    "tab.activeBorderTop": "#dda660",
    "editorGroupHeader.tabsBackground": "#040303",
    "statusBar.background": "#211a14",
