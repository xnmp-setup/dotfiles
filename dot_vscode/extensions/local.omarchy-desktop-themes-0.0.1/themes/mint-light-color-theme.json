{
  "name": "Mint Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#3B413C",
    "focusBorder": "#1C8564",
    "selection.background": "#C3DED090",
    "descriptionForeground": "#62766D",
    "errorForeground": "#C24E36",
    "icon.foreground": "#5F6E67",
    "editor.background": "#F6FFF8",
    "editor.foreground": "#3B413C",
    "editor.lineHighlightBackground": "#EAF7EF",
    "editor.selectionBackground": "#C3DED090",
    "editor.findMatchBackground": "#E8C45A80",
    "editor.findMatchHighlightBackground": "#E8C45A40",
    "editorCursor.foreground": "#1C8564",
    "editorLineNumber.foreground": "#62766D",
    "editorLineNumber.activeForeground": "#3B413C",
    "editorIndentGuide.background1": "#C3DED060",
    "editorIndentGuide.activeBackground1": "#8A9A92",
    "editorBracketMatch.background": "#C3DED080",
    "editorBracketMatch.border": "#1C8564",
    "editorGutter.addedBackground": "#3A8236",
    "editorGutter.modifiedBackground": "#B05A22",
    "editorGutter.deletedBackground": "#C24E36",
    "activityBar.background": "#EAF7EF",
    "activityBar.foreground": "#3B413C",
    "activityBar.inactiveForeground": "#62766D",
    "activityBarBadge.background": "#1C8564",
    "activityBarBadge.foreground": "#F6FFF8",
    "sideBar.background": "#EAF7EF",
    "sideBar.foreground": "#5F6E67",
    "sideBarSectionHeader.background": "#DDF0E5",
    "sideBarSectionHeader.foreground": "#3B413C",
    "list.activeSelectionBackground": "#C3DED0",
    "list.activeSelectionForeground": "#3B413C",
    "list.hoverBackground": "#DDF0E5",
    "list.inactiveSelectionBackground": "#C3DED099",
    "list.highlightForeground": "#1C8564",
    "titleBar.activeBackground": "#EAF7EF",
    "titleBar.activeForeground": "#3B413C",
    "titleBar.inactiveBackground": "#EAF7EF",
    "titleBar.inactiveForeground": "#62766D",
    "tab.activeBackground": "#F6FFF8",
    "tab.activeForeground": "#3B413C",
    "tab.inactiveBackground": "#EAF7EF",
    "tab.inactiveForeground": "#62766D",
    "tab.border": "#C3DED0",
    "tab.activeBorderTop": "#1C8564",
    "editorGroupHeader.tabsBackground": "#EAF7EF",
    "statusBar.background": "#DDF0E5",
    "statusBar.foreground": "#3B413C",
    "input.background": "#F6FFF8",
    "input.foreground": "#3B413C",
    "input.border": "#8A9A92",
    "input.placeholderForeground": "#62766D",
    "dropdown.background": "#F6FFF8",
    "dropdown.foreground": "#3B413C",
    "dropdown.border": "#8A9A92",
    "button.background": "#1C8564",
    "button.foreground": "#F6FFF8",
    "button.hoverBackground": "#2E9C79",
    "scrollbarSlider.background": "#8A9A9260",
    "scrollbarSlider.hoverBackground": "#5F6E6780",
    "scrollbarSlider.activeBackground": "#5F6E67b0",
    "panel.background": "#EAF7EF",
    "panel.border": "#8A9A92",
    "panelTitle.activeBorder": "#1C8564",
    "terminal.background": "#F6FFF8",
    "terminal.foreground": "#3B413C",
    "terminal.ansiBlack": "#3B413C",
    "terminal.ansiRed": "#C24E36",
    "terminal.ansiGreen": "#3A8236",
    "terminal.ansiYellow": "#8F6D05",
    "terminal.ansiBlue": "#2D75A0",
    "terminal.ansiMagenta": "#93599F",
    "terminal.ansiCyan": "#137985",
    "terminal.ansiWhite": "#C3DED0",
    "terminal.ansiBrightBlack": "#7D9088",
    "terminal.ansiBrightRed": "#D0644A",
    "terminal.ansiBrightGreen": "#4D9442",
    "terminal.ansiBrightYellow": "#A8820E",
    "terminal.ansiBrightBlue": "#3E8CA6",
    "terminal.ansiBrightMagenta": "#A56DB0",
    "terminal.ansiBrightCyan": "#1F8F9B",
    "terminal.ansiBrightWhite": "#DBEEE3",
    "gitDecoration.addedResourceForeground": "#3A8236",
    "gitDecoration.modifiedResourceForeground": "#B05A22",
    "gitDecoration.deletedResourceForeground": "#C24E36",
    "gitDecoration.untrackedResourceForeground": "#2D75A0",
    "gitDecoration.ignoredResourceForeground": "#62766D",
    "notificationCenterHeader.background": "#DDF0E5",
    "notifications.background": "#EAF7EF",
    "notifications.foreground": "#3B413C",
    "editorWarning.foreground": "#B05A22",
    "editorError.foreground": "#C24E36",
    "editorInfo.foreground": "#2D75A0",
    "editorWhitespace.foreground": "#C3DED0",
    "textLink.foreground": "#1C8564",
    "textLink.activeForeground": "#166B51",
    "statusBar.noFolderBackground": "#DDF0E5",
    "statusBar.debuggingBackground": "#B05A22",
    "statusBar.debuggingForeground": "#F6FFF8"
  },
  "semanticTokenColors": {
    "variable": "#3B413C",
    "parameter": "#5F6E67",
    "property": "#137985",
    "enumMember": "#B05A22",
    "variable.readonly": "#B05A22",
    "variable.defaultLibrary": "#B05A22",
    "function": "#2D75A0",
    "method": "#2D75A0",
    "macro": "#93599F",
    "class": "#8F6D05",
    "interface": "#8F6D05",
    "enum": "#8F6D05",
    "struct": "#8F6D05",
    "type": "#8F6D05",
    "typeParameter": "#8F6D05",
    "namespace": "#3B413C",
    "decorator": "#137985",
    "keyword": "#93599F",
    "string": "#3A8236",
    "number": "#B05A22",
    "regexp": "#137985",
    "operator": "#5F6E67",
    "label": "#1C8564",
    "comment": { "foreground": "#62766D", "italic": true }
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#62766D", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#93599F" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#5F6E67" } },
    { "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call"], "settings": { "foreground": "#2D75A0" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#3A8236" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#137985" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#B05A22" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace"], "settings": { "foreground": "#8F6D05" } },
    { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#3B413C" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#5F6E67" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#C24E36", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#137985" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#C24E36" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8F6D05" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.annotation"], "settings": { "foreground": "#137985" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#1C8564", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#B05A22", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#5F6E67", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#1C8564" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#3A8236" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#3A8236" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#C24E36" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#B05A22" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#C24E36" } }
  ]
}
