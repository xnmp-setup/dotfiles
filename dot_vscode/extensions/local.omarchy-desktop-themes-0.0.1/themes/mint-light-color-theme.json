    "editor.lineHighlightBackground": "#EAF7EF",
    "editor.selectionBackground": "#C3DED090",
    "editor.findMatchBackground": "#C07A3E55",
    "editor.findMatchHighlightBackground": "#C07A3E30",
    "editorCursor.foreground": "#2E9C79",
    "editorLineNumber.foreground": "#8A9A92",
    "editorLineNumber.activeForeground": "#3B413C",
    "editorIndentGuide.background1": "#C3DED060",
    "editorIndentGuide.activeBackground1": "#8A9A92",
    "editorBracketMatch.background": "#C3DED080",
    "editorBracketMatch.border": "#2E9C79",
    "editorGutter.addedBackground": "#3E9B78",
    "editorGutter.modifiedBackground": "#2E9C79",
    "editorGutter.deletedBackground": "#D0644A",
    "activityBar.background": "#EAF7EF",
    "activityBar.foreground": "#3B413C",
    "activityBar.inactiveForeground": "#8A9A92",
    "activityBarBadge.background": "#2E9C79",
    "activityBarBadge.foreground": "#F6FFF8",
    "sideBar.background": "#EAF7EF",
    "sideBar.foreground": "#5F6E67",
    "sideBarSectionHeader.background": "#DDF0E5",
    "sideBarSectionHeader.foreground": "#3B413C",
    "list.activeSelectionBackground": "#C3DED0",
    "list.activeSelectionForeground": "#3B413C",
    "list.hoverBackground": "#DDF0E5",
    "list.inactiveSelectionBackground": "#C3DED099",
    "list.highlightForeground": "#2E9C79",
    "titleBar.activeBackground": "#EAF7EF",
    "titleBar.activeForeground": "#3B413C",
    "titleBar.inactiveBackground": "#EAF7EF",
    "titleBar.inactiveForeground": "#8A9A92",
    "tab.activeBackground": "#F6FFF8",
    "tab.activeForeground": "#3B413C",
    "tab.inactiveBackground": "#EAF7EF",
    "tab.inactiveForeground": "#8A9A92",
    "tab.border": "#C3DED0",
    "tab.activeBorderTop": "#2E9C79",
    "editorGroupHeader.tabsBackground": "#EAF7EF",
    "statusBar.background": "#DDF0E5",
    "statusBar.foreground": "#3B413C",
    "input.background": "#F6FFF8",
    "input.foreground": "#3B413C",
    "input.border": "#8A9A92",
    "input.placeholderForeground": "#8A9A92",
    "dropdown.background": "#F6FFF8",
    "dropdown.foreground": "#3B413C",
    "dropdown.border": "#8A9A92",
    "button.background": "#2E9C79",
    "button.foreground": "#F6FFF8",
    "button.hoverBackground": "#5BBF9C",
    "scrollbarSlider.background": "#8A9A9260",
    "scrollbarSlider.hoverBackground": "#5F6E6780",
    "scrollbarSlider.activeBackground": "#5F6E67b0",
    "panel.background": "#EAF7EF",
    "panel.border": "#8A9A92",
    "panelTitle.activeBorder": "#2E9C79",
    "terminal.background": "#F6FFF8",
    "terminal.foreground": "#3B413C",
    "terminal.ansiBlack": "#3B413C",
    "terminal.ansiRed": "#D0644A",
    "terminal.ansiGreen": "#3E9B78",
    "terminal.ansiYellow": "#C07A3E",
    "terminal.ansiBlue": "#3E8CA6",
    "terminal.ansiMagenta": "#9B6FA8",
    "terminal.ansiCyan": "#2FA893",
    "terminal.ansiWhite": "#C3DED0",
    "terminal.ansiBrightBlack": "#6B7F78",
    "terminal.ansiBrightRed": "#E08A6A",
    "terminal.ansiBrightGreen": "#5BAE8F",
    "terminal.ansiBrightYellow": "#D18B65",
    "terminal.ansiBrightBlue": "#5B9CAE",
    "terminal.ansiBrightMagenta": "#B58ABA",
    "terminal.ansiBrightCyan": "#62C7B5",
    "terminal.ansiBrightWhite": "#F6FFF8",
    "gitDecoration.addedResourceForeground": "#3E9B78",
    "gitDecoration.modifiedResourceForeground": "#2E9C79",
    "gitDecoration.deletedResourceForeground": "#D0644A",
    "gitDecoration.untrackedResourceForeground": "#3E9B78",
    "gitDecoration.ignoredResourceForeground": "#8A9A92",
    "notificationCenterHeader.background": "#DDF0E5",
    "notifications.background": "#EAF7EF",
    "notifications.foreground": "#3B413C"
  },
  "semanticTokenColors": {
    "parameter": "#5F6E67",
    "variable": "#3B413C",
    "variable.readonly": "#C07A3E",
    "property": "#2FA893",
    "function": "#3E8CA6",
    "method": "#3E8CA6",
    "class": "#9B6FA8",
    "interface": "#9B6FA8",
    "enum": "#9B6FA8",
    "type": "#9B6FA8",
    "namespace": "#3E8CA6",
    "decorator": "#B58ABA",
    "string": "#2FA893",
    "number": "#C07A3E",
    "keyword": "#3E9B78",
    "comment": { "foreground": "#8A9A92", "italic": true },
    "operator": "#5F6E67"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8A9A92", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#3E9B78" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#3E8CA6" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#2FA893" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#C07A3E" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#9B6FA8" } },
    { "scope": ["variable"], "settings": { "foreground": "#3B413C" } },
    { "scope": ["meta.object-literal.key"], "settings": { "foreground": "#B58ABA" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#D0644A" } }
  ]
}
