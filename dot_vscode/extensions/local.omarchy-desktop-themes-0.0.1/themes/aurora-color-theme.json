  "semanticTokenColors": {
    "parameter": "#94a3b8",
    "variable": "#e2e8f0",
    "variable.readonly": "#fbbf24",
    "property": "#e2e8f0",
    "function": "#60a5fa",
    "method": "#60a5fa",
    "class": "#7eeee0",
    "interface": "#7eeee0",
    "enum": "#7eeee0",
    "type": "#7eeee0",
    "namespace": "#e2e8f0",
    "decorator": "#f87171",
    "string": "#4ade80",
    "number": "#fbbf24",
    "keyword": "#c084fc",
    "comment": { "foreground": "#6b7a90", "italic": true },
    "operator": "#94a3b8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b7a90", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#c084fc" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#60a5fa" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#4ade80" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#7eeee0" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#e2e8f0" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f87171" } }
  ]
}
