    "terminal.background": "#0d1117",
    "terminal.foreground": "#e2e8f0",
    "terminal.ansiBlack": "#1e252e",
    "terminal.ansiRed": "#f87171",
    "terminal.ansiGreen": "#4ade80",
    "terminal.ansiYellow": "#fbbf24",
    "terminal.ansiBlue": "#60a5fa",
    "terminal.ansiMagenta": "#c084fc",
    "terminal.ansiCyan": "#5de5d5",
    "terminal.ansiWhite": "#cbd5e1",
    "terminal.ansiBrightBlack": "#6b7a90",
    "terminal.ansiBrightRed": "#fca5a5",
    "terminal.ansiBrightGreen": "#86efac",
    "terminal.ansiBrightYellow": "#fcd34d",
    "terminal.ansiBrightBlue": "#93c5fd",
    "terminal.ansiBrightMagenta": "#d8b4fe",
    "terminal.ansiBrightCyan": "#7eeee0",
    "terminal.ansiBrightWhite": "#f1f5f9",
    "gitDecoration.addedResourceForeground": "#4ade80",
    "gitDecoration.modifiedResourceForeground": "#fbbf24",
    "gitDecoration.deletedResourceForeground": "#f87171",
    "gitDecoration.untrackedResourceForeground": "#86efac",
    "gitDecoration.ignoredResourceForeground": "#6b7a90",
    "notificationCenterHeader.background": "#1e252e",
    "notifications.background": "#161b22",
    "notifications.foreground": "#e2e8f0"
