    "parameter": "#65616e",
    "variable": "#484453",
    "variable.readonly": "#865e22",
    "property": "#327179",
    "function": "#4962a0",
    "method": "#4962a0",
    "class": "#865e22",
    "interface": "#865e22",
    "enum": "#865e22",
    "type": "#327179",
    "namespace": "#756681",
    "decorator": "#a64a66",
    "string": "#497045",
    "number": "#a64a66",
    "keyword": "#756681",
    "comment": {
      "foreground": "#706d79",
      "italic": true
    },
    "operator": "#756681"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#706d79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#756681"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4962a0"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#497045"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a64a66"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#327179"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#484453"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a64a66"
      }
    }
  ]
}
