    "terminal.background": "#060b1e",
    "terminal.foreground": "#ffcead",
    "terminal.ansiBlack": "#060b1e",
    "terminal.ansiRed": "#ed5b5a",
    "terminal.ansiGreen": "#92a593",
    "terminal.ansiYellow": "#e9bb4f",
    "terminal.ansiBlue": "#7d82d9",
    "terminal.ansiMagenta": "#c89dc1",
    "terminal.ansiCyan": "#a3bfd1",
    "terminal.ansiWhite": "#ffcead",
    "terminal.ansiBrightBlack": "#6d7db6",
    "terminal.ansiBrightRed": "#faaaa9",
    "terminal.ansiBrightGreen": "#c4cfc4",
    "terminal.ansiBrightYellow": "#f7dc9c",
    "terminal.ansiBrightBlue": "#c2c4f0",
    "terminal.ansiBrightMagenta": "#ead7e7",
    "terminal.ansiBrightCyan": "#dfeaf0",
    "terminal.ansiBrightWhite": "#ffcead",
