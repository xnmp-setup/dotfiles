  "semanticTokenColors": {
    "parameter": "#c9b8a6",
    "variable": "#ffcead",
    "variable.readonly": "#f7dc9c",
    "property": "#a3bfd1",
    "function": "#7d82d9",
    "method": "#7d82d9",
    "class": "#e9bb4f",
    "interface": "#e9bb4f",
    "enum": "#e9bb4f",
    "type": "#a3bfd1",
    "namespace": "#7d82d9",
    "decorator": "#ed5b5a",
    "string": "#92a593",
    "number": "#eb8b54",
    "keyword": "#c89dc1",
    "comment": { "foreground": "#6d7db6", "italic": true },
    "operator": "#dfeaf0"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6d7db6", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#c89dc1" } },
    { "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#7d82d9" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#92a593" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#eb8b54" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#a3bfd1" } },
    { "scope": ["variable", "meta.object-literal.key"], "settings": { "foreground": "#ffcead" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#faaaa9" } }
  ]
}
