    "gitDecoration.modifiedResourceForeground": "#7d82d9",
    "gitDecoration.deletedResourceForeground": "#ed5b5a",
    "gitDecoration.untrackedResourceForeground": "#c4cfc4",
    "gitDecoration.ignoredResourceForeground": "#6d7db6",
    "notificationCenterHeader.background": "#131a3a",
    "notifications.background": "#040816",
    "notifications.foreground": "#ffcead"
