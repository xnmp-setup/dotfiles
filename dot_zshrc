# Text if it has a non-binary encoding (us-ascii/utf-8/...), or it's empty.
_is_text_file() {
  [[ -f "$1" ]] || return 1
  local enc type
  enc=$(file -b --mime-encoding -- "$1" 2>/dev/null)
  [[ -n "$enc" && "$enc" != "binary" ]] && return 0
  type=$(file -b --mime-type -- "$1" 2>/dev/null)
  [[ "$type" == "inode/x-empty" ]]
}

# Pick the command to open a file with, by extension then content.
# Echoes nothing for "no opinion" (caller falls back to the bare filename).
_fzf_open_cmd() {
  local f="$1"
  case "${f:l:e}" in
    csv|tsv|tab)                                  print -r -- tv ;;  # tidy-viewer
    zip|tar|tgz|tbz|tbz2|txz|tzst|gz|bz2|xz|zst|7z|rar|cpio|iso)
                                                  print -r -- 'bsdtar -tf' ;;  # list archive
    png|jpg|jpeg|gif|webp|bmp|svg|ico|tiff|avif)  print -r -- o  ;;  # GUI image viewer
    pdf|epub|mp4|mkv|webm|mov|mp3|flac|wav|ogg|opus|m4a|odt|docx|xlsx|pptx)
                                                  print -r -- o  ;;  # GUI app
    *) _is_text_file "$f" && print -r -- m ;;                        # micro
  esac
}

# Ctrl+P listing: --no-ignore drops every ignore source (per-repo .gitignore,
# .ignore, .fdignore, fd's own global ignore), then --ignore-file adds back a
# single base list. So the widget shows gitignored-but-interesting files
# (.env.example, build configs) while still hiding node_modules/__pycache__.
FD_BASE_IGNORE="$HOME/.config/fd/base-ignore"
_fd_base() {
  fd --hidden --follow --no-ignore --ignore-file "$FD_BASE_IGNORE" "$@"
}

fzf-file-widget() {
  local sel quoted

  sel=$({ _fd_base --type f; _fd_base --type d; zoxide query -l 2>/dev/null } | awk '!seen[$0]++' | fz --multi) || { zle reset-prompt; return }

  if [[ $(echo "$sel" | wc -l) -eq 1 ]] && [[ -d "$sel" ]]; then
    builtin cd -- "$sel"
    zle -M "cd → $PWD"
    zle reset-prompt
    zle accept-line
    return
  fi

  quoted=()
  for f in ${(f)sel}; do
    quoted+=("${(q)f}")
  done

  # Single file on an empty prompt → prefill the right opener (tv/o/m).
  local cmd
  if [[ ${#quoted} -eq 1 && -z "$LBUFFER" ]] && cmd=$(_fzf_open_cmd "${(f)sel}") && [[ -n "$cmd" ]]; then
    LBUFFER="$cmd ${quoted[1]} "
  else
    LBUFFER+="${(j: :)quoted} "
  fi
  zle reset-prompt
}
