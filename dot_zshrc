killon() {
  if [ "$#" -eq 0 ]; then
    echo "Please provide one or more port numbers (e.g., killon 1420 5173 8000)"
    return 1
  fi
  for port in "$@"; do
    pids=$(lsof -ti :"$port")
    if [ -z "$pids" ]; then
      echo "Nothing running on port $port"
    else
      echo "Stopping process(es) on port $port..."
      echo "$pids" | xargs kill
    fi
  done
}

cd-tree() {
  local current_root rel_path worktrees next_tree

  current_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not in a git repo"
    return 1
  }

  worktrees=($(git worktree list --porcelain | awk '/^worktree / {print $2}' | sort))

  if (( ${#worktrees[@]} <= 1 )); then
    echo "(no other worktrees)"
    return 0
  fi

  local idx=0
  for i in {1..${#worktrees[@]}}; do
    if [[ "${worktrees[$i]}" == "$current_root" ]]; then
      idx=$i
      break
    fi
  done

  local next_idx=$(( (idx % ${#worktrees[@]}) + 1 ))
  next_tree="${worktrees[$next_idx]}"

  rel_path="${PWD#$current_root}"
  rel_path="${rel_path#/}"

  local target="$next_tree"
  [[ -n "$rel_path" ]] && target="$next_tree/$rel_path"

  if [[ -d "$target" ]]; then
    builtin cd -- "$target"
    echo "→ $target"
  else
    builtin cd -- "$next_tree"
    echo "→ $next_tree (subdir '$rel_path' not found)"
  fi
}

# --- Yazi ---
function yz() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

chz() {
  if [[ "$1" == "link" && -n "$2" ]]; then
    local target_file=$(realpath "$2")
    local filename=$(basename "$target_file")
    local clean_name
    [[ "$filename" == .* ]] && clean_name="$filename" || clean_name=".$filename"
    local link_dir="$HOME/.config/ext-links"
    mkdir -p "$link_dir"
    local link_path="$link_dir/$clean_name"
    echo "🔗 Linking $target_file to $link_path..."
    ln -sf "$target_file" "$link_path"
    command chezmoi add --follow "$link_path"
    echo "✅ Content tracked! Use 'chz addp' to push."
  elif [[ "$1" == "addp" ]]; then
    shift
    if [[ $# -gt 0 ]]; then
      echo "📦 Tracking new files..."
      command chezmoi add --follow "$@"
      local msg="feat: update $filename ($*)"
    else
      echo "🚀 No files specified. Syncing existing changes..."
      local msg="chore: bulk sync dotfiles $(date +'%Y-%m-%d %H:%M')"
    fi
    command chezmoi git add .
    command chezmoi git commit -- -m "$msg"
    command chezmoi git push
    echo "✅ Changes committed and pushed!"
  elif [[ "$1" == "add" && -n "$2" ]]; then
    shift
    echo "NB: to add, commit and push, use \"cz addp\" with a p."
    chezmoi add "$@"
    chezmoi git add .
  elif [[ "$1" == "git" ]]; then
    shift
    command chezmoi git -- "$@"
  elif [[ "$1" == "cd" ]]; then
    builtin cd ~/.local/share/chezmoi
  elif [[ "$1" == "commit-main" ]]; then
    local CHEZMOI_BRANCH="$(chezmoi git -- branch --show-current)"
    chezmoi re-add || return 1
    chezmoi git -- checkout main || {
      echo "Checkout to main failed (likely uncommitted changes)."
      return 1
    }
    chezmoi git -- add -u || return 1
    chezmoi git -- commit -m "updated existing files" || true
    chezmoi git -- checkout $CHEZMOI_BRANCH || return 1
    chezmoi git -- rebase main || return 1
  else
    case "$1" in
      commit|push)
        command chezmoi git -- "$@"
        ;;
      *)
        command chezmoi "$@"
        ;;
    esac
  fi
}

ve() {
  local root main_root rel dir venv

  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not in a git repo"
    return 1
  }

  main_root=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2; exit}')
  [[ -z "$main_root" ]] && main_root="$root"

  rel="${PWD#$root}"
  rel="${rel#/}"

  dir="$main_root"
  [[ -n "$rel" ]] && dir="$main_root/$rel"

  while :; do
    venv="$dir/.venv"
    if [[ -f "$venv/bin/activate" ]]; then
      source "$venv/bin/activate"
      return 0
    fi
    [[ "$dir" == "$main_root" ]] && break
    dir="${dir:h}"
  done

  echo "No .venv found under $main_root (starting from $main_root/${rel})"
  return 1
}

