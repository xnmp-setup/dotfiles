fzr() {
  rg --column --line-number --no-heading --color=always --smart-case -- "${*:-}" |
    fzf --ansi \
        --delimiter : \
        --preview 'sh -c "$BAT --color=always {1} --highlight-line {2}"' \
        --preview-window 'up,60%,border-bottom,+{2}+3/3,~3'
}

fz() {
  if command -v batcat &>/dev/null; then
    fzf --preview '[[ -d {} ]] && eza --tree --color=always {} | head -200 || batcat --color=always --style=numbers --line-range=:500 {}'
  else
    fzf --preview '[[ -d {} ]] && eza --tree --color=always {} | head -200 || bat --color=always --style=numbers --line-range=:500 {}'
  fi
}

fzf-file-widget() {
  local sel quoted

  sel=$({ eval "$FZF_DEFAULT_COMMAND"; fd --type d --hidden --follow --exclude .git; zoxide query -l 2>/dev/null } | awk '!seen[$0]++' | fz --multi) || { zle reset-prompt; return }

  if [[ $(echo "$sel" | wc -l) -eq 1 ]] && [[ -d "$sel" ]]; then
    builtin cd -- "$sel"
    zle -M "cd → $PWD"
    zle reset-prompt
    zle accept-line
    return
  fi

  quoted=()
  for f in ${(f)sel}; do
    quoted+=("${(q)f}")
  done

  LBUFFER+="${(j: :)quoted} "
  zle reset-prompt
}
zle -N fzf-file-widget
bindkey '^P' fzf-file-widget

fzr-widget() {
  local line file lineno

  line=$(fzr) || { zle reset-prompt; return }

  file=${line%%:*}
  lineno=${line#*:}; lineno=${lineno%%:*}

  LBUFFER+="micro +${lineno} ${(q)file} "
  zle reset-prompt
}
zle -N fzr-widget
KEYTIMEOUT=10
bindkey '^[[102;6u' fzr-widget

function _fzf_copy_move() {
  local cmd="cp -v"

  if [[ "$LBUFFER" == *m ]]; then
    cmd="mv -v"
    LBUFFER="${LBUFFER%m}"
  fi

  zle -I

  local sources
  sources=$(
    eval "$FZF_DEFAULT_COMMAND" 2>/dev/null | \
      fzf --multi --height=40% --border --prompt="Select file(s) to ${cmd%% *}: " \
          --header="TAB to multi-select, ENTER to confirm" \
          --preview='[[ -d {} ]] && eza --tree --level=2 --color=always {} || bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || cat {}'
  )

  [[ -z "$sources" ]] && { zle reset-prompt; return; }

  local dest
  dest=$(
    {
      zoxide query -l 2>/dev/null | head -30
      fd -t d --max-depth 3 . 2>/dev/null
      fd -t d --max-depth 2 . ~ 2>/dev/null
    } | awk '!seen[$0]++' | fzf --height=40% --border --prompt="Destination: " \
        --header="Select destination folder" \
        --preview='eza --tree --level=2 --color=always {}'
  )

  [[ -z "$dest" ]] && { zle reset-prompt; return; }

  local file_array=("${(@f)sources}")
  echo
  for src in "${file_array[@]}"; do
    echo "${cmd} ${(q)src} → ${(q)dest}"
    eval "$cmd ${(q)src} ${(q)dest}"
  done

  zle reset-prompt
}
zle -N _fzf_copy_move
bindkey '^Y' _fzf_copy_move

zse() {
  local chez_file="${HOME}/.local/share/chezmoi/dot_zshrc"
  local target_file="${HOME}/.zshrc"

  local checksum_before
  checksum_before=$(md5sum "$chez_file" 2>/dev/null | cut -d' ' -f1)

  micro +9999999 "$chez_file"

  local checksum_after
  checksum_after=$(md5sum "$chez_file" 2>/dev/null | cut -d' ' -f1)

  if [[ "$checksum_before" == "$checksum_after" ]]; then
    echo "ℹ️  No changes made to dot_zshrc."
    return
  fi

  if zsh -n "$chez_file"; then
    if command -v chezmoi >/dev/null 2>&1; then
      chezmoi apply "$target_file" || {
        echo "❌ chezmoi apply failed."
        return 1
      }
    else
      echo "❌ chezmoi is not installed."
      return 1
    fi
    source "$target_file"
    echo "🚀 Updated, applied, and sourced .zshrc."
  else
    echo "❌ Syntax error detected in dot_zshrc! Not applying or sourcing."
    return 1
  fi
}

