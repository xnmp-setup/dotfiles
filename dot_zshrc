killon() {
  if [ "$#" -eq 0 ]; then
    echo "Please provide one or more port numbers (e.g., killon 1420 5173 8000)"
    return 1
  fi
  for port in "$@"; do
    pids=$(lsof -ti :"$port")
    if [ -z "$pids" ]; then
      echo "Nothing running on port $port"
    else
      echo "Stopping process(es) on port $port..."
      echo "$pids" | xargs kill
    fi
  done
}

cd-tree() {
  local current_root rel_path worktrees next_tree

  current_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not in a git repo"
    return 1
  }

  worktrees=($(git worktree list --porcelain | awk '/^worktree / {print $2}' | sort))

  if (( ${#worktrees[@]} <= 1 )); then
    echo "(no other worktrees)"
    return 0
  fi

  local idx=0
  for i in {1..${#worktrees[@]}}; do
    if [[ "${worktrees[$i]}" == "$current_root" ]]; then
      idx=$i
      break
    fi
  done

  local next_idx=$(( (idx % ${#worktrees[@]}) + 1 ))
  next_tree="${worktrees[$next_idx]}"

  rel_path="${PWD#$current_root}"
  rel_path="${rel_path#/}"

  local target="$next_tree"
  [[ -n "$rel_path" ]] && target="$next_tree/$rel_path"

  if [[ -d "$target" ]]; then
    builtin cd -- "$target"
    echo "→ $target"
  else
    builtin cd -- "$next_tree"
    echo "→ $next_tree (subdir '$rel_path' not found)"
  fi
}

