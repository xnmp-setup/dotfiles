# Intercepts !query before shell parsing — avoids history expansion and
# allows apostrophes. !! and !( fall through to normal zsh behaviour.
_haiku_accept_line() {
  if [[ "$BUFFER" == '!'* && "$BUFFER" != '!!'* && "$BUFFER" != '!('* ]]; then
    local query="${BUFFER#!}"
    query="${query##[[:space:]]}"
    BUFFER="_anthropic_smart ${(q)query}"
  fi
  zle .accept-line
}
zle -N accept-line _haiku_accept_line

# Sends a prompt to haiku and prints the response. Uses OAuth creds,
# ANTHROPIC_API_KEY, or falls back to the claude CLI.
_anthropic_haiku() {
  local prompt="$1"
  local _haiku_model="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-claude-haiku-4-5-20251001}"
  local _base_url="${ANTHROPIC_BASE_URL:-https://api.anthropic.com}"
  local _creds=~/.claude/.credentials.json
  local _auth_header _token _expires _now
  _now=$(( $(date +%s) * 1000 ))

  if [[ -f "$_creds" ]]; then
    _token=$(jq -r '.claudeAiOauth.accessToken // empty' "$_creds" 2>/dev/null)
    _expires=$(jq -r '.claudeAiOauth.expiresAt // 0' "$_creds" 2>/dev/null)
    (( _expires > _now )) && _auth_header="Authorization: Bearer $_token"
  fi

  [[ -z "$_auth_header" ]] && [[ -n "$ANTHROPIC_API_KEY" ]] && \
    _auth_header="x-api-key: $ANTHROPIC_API_KEY"

  if [[ -n "$_auth_header" ]]; then
    curl -s "$_base_url/v1/messages" \
      -H "$_auth_header" \
      -H "anthropic-version: 2023-06-01" \
      -H "content-type: application/json" \
      -d "{\"model\":\"$_haiku_model\",\"max_tokens\":256,\"messages\":[{\"role\":\"user\",\"content\":$(printf '%s' "$prompt" | jq -Rs .)}]}" \
      2>/dev/null \
      | jq -r '.content[0].text // empty'
  else
    command claude -p "$prompt" --model haiku 2>/dev/null
  fi
}

# Routes a !query: if it maps to a shell command, pre-fills the next
# prompt with it (just hit enter to run); otherwise prints the answer.
_anthropic_smart() {
  local query="$1"
  local prompt="You are a shell assistant on $(uname -s). If the user's request can be satisfied by a single shell command, reply with ONLY that command on one line, prefixed by 'CMD: ' and nothing else. Otherwise, answer directly in plain text. Do not use markdown or code fences.

Request: $query"

  local response
  response=$(_anthropic_haiku "$prompt")

  if [[ "$response" == CMD:* ]]; then
    local cmd="${response#CMD:}"
    cmd="${cmd##[[:space:]]}"      # trim leading whitespace
    cmd="${cmd%%[[:space:]]}"      # trim trailing whitespace
    cmd="${cmd#\`}"; cmd="${cmd%\`}"   # strip stray backticks
    print -z -- "$cmd"
  else
    print -r -- "$response"
  fi
}

alias q="_anthropic_smart"

cc() {
  # No args or flags passed directly → skip routing
  if [[ $# -eq 0 ]] || [[ "$1" == -* ]]; then
    command claude --permission-mode auto --model "$ANTHROPIC_MODEL" "$@"
    return
  fi

  local query="$*"
  local routing_prompt="Classify this query's complexity with exactly one phrase: simple, medium, complex, or very complex. simple = anything a small fast model can handle: greetings, factual lookups, unit conversions, short summaries, basic how-to questions. medium = tasks needing some reasoning or context but no deep expertise: writing drafts, debugging a small snippet, explaining a concept in depth. complex = multi-step reasoning, research, planning, architecture decisions, non-trivial code tasks. very complex = exhaustive analysis, large-scale design, deep technical work requiring sustained reasoning. Reply with only that phrase, nothing else.\n\nQuery: $query"

  local complexity
  complexity=$(
    _anthropic_haiku "$routing_prompt" \
      | grep -oi '\(very complex\|complex\|medium\|simple\)' | head -1 | tr '[:upper:]' '[:lower:]'
  )

  local model
  case "$complexity" in
    simple)         model="haiku"  ;;
    medium)         model="sonnet" ;;
    complex)        model="opus"   ;;
    "very complex") model="fable"  ;;
    *)              model="$ANTHROPIC_MODEL" ;;
  esac

  print -P "%F{cyan}→ $model%f"
  command claude --permission-mode auto --model "$model" "$query"
}
