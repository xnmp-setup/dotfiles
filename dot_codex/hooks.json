{
  "description": "Mirror Codex session state into the WezTerm tab bar (see ~/.local/bin/wezterm-agent-status). Same states and same script as the Claude Code hooks in ~/.claude/settings.json, so both agents' tabs read identically. UserPromptSubmit also records the focused window for ~/.local/bin/agent-notify (click-to-focus toasts).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" },
          { "type": "command", "command": "~/.local/bin/agent-notify record codex" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status done" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status done" }
        ]
      }
    ]
  }
}
