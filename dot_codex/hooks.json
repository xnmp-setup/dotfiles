{
  "description": "Mirror Codex session state into the terminal tab bar (see ~/.local/bin/wezterm-agent-status). UserPromptSubmit records the focused window for click-to-focus toasts. agent-notify sends a toast only when Codex requests user input.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" },
          { "type": "command", "command": "~/.local/bin/agent-notify record codex" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      },
      {
        "matcher": "^request_user_input(_async)?$",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/agent-notify codex" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status working" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status done" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/wezterm-agent-status done" }
        ]
      }
    ]
  }
}
