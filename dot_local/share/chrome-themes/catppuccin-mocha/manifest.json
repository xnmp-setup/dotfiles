{
  "manifest_version": 3,
  "name": "Catppuccin Mocha",
  "version": "1.0.0",
  "description": "Soothing pastel Catppuccin Mocha dark theme with mauve accents",
  "theme": {
    "colors": {
      "frame": [24, 24, 37],
      "frame_inactive": [19, 19, 29],
      "frame_incognito": [17, 17, 27],
      "frame_incognito_inactive": [13, 13, 21],
      "toolbar": [30, 30, 46, 0.95],
      "tab_text": [205, 214, 244],
      "tab_background_text": [166, 173, 200],
      "background_tab": [24, 24, 37, 0.95],
      "bookmark_text": [205, 214, 244],
      "ntp_background": [30, 30, 46],
      "ntp_text": [205, 214, 244],
      "ntp_link": [203, 166, 247],
      "ntp_header": [49, 50, 68],
