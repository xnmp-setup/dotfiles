{
  "manifest_version": 3,
  "name": "Desktop Theme Switcher",
  "version": "1.0.0",
  "description": "Follows the desktop theme: enables the matching Chrome theme extension when set-theme runs.",
  "key": "",
  "permissions": ["management", "nativeMessaging"],
  "background": {
    "service_worker": "sw.js"
  }
}
