# Intentionally extensionless: Vicinae 0.19 filters out text/x-shellscript
# before parsing directives on systems where that MIME type is executable.
# @vicinae.schemaVersion 1
# @vicinae.title Forget Workspace
# @vicinae.mode silent
# @vicinae.icon 🗑️
# @vicinae.keywords ["hyprland", "workspace", "snapshot", "forget", "remove"]
# @vicinae.description Remove a workspace from the recent restore list
# @vicinae.exec ["/usr/bin/env", "bash"]

set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send "$1" "$2" --urgency="${3:-normal}"
}

workspace_cli="$HOME/.local/bin/hypr-workspace"
workspaces=$("$workspace_cli" list --picker)
if [[ -z "$workspaces" ]]; then
  notify "No recent workspaces" "There is nothing to forget."
  exit 0
fi

selection=$(printf '%s\n' "$workspaces" | vicinae dmenu \
  --navigation-title "Forget Workspace" \
  --section-title "Recent workspaces ({count})" \
  --placeholder "Choose a workspace to forget" \
  --no-quick-look)
[[ -n "$selection" ]] || exit 0
name=${selection%%$'\t'*}
workspace_id=${selection##*$'\t'}

forget_choice="Forget \"$name\""
confirmation=$(printf '%s\n%s\n' "Cancel" "$forget_choice" | vicinae dmenu \
  --navigation-title "Confirm Forget" \
  --section-title "The saved workspace will be removed" \
  --placeholder "Choose Cancel or Forget" \
  --no-quick-look)
[[ "$confirmation" == "$forget_choice" ]] || exit 0

if message=$("$workspace_cli" forget "$workspace_id" 2>&1); then
  notify "Workspace forgotten" "$message"
else
  notify "Workspace was not forgotten" "$message" critical
  exit 1
fi
