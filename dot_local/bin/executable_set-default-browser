#!/bin/sh
# Point http/https at chrome-window.desktop, so links go through open-link.sh
# instead of straight to Chrome.
#
# That matters because Chrome hands a URL to whichever of its windows was active
# last and does nothing about focus: with google-chrome.desktop as the handler a
# link opens in a window you cannot see — buried in a tab strip, on another
# workspace, or in the F8 drop-down while it is parked. open-link.sh picks an
# ordinary window on the workspace in front of you, focuses it, and only then
# hands over the URL.
#
# A script rather than managing ~/.config/mimeapps.list itself: that file also
# carries image and editor associations that differ per machine, and any app
# calling xdg-mime rewrites it, so owning the whole file would mean fighting
# them over unrelated lines. This sets one association and leaves the rest.
#
# It lives here, on PATH, rather than only in chezmoi's run_after script,
# because MIME defaults are mutable external state that Chrome rewrites on its
# own — clicking "make Chrome the default" in its prompt is enough to undo this
# and silently send every link back to the invisible-window behaviour. A
# run_after script only repairs that on a full `chezmoi apply`, and applies here
# are scoped to the files that changed (see CLAUDE.md), so in practice it never
# fired. Being an ordinary executable means the assertion can also run at
# session startup, where it costs nothing and is idempotent.

set -eu

ENTRY=chrome-window.desktop

# Every condition the entry depends on, checked at runtime rather than templated
# on the machine, so a box that gains or loses one of them stays correct.
#
#   xdg-mime           absent on macOS, where associations are LaunchServices'
#   the entry itself   .desktop files are applied everywhere but mean nothing
#                      outside a freedesktop session
#   the browser        open-link.sh ends in google-chrome-stable, so without one
#                      this would point http at a handler that cannot serve it
#
# WSL is excluded even when all three hold: links there are expected to open in
# the Windows browser through wslview, and quietly taking that over from inside
# the Linux side is not this file's call to make.
command -v xdg-mime >/dev/null 2>&1 || exit 0
command -v google-chrome-stable >/dev/null 2>&1 || exit 0
[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$ENTRY" ] || exit 0
case "$(cat /proc/sys/kernel/osrelease 2>/dev/null)" in
    *[Mm]icrosoft*) exit 0 ;;
esac

# Reclaim the association from Chrome, but only from Chrome. Setting a default
# browser by any route — Chrome's own prompt, the desktop's settings panel,
# another browser asking — goes through `xdg-settings set default-web-browser`,
# which runs `xdg-mime default` over these same keys. So this script cannot tell
# *how* an association changed, only what it changed to, and that is the useful
# distinction:
#
#   chrome-window.desktop   already ours, nothing to do
#   a Chrome entry          Chrome taking back what it hands to an unfocused
#                           window; this is the drift worth undoing, and undoing
#                           it silently is right because the two entries launch
#                           the same browser — only the window routing differs
#   anything else           a deliberate choice of a different browser. Reverting
#                           that at every login would be this script overruling
#                           you about which browser you use, which is a different
#                           and much larger claim than fixing where a Chrome
#                           window opens
#   unset                   first run on a new machine, nothing to overrule
#
# Chrome's own entry is spelled differently across packagings (google-chrome,
# google-chrome-stable, com.google.Chrome), so match the family rather than one
# literal — a machine whose Chrome ships under a fourth name still self-repairs.
#
# Decided per key rather than once: the five can drift apart, and a run that
# bailed on the strength of one of them would leave the others pointing at the
# handler this exists to avoid.
for mime in text/html \
            x-scheme-handler/http \
            x-scheme-handler/https \
            x-scheme-handler/about \
            x-scheme-handler/unknown; do
    current=$(xdg-mime query default "$mime" 2>/dev/null) || current=
    case "$current" in
        "$ENTRY") continue ;;
        "" | *google-chrome*.desktop | com.google.Chrome.desktop) ;;
        *) continue ;;
    esac
    xdg-mime default "$ENTRY" "$mime"
done
