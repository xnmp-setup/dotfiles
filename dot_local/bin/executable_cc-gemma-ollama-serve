#!/bin/sh

set -eu

max_power_w=100
max_temp_c=68

fail() {
  printf 'cc-gemma-ollama: %s\n' "$1" >&2
  exit 1
}

profile_path="${XDG_CONFIG_HOME:-${HOME}/.config}/cc-gemma/profile.json"
profile_reader="${HOME}/.local/bin/cc-gemma-profile"
profile_values=$(
  "$profile_reader" "$profile_path"
) || fail "invalid profile: $profile_path"
IFS="$(printf '\t')" read -r model context_length min_available_ram_mib <<EOF
$profile_values
EOF

command -v nvidia-smi >/dev/null 2>&1 || fail 'nvidia-smi is not available'
command -v ollama >/dev/null 2>&1 || fail 'ollama is not installed'

power_limit=$(nvidia-smi --query-gpu=power.limit --format=csv,noheader,nounits | \
  awk 'NR == 1 { print int($1) }')
gpu_temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits | \
  awk 'NR == 1 { print int($1) }')

case "$power_limit:$gpu_temp" in
  *[!0-9:]*|:*) fail 'could not read the GPU safety state' ;;
esac
[ "$power_limit" -le "$max_power_w" ] || \
  fail "GPU power limit is ${power_limit} W; refusing to serve above ${max_power_w} W"
[ "$gpu_temp" -lt "$max_temp_c" ] || \
  fail "GPU is ${gpu_temp} C; refusing to serve at or above ${max_temp_c} C"

model_store=${CC_GEMMA_OLLAMA_MODELS:-}
if [ -z "$model_store" ]; then
  for candidate in /var/lib/ollama "${HOME}/.ollama/models" /usr/share/ollama/.ollama/models; do
    if [ -d "${candidate}/manifests" ] && [ -d "${candidate}/blobs" ]; then
      model_store=$candidate
      break
    fi
  done
fi
[ -n "$model_store" ] || fail 'could not locate an Ollama model store'
[ -r "${model_store}/manifests" ] || fail "model store is not readable: $model_store"

state_dir="${HOME}/.cc-gemma/ollama"
mkdir -p "$state_dir"

export HOME="$state_dir"
export OLLAMA_MODELS="$model_store"
export OLLAMA_HOST=127.0.0.1:11435
export OLLAMA_CONTEXT_LENGTH="$context_length"
export OLLAMA_NUM_PARALLEL=1
export OLLAMA_MAX_LOADED_MODELS=1
export OLLAMA_MAX_QUEUE=1
export OLLAMA_FLASH_ATTENTION=1
export OLLAMA_KV_CACHE_TYPE=q8_0
export OLLAMA_GPU_OVERHEAD=2147483648
export OLLAMA_KEEP_ALIVE=30s
export OLLAMA_NO_CLOUD=1
export OLLAMA_NOPRUNE=1
export OLLAMA_SCHED_SPREAD=false

exec ollama serve
