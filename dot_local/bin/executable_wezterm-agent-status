#!/bin/sh
# Publish coding-agent identity and state to the terminal-specific renderer.
# WezTerm receives pane user vars; Ghostty receives atomic files in a private
# per-invocation state directory consumed by the per-tab animator.
# Status (working | done | attention) is passed as $1.
#
# Shared by both agents. Claude exports CLAUDECODE/CLAUDE_PID to its hooks;
# invocations without either marker come from the Codex hook configuration.
#   Claude Code  ~/.claude/settings.json  "hooks"
#     working   <- UserPromptSubmit, PreToolUse, PostToolUse
#     attention <- PermissionRequest (immediate; fires only on a real dialog)
#     done      <- Stop, and Notification/idle_prompt (clears the interrupt-stuck
#                  case, since no hook fires on user interrupt)
#   Codex        ~/.codex/hooks.json  (needs features.hooks = true in config.toml)
#     working   <- UserPromptSubmit, PreToolUse, PermissionRequest, PostToolUse
#     attention <- PreToolUse/request_user_input (resolved from the hook payload)
#     done      <- Stop, SessionEnd
#   Codex routes permission requests to its configured auto-reviewer, so they
#   represent agent work rather than human input. Codex exposes no hook after an
#   auto-review decision, which means marking PermissionRequest as attention
#   would leave the tab red until the entire approved tool call finishes.
#   Codex has no Notification event, so it never passes "notification".
#
# A literal "notification" arg is resolved to attention/done/ignore below using
# the Notification payload's notification_type (Claude debounces that event ~2s,
# so PermissionRequest is the fast path for red).
#
# WezTerm mechanism: OSC 1337 SetUserVar, written to this pane's terminal
# device. Getting at that device is the whole trick, and it differs per agent:
#   - Codex spawns hooks with its controlling terminal intact, so /dev/tty is
#     the pane and opening it just works (one syscall, no subprocess).
#   - Claude Code spawns hooks WITHOUT a controlling terminal, so opening
#     /dev/tty fails with ENXIO ("Device not configured") even though
#     `[ -w /dev/tty ]` is true — that test only checks mode bits. So we must
#     actually try the open, and on failure resolve the pane's real device from
#     $WEZTERM_PANE via `wezterm cli list`.
# The sequence is a non-rendered control sequence, so it can't disturb either
# agent's TUI.
#
# Ghostty mechanism: a zsh wrapper owns the pane's terminal and exports a unique
# GHOSTTY_AGENT_STATE_DIR. Hooks publish status and session identity separately,
# which also works for Claude hooks that have no controlling terminal.

status="$1"
[ -z "$status" ] && exit 0

# Read the hook JSON payload (drains stdin so the pipe never blocks).
payload=$(cat 2>/dev/null)

# Claude's Notification event covers several sub-types. Only a permission prompt
# is "awaiting permission" (red); an idle prompt means the agent is stopped
# waiting on you (orange, same as Stop). Resolve the real status from
# notification_type. (Other sub-types: auth_success, elicitation_* — ignore.)
if [ "$status" = "notification" ]; then
  ntype=$(printf '%s' "$payload" | jq -r '.notification_type // empty' 2>/dev/null)
  case "$ntype" in
    permission_prompt) status=attention ;;
    idle_prompt)       status=done ;;
    *)                 exit 0 ;;
  esac
fi

# A request_user_input call blocks on a human choice. It arrives through the
# wildcard PreToolUse hook as "working", so promote that precise payload to
# attention. PermissionRequest stays working because Codex auto-reviews it.
if [ "$status" = "working" ] \
  && printf '%s' "$payload" \
    | jq -e '.hook_event_name == "PreToolUse"
             and .tool_name == "request_user_input"' >/dev/null 2>&1
then
  status=attention
fi

# Determine identity once for both terminal renderers.
if [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_PID:-}" ]; then
  agent_kind=claude
else
  agent_kind=codex
fi

# Ghostty's wrapper exported a private directory for this agent process tree.
# Each field has its own atomic file, so concurrent lifecycle hooks cannot
# overwrite unrelated metadata or expose a partially written record.
if [ "$TERM_PROGRAM" = "ghostty" ] \
  && [ -n "${GHOSTTY_AGENT_STATE_DIR:-}" ] \
  && [ -d "$GHOSTTY_AGENT_STATE_DIR" ]
then
  # Session metadata is useful only to Ghostty's renderer. Keep these JSON
  # queries out of WezTerm and unrelated terminals so their behavior and hook
  # cost stay exactly as before.
  session_id=$(printf '%s' "$payload" \
    | jq -r '.session_id // .thread_id // empty' 2>/dev/null)
  transcript_path=$(printf '%s' "$payload" \
    | jq -r '.transcript_path // empty' 2>/dev/null)
  if [ "$agent_kind" = "codex" ] && [ -n "${CODEX_THREAD_ID:-}" ]; then
    session_id=$CODEX_THREAD_ID
  fi

  write_state_field() {
    field_name=$1
    field_value=$2
    state_tmp="$GHOSTTY_AGENT_STATE_DIR/.$field_name.$$"
    umask 077
    if printf '%s\n' "$field_value" > "$state_tmp"; then
      mv -f "$state_tmp" "$GHOSTTY_AGENT_STATE_DIR/$field_name" 2>/dev/null \
        || rm -f "$state_tmp"
    else
      rm -f "$state_tmp"
    fi
  }

  case "$status" in
    working|done|attention)
      write_state_field status "$status"
      ;;
  esac
  write_state_field agent-kind "$agent_kind"
  [ -n "$session_id" ] && write_state_field session-id "$session_id"
  [ -n "$transcript_path" ] && write_state_field transcript-path "$transcript_path"
  exit 0
fi

# Compatibility for sessions launched before the directory protocol was
# installed. These sessions retain status animation until they exit.
if [ "$TERM_PROGRAM" = "ghostty" ] && [ -n "${GHOSTTY_AGENT_STATE:-}" ]; then
  case "$status" in
    working|done|attention)
      state_tmp="${GHOSTTY_AGENT_STATE}.$$"
      umask 077
      if printf '%s\n' "$status" > "$state_tmp"; then
        mv -f "$state_tmp" "$GHOSTTY_AGENT_STATE" 2>/dev/null \
          || rm -f "$state_tmp"
      else
        rm -f "$state_tmp"
      fi
      ;;
  esac
  exit 0
fi

# Other terminals have no renderer configured by this script.
[ "$TERM_PROGRAM" = "WezTerm" ] || exit 0
[ -n "$WEZTERM_PANE" ] || exit 0

# OSC 1337 SetUserVar requires values to be base64-encoded.
kind_b64=$(printf '%s' "$agent_kind" | base64 | tr -d '\n')
status_b64=$(printf '%s' "$status" | base64 | tr -d '\n')
osc=$(printf '\033]1337;SetUserVar=agent_kind=%s\007\033]1337;SetUserVar=agent_status=%s\007' \
  "$kind_b64" "$status_b64")

# Fast path: we have a controlling terminal (Codex). Costs no subprocess.
#
# The probe must be the write itself, on a REGULAR builtin. Two traps here:
#   - `[ -w /dev/tty ]` lies: it checks mode bits, which are fine even when the
#     process has no controlling terminal and the open fails with ENXIO.
#   - `exec 3>/dev/tty` would be the natural probe, but a redirection error on
#     `exec` (a SPECIAL builtin) makes a non-interactive shell EXIT — so under
#     Claude Code, which has no controlling terminal, the script would die right
#     here and never reach the fallback below. A failed redirect on printf just
#     fails printf.
# The 2>/dev/null goes on the GROUP, not on printf: the "no such device" message
# for a failed redirect comes from the shell, not from printf, so a redirect
# inside the command wouldn't silence it.
if { printf '%s' "$osc" > /dev/tty; } 2>/dev/null; then
  exit 0
fi

# Slow path: no controlling terminal (Claude Code). Map this pane id to its tty
# via the wezterm CLI, which lives next to the gui binary that launched us.
wt="${WEZTERM_EXECUTABLE%-gui}"
[ -x "$wt" ] || wt="$(command -v wezterm 2>/dev/null)"
[ -n "$wt" ] && [ -x "$wt" ] || exit 0
# A wedged GUI also wedges its embedded mux. Never let a synchronous agent hook
# wait indefinitely behind it; dropping a cosmetic status update is preferable.
command -v timeout >/dev/null 2>&1 || exit 0

tty_dev=$(timeout 2 "$wt" cli list --format json 2>/dev/null \
  | jq -r --argjson p "$WEZTERM_PANE" \
      '.[] | select(.pane_id == $p) | .tty_name // empty' 2>/dev/null)
[ -n "$tty_dev" ] && [ -w "$tty_dev" ] || exit 0

printf '%s' "$osc" > "$tty_dev" 2>/dev/null

exit 0
